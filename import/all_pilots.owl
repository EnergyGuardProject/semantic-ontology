    <rdfs:label>offset</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
  </owl:DatatypeProperty>
  <engreen:Contract rdf:about="https://www.energyguard.eu/ontology/engreen#Contract_User">
    <rdfs:label>User 1 Contract</rdfs:label>
    <engreen:endDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">end</engreen:endDate>
    <engreen:newPlant rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</engreen:newPlant>
    <engreen:startDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2025-01-01</engreen:startDate>
  </engreen:Contract>
  <sosa:ObservationCollection rdf:about="https://www.energyguard.eu/ontology/ber#CompositionMeasurementGroup">
    <rdf:type rdf:resource="https://www.energyguard.eu/ontology#CompositionMeasurement"/>
    <eg:hasMeasurement>
      <owl:NamedIndividual rdf:about="https://www.energyguard.eu/ontology/ber#CT-X101">
        <dcterms:description xml:lang="en">Feed tank conductivity</dcterms:description>
        <rdf:type rdf:resource="https://www.energyguard.eu/ontology#CompositionMeasurement"/>
        <rdf:type rdf:resource="https://www.energyguard.eu/ontology#Variable"/>
        <rdfs:label xml:lang="en">CT-X101</rdfs:label>
        <eg:aggregation>instantaneous</eg:aggregation>
        <eg:dataLakeMatch>normalised</eg:dataLakeMatch>
        <eg:dataLakeSensorId>CT_X101</eg:dataLakeSensorId>
        <eg:dataType>float</eg:dataType>
        <eg:decimals>3</eg:decimals>
        <eg:hasUnit rdf:resource="http://qudt.org/vocab/unit/MicroS-PER-CentiM"/>
        <eg:maxValue>1</eg:maxValue>
        <eg:minValue>0.0</eg:minValue>
        <eg:recordThreshold>0.0005</eg:recordThreshold>
        <eg:sampling>Over threshold (0.1s) or 30s</eg:sampling>
        <eg:subsystem>feedwater</eg:subsystem>
        <eg:unit>uS/cm</eg:unit>
        <eg:variableKind>measured</eg:variableKind>
      </owl:NamedIndividual>
    </eg:hasMeasurement>
    <eg:hasMeasurement>
      <owl:NamedIndividual rdf:about="https://www.energyguard.eu/ontology/ber#H2T-B103">
        <dcterms:description xml:lang="en">Process box hydrogen content</dcterms:description>
        <rdf:type rdf:resource="https://www.energyguard.eu/ontology#HydrogenMeasurement"/>
        <rdf:type rdf:resource="https://www.energyguard.eu/ontology#Variable"/>
        <rdfs:label xml:lang="en">H2T-B103</rdfs:label>
        <eg:aggregation>instantaneous</eg:aggregation>
        <eg:dataLakeMatch>normalised</eg:dataLakeMatch>
        <eg:dataLakeSensorId>H2T_B103</eg:dataLakeSensorId>
        <eg:dataType>float</eg:dataType>
        <eg:decimals>0</eg:decimals>
        <eg:maxValue>100</eg:maxValue>
        <eg:minValue>0.0</eg:minValue>
        <eg:recordThreshold>0.5</eg:recordThreshold>
        <eg:sampling>Over threshold (0.1s) or 30s</eg:sampling>
        <eg:subsystem>h2</eg:subsystem>
        <eg:unit>LEL</eg:unit>
        <eg:variableKind>measured</eg:variableKind>
      </owl:NamedIndividual>
    </eg:hasMeasurement>
  </sosa:ObservationCollection>
  <owl:NamedIndividual rdf:about="https://www.energyguard.eu/ontology/cartif#ElectrolyzerGroup">
    <rdf:type rdf:resource="https://www.energyguard.eu/ontology/cartif#Electrolyzer"/>
    <eg:hasMeasurement>
      <owl:NamedIndividual rdf:about="https://www.energyguard.eu/ontology/cartif#ELECTROLIZADOR_Alarm">
        <dcterms:description xml:lang="en">Alarm signal for the electrolyzer status</dcterms:description>
        <dcterms:description xml:lang="es">Señal de alarma en el estado del electrolizador</dcterms:description>
        <rdf:type rdf:resource="https://www.energyguard.eu/ontology#StateMeasurement"/>
        <rdf:type rdf:resource="https://www.energyguard.eu/ontology#Variable"/>
        <rdf:type rdf:resource="https://www.energyguard.eu/ontology/cartif#Alarm"/>
        <rdfs:label xml:lang="en">ELECTROLIZADOR_Alarm</rdfs:label>
        <eg:aggregation>none</eg:aggregation>
        <eg:codeList>0 / 1</eg:codeList>
        <eg:dataLakeMatch>exact</eg:dataLakeMatch>
        <eg:dataLakeSensorId>ELECTROLIZADOR_Alarm</eg:dataLakeSensorId>
        <eg:dataType>float</eg:dataType>
        <eg:representsComponent rdf:resource="https://www.energyguard.eu/ontology/cartif#Electrolyzer"/>
        <eg:sensorId>ELECTROLIZADOR_Alarm</eg:sensorId>
        <eg:sensorType>Status</eg:sensorType>
        <eg:subsystem>Electrolyser</eg:subsystem>
        <eg:validRange>0–1</eg:validRange>
        <eg:variableKind>alarm</eg:variableKind>
      </owl:NamedIndividual>
    </eg:hasMeasurement>
    <eg:hasMeasurement>
      <owl:NamedIndividual rdf:about="https://www.energyguard.eu/ontology/cartif#ELECTROLIZADOR_War">
        <dcterms:description xml:lang="es">Señal de advertencia en el estado del electrolizador</dcterms:description>
        <dcterms:description xml:lang="en">Warning signal for the electrolyzer status</dcterms:description>
        <rdf:type rdf:resource="https://www.energyguard.eu/ontology#StateMeasurement"/>
        <rdf:type rdf:resource="https://www.energyguard.eu/ontology#Variable"/>
        <rdf:type rdf:resource="https://www.energyguard.eu/ontology/cartif#Warning"/>
        <rdfs:label xml:lang="en">ELECTROLIZADOR_War</rdfs:label>
        <eg:aggregation>none</eg:aggregation>
        <eg:codeList>0 / 1</eg:codeList>
        <eg:dataLakeMatch>exact</eg:dataLakeMatch>
        <eg:dataLakeSensorId>ELECTROLIZADOR_War</eg:dataLakeSensorId>
        <eg:dataType>integer</eg:dataType>
        <eg:representsComponent rdf:resource="https://www.energyguard.eu/ontology/cartif#Electrolyzer"/>
        <eg:sensorId>ELECTROLIZADOR_War</eg:sensorId>
        <eg:sensorType>Status</eg:sensorType>
        <eg:subsystem>Electrolyser</eg:subsystem>
        <eg:validRange>0–1</eg:validRange>
        <eg:variableKind>state</eg:variableKind>
      </owl:NamedIndividual>
    </eg:hasMeasurement>
    <eg:hasMeasurement>
      <owl:NamedIndividual rdf:about="https://www.energyguard.eu/ontology/cartif#ELE_Current">
        <dcterms:description xml:lang="en">Electrolyzer current measurement</dcterms:description>
        <dcterms:description xml:lang="es">Medida de corriente del electrolizador</dcterms:description>
        <rdf:type rdf:resource="https://www.energyguard.eu/ontology#Variable"/>
        <rdf:type rdf:resource="https://www.energyguard.eu/ontology/cartif#ElectricalMeasurement"/>
        <rdfs:label xml:lang="en">ELE_Current</rdfs:label>
        <eg:aggregation>none</eg:aggregation>
        <eg:dataLakeMatch>exact</eg:dataLakeMatch>
        <eg:dataLakeSensorId>ELE_Current</eg:dataLakeSensorId>
        <eg:dataType>float</eg:dataType>
        <eg:hasUnit rdf:resource="http://qudt.org/vocab/unit/A"/>
        <eg:representsComponent rdf:resource="https://www.energyguard.eu/ontology/cartif#Electrolyzer"/>
        <eg:sensorId>ELE_Current</eg:sensorId>
        <eg:sensorType>Electrolyser monitoring signal</eg:sensorType>
        <eg:subsystem>Electrolyser</eg:subsystem>
        <eg:unit>A</eg:unit>
        <eg:variableKind>measured</eg:variableKind>
      </owl:NamedIndividual>
    </eg:hasMeasurement>
    <eg:hasMeasurement>
      <owl:NamedIndividual rdf:about="https://www.energyguard.eu/ontology/cartif#ELE_H2_Flow_Rate">
        <dcterms:description xml:lang="en">Flow rate measurement of H2 produced by the electrolyzer</dcterms:description>
        <dcterms:description xml:lang="es">Medida de flujo de H2 producido en el electrolizador</dcterms:description>
        <rdf:type rdf:resource="https://www.energyguard.eu/ontology#HydrogenMeasurement"/>
        <rdf:type rdf:resource="https://www.energyguard.eu/ontology#Variable"/>
        <rdfs:label xml:lang="en">ELE_H2_Flow_Rate</rdfs:label>
        <eg:aggregation>none</eg:aggregation>
        <eg:dataLakeMatch>exact</eg:dataLakeMatch>
        <eg:dataLakeSensorId>ELE_H2_Flow_Rate</eg:dataLakeSensorId>
        <eg:dataType>float</eg:dataType>
        <eg:representsComponent rdf:resource="https://www.energyguard.eu/ontology/cartif#Electrolyzer"/>
        <eg:sensorId>ELE_H2_Flow_Rate</eg:sensorId>
        <eg:sensorType>Electrolyser monitoring signal</eg:sensorType>
        <eg:subsystem>Electrolyser</eg:subsystem>
        <eg:unit>NL/h</eg:unit>
        <eg:variableKind>measured</eg:variableKind>
      </owl:NamedIndividual>
    </eg:hasMeasurement>
    <eg:hasMeasurement>
      <owl:NamedIndividual rdf:about="https://www.energyguard.eu/ontology/cartif#ELE_Inner_H2_Pressure">
        <dcterms:description xml:lang="es">Medida de presión de entrada al electrolizador</dcterms:description>
        <dcterms:description xml:lang="en">Pressure measurement at the electrolyzer inlet</dcterms:description>
        <rdf:type rdf:resource="https://www.energyguard.eu/ontology#PressureMeasurement"/>
        <rdf:type rdf:resource="https://www.energyguard.eu/ontology#Variable"/>
        <rdfs:label xml:lang="en">ELE_Inner_H2_Pressure</rdfs:label>
        <eg:aggregation>none</eg:aggregation>
        <eg:dataLakeMatch>exact</eg:dataLakeMatch>
        <eg:dataLakeSensorId>ELE_Inner_H2_Pressure</eg:dataLakeSensorId>
        <eg:dataType>float</eg:dataType>
        <eg:hasUnit rdf:resource="http://qudt.org/vocab/unit/BAR"/>
        <eg:representsComponent rdf:resource="https://www.energyguard.eu/ontology/cartif#Electrolyzer"/>
        <eg:sensorId>ELE_Inner_H2_Pressure</eg:sensorId>
        <eg:sensorType>Electrolyser monitoring signal</eg:sensorType>
        <eg:subsystem>Electrolyser</eg:subsystem>
        <eg:unit>bar</eg:unit>
        <eg:variableKind>measured</eg:variableKind>
      </owl:NamedIndividual>
    </eg:hasMeasurement>
    <eg:hasMeasurement>
      <owl:NamedIndividual rdf:about="https://www.energyguard.eu/ontology/cartif#ELE_Outer_H2_Pressure">
        <dcterms:description xml:lang="es">Medida de presión de salida al electrolizador</dcterms:description>
        <dcterms:description xml:lang="en">Pressure measurement at the electrolyzer outlet</dcterms:description>
        <rdf:type rdf:resource="https://www.energyguard.eu/ontology#PressureMeasurement"/>
        <rdf:type rdf:resource="https://www.energyguard.eu/ontology#Variable"/>
        <rdfs:label xml:lang="en">ELE_Outer_H2_Pressure</rdfs:label>
        <eg:aggregation>none</eg:aggregation>
        <eg:dataLakeMatch>exact</eg:dataLakeMatch>
        <eg:dataLakeSensorId>ELE_Outer_H2_Pressure</eg:dataLakeSensorId>
        <eg:dataType>float</eg:dataType>
        <eg:hasUnit rdf:resource="http://qudt.org/vocab/unit/BAR"/>
        <eg:representsComponent rdf:resource="https://www.energyguard.eu/ontology/cartif#Electrolyzer"/>
        <eg:sensorId>ELE_Outer_H2_Pressure</eg:sensorId>
        <eg:sensorType>Electrolyser monitoring signal</eg:sensorType>
        <eg:subsystem>Electrolyser</eg:subsystem>
        <eg:unit>bar</eg:unit>
        <eg:variableKind>measured</eg:variableKind>
      </owl:NamedIndividual>
    </eg:hasMeasurement>
    <eg:hasMeasurement>
      <owl:NamedIndividual rdf:about="https://www.energyguard.eu/ontology/cartif#ELE_Stack_Voltage">
        <dcterms:description xml:lang="es">Medida de tensión en el electrolizador</dcterms:description>
        <dcterms:description xml:lang="en">Voltage measurement in the electrolyzer</dcterms:description>
        <rdf:type rdf:resource="https://www.energyguard.eu/ontology#Variable"/>
        <rdf:type rdf:resource="https://www.energyguard.eu/ontology/cartif#ElectricalMeasurement"/>
        <rdfs:label xml:lang="en">ELE_Stack_Voltage</rdfs:label>
        <eg:aggregation>none</eg:aggregation>
        <eg:dataLakeMatch>exact</eg:dataLakeMatch>
        <eg:dataLakeSensorId>ELE_Stack_Voltage</eg:dataLakeSensorId>
        <eg:dataType>float</eg:dataType>
        <eg:hasUnit rdf:resource="http://qudt.org/vocab/unit/V"/>
        <eg:representsComponent rdf:resource="https://www.energyguard.eu/ontology/cartif#Electrolyzer"/>
        <eg:sensorId>ELE_Stack_Voltage</eg:sensorId>
        <eg:sensorType>Electrolyser monitoring signal</eg:sensorType>
        <eg:subsystem>Electrolyser</eg:subsystem>
        <eg:unit>V</eg:unit>
        <eg:variableKind>measured</eg:variableKind>
      </owl:NamedIndividual>
    </eg:hasMeasurement>
    <eg:hasMeasurement>
      <owl:NamedIndividual rdf:about="https://www.energyguard.eu/ontology/cartif#ELE_State">
        <dcterms:description xml:lang="en">Electrolyzer status</dcterms:description>
        <dcterms:description xml:lang="es">Estado del electrolizador</dcterms:description>
        <rdf:type rdf:resource="https://www.energyguard.eu/ontology#StateMeasurement"/>
        <rdf:type rdf:resource="https://www.energyguard.eu/ontology#Variable"/>
        <rdfs:label xml:lang="en">ELE_State</rdfs:label>
        <eg:aggregation>none</eg:aggregation>
        <eg:codeList>0 = Halted; 1 = Maintenance mode; 2 = Idle; 3 = Steady; 4 = Stand-by (max pressure); 5 = Curve; 6 = Blowdown</eg:codeList>
        <eg:dataLakeMatch>exact</eg:dataLakeMatch>
        <eg:dataLakeSensorId>ELE_State</eg:dataLakeSensorId>
        <eg:dataType>float</eg:dataType>
        <eg:hasUnit rdf:resource="http://qudt.org/vocab/unit/KiloW"/>
        <eg:representsComponent rdf:resource="https://www.energyguard.eu/ontology/cartif#Electrolyzer"/>
        <eg:sensorId>ELE_State</eg:sensorId>
        <eg:sensorType>PLC/Modbus input register 13 (source signal; physical sensor type not specified)</eg:sensorType>
        <eg:subsystem>Electrolyser</eg:subsystem>
        <eg:validRange>0, 1, 2, 3, 4, 5, 6</eg:validRange>
        <eg:variableKind>state</eg:variableKind>
      </owl:NamedIndividual>
    </eg:hasMeasurement>
    <eg:hasMeasurement>
      <owl:NamedIndividual rdf:about="https://www.energyguard.eu/ontology/cartif#ELE_water">
        <dcterms:description xml:lang="en">Amount of water in the electrolyzer</dcterms:description>
        <dcterms:description xml:lang="es">Cantidad de agua en el electrolizador</dcterms:description>
        <rdf:type rdf:resource="https://www.energyguard.eu/ontology#HydrogenMeasurement"/>
        <rdf:type rdf:resource="https://www.energyguard.eu/ontology#Variable"/>
        <rdfs:label xml:lang="en">ELE_water</rdfs:label>
        <eg:aggregation>none</eg:aggregation>
        <eg:dataLakeMatch>exact</eg:dataLakeMatch>
        <eg:dataLakeSensorId>ELE_water</eg:dataLakeSensorId>
        <eg:dataType>float</eg:dataType>
        <eg:hasUnit rdf:resource="http://qudt.org/vocab/unit/L"/>
        <eg:representsComponent rdf:resource="https://www.energyguard.eu/ontology/cartif#Electrolyzer"/>
        <eg:sensorId>ELE_water</eg:sensorId>
        <eg:sensorType>Volume</eg:sensorType>
        <eg:subsystem>Electrolyser</eg:subsystem>
        <eg:unit>L</eg:unit>
        <eg:variableKind>measured</eg:variableKind>
      </owl:NamedIndividual>
    </eg:hasMeasurement>
    <eg:hasMeasurement>
      <owl:NamedIndividual rdf:about="https://www.energyguard.eu/ontology/cartif#EL_preheat">
        <dcterms:description xml:lang="es">Señal para precalentar el electrolizador durante periodos fríos y evitar alarmas en el arranque</dcterms:description>
        <dcterms:description xml:lang="en">Signal to preheat the electrolyzer during cold periods and prevent startup alarms</dcterms:description>
        <rdf:type rdf:resource="https://www.energyguard.eu/ontology#StateMeasurement"/>
        <rdf:type rdf:resource="https://www.energyguard.eu/ontology#Variable"/>
        <rdfs:label xml:lang="en">EL_preheat</rdfs:label>
        <eg:aggregation>none</eg:aggregation>
        <eg:codeList>0 = Off; 1 = On</eg:codeList>
        <eg:dataLakeMatch>exact</eg:dataLakeMatch>
        <eg:dataLakeSensorId>EL_preheat</eg:dataLakeSensorId>
        <eg:dataType>integer</eg:dataType>
        <eg:hasUnit rdf:resource="http://qudt.org/vocab/unit/KiloW"/>
        <eg:representsComponent rdf:resource="https://www.energyguard.eu/ontology/cartif#Electrolyzer"/>
        <eg:sensorId>EL_preheat</eg:sensorId>
        <eg:sensorType>Status</eg:sensorType>
        <eg:subsystem>Hydrogen test bench</eg:subsystem>
        <eg:validRange>0, 1</eg:validRange>
        <eg:variableKind>measured</eg:variableKind>
      </owl:NamedIndividual>
    </eg:hasMeasurement>
    <eg:hasMeasurement>
      <owl:NamedIndividual rdf:about="https://www.energyguard.eu/ontology/cartif#EL_temp">
        <dcterms:description xml:lang="en">Electrolyzer temperature</dcterms:description>
        <dcterms:description xml:lang="es">Temperatura en el electrolizador</dcterms:description>
        <rdf:type rdf:resource="https://www.energyguard.eu/ontology#TemperatureMeasurement"/>
        <rdf:type rdf:resource="https://www.energyguard.eu/ontology#Variable"/>
        <rdfs:label xml:lang="en">EL_temp</rdfs:label>
        <eg:aggregation>none</eg:aggregation>
        <eg:dataLakeMatch>exact</eg:dataLakeMatch>
        <eg:dataLakeSensorId>EL_temp</eg:dataLakeSensorId>
        <eg:dataType>float</eg:dataType>
        <eg:hasUnit rdf:resource="http://qudt.org/vocab/unit/DEG_C"/>
        <eg:representsComponent rdf:resource="https://www.energyguard.eu/ontology/cartif#Electrolyzer"/>
        <eg:sensorId>EL_temp</eg:sensorId>
        <eg:sensorType>Temperature sensor</eg:sensorType>
        <eg:subsystem>Hydrogen test bench</eg:subsystem>
        <eg:unit>ºC</eg:unit>
        <eg:variableKind>measured</eg:variableKind>
      </owl:NamedIndividual>
    </eg:hasMeasurement>
  </owl:NamedIndividual>
