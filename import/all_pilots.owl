    <rdf:type rdf:resource="https://www.energyguard.eu/ontology#StateMeasurement"/>
    <eg:hasMeasurement>
      <owl:NamedIndividual rdf:about="https://www.energyguard.eu/ontology/ber#SOC-M200">
        <dcterms:description xml:lang="en">Drier left column state of charge</dcterms:description>
        <rdf:type rdf:resource="https://www.energyguard.eu/ontology#ControlSignalMeasurement"/>
