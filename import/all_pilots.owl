  <owl:NamedIndividual rdf:about="https://www.energyguard.eu/ontology/cartif#ValveGroup">
    <rdf:type rdf:resource="https://www.energyguard.eu/ontology/cartif#Valve"/>
    <eg:hasMeasurement>
      <owl:NamedIndividual rdf:about="https://www.energyguard.eu/ontology/cartif#MV3C101_State">
        <dcterms:description xml:lang="es">Estado de la electroválvula MV3C101 (situada despues de la bomba)</dcterms:description>
        <dcterms:description xml:lang="en">Status of solenoid valve MV3C101 (located downstream of the pump)</dcterms:description>
        <rdf:type rdf:resource="https://www.energyguard.eu/ontology#StateMeasurement"/>
        <rdf:type rdf:resource="https://www.energyguard.eu/ontology#Variable"/>
        <rdfs:label xml:lang="en">MV3C101_State</rdfs:label>
        <eg:aggregation>none</eg:aggregation>
        <eg:codeList>0 / 1</eg:codeList>
        <eg:dataLakeMatch>exact</eg:dataLakeMatch>
        <eg:dataLakeSensorId>MV3C101_State</eg:dataLakeSensorId>
        <eg:dataType>float</eg:dataType>
        <eg:hasUnit rdf:resource="http://qudt.org/vocab/unit/KiloW"/>
        <eg:representsComponent rdf:resource="https://www.energyguard.eu/ontology/cartif#Valve"/>
        <eg:sensorId>MV3C101_State</eg:sensorId>
        <eg:sensorType>Status</eg:sensorType>
        <eg:subsystem>Hydrogen test bench</eg:subsystem>
        <eg:validRange>0–1</eg:validRange>
        <eg:variableKind>state</eg:variableKind>
      </owl:NamedIndividual>
    </eg:hasMeasurement>
    <eg:hasMeasurement>
      <owl:NamedIndividual rdf:about="https://www.energyguard.eu/ontology/cartif#MV3C103_State">
        <dcterms:description xml:lang="es">Estado de la electroválvula MV3C103 (situada entre la recirculación y el fancoil)</dcterms:description>
        <dcterms:description xml:lang="en">Status of solenoid valve MV3C103 (located between the recirculation loop and the fan coil)</dcterms:description>
        <rdf:type rdf:resource="https://www.energyguard.eu/ontology#StateMeasurement"/>
        <rdf:type rdf:resource="https://www.energyguard.eu/ontology#Variable"/>
        <rdfs:label xml:lang="en">MV3C103_State</rdfs:label>
        <eg:aggregation>none</eg:aggregation>
        <eg:codeList>0 / 1</eg:codeList>
        <eg:dataLakeMatch>exact</eg:dataLakeMatch>
        <eg:dataLakeSensorId>MV3C103_State</eg:dataLakeSensorId>
        <eg:dataType>integer</eg:dataType>
        <eg:hasUnit rdf:resource="http://qudt.org/vocab/unit/KiloW"/>
        <eg:representsComponent rdf:resource="https://www.energyguard.eu/ontology/cartif#Valve"/>
        <eg:sensorId>MV3C103_State</eg:sensorId>
        <eg:sensorType>Status</eg:sensorType>
        <eg:subsystem>Hydrogen test bench</eg:subsystem>
        <eg:validRange>0–1</eg:validRange>
        <eg:variableKind>state</eg:variableKind>
      </owl:NamedIndividual>
    </eg:hasMeasurement>
    <eg:hasMeasurement>
      <owl:NamedIndividual rdf:about="https://www.energyguard.eu/ontology/cartif#MV3C105_State">
        <dcterms:description xml:lang="es">Estado de la electroválvula MV3C105 (situada entre la recirculación y el calentador)</dcterms:description>
        <dcterms:description xml:lang="en">Status of solenoid valve MV3C105 (located between the recirculation loop and the heater)</dcterms:description>
