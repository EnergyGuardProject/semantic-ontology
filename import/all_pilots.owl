  <sosa:ObservationCollection rdf:about="https://www.energyguard.eu/ontology/ber#TimerMeasurementGroup">
    <rdf:type rdf:resource="https://www.energyguard.eu/ontology#TimerMeasurement"/>
    <eg:hasMeasurement>
      <owl:NamedIndividual rdf:about="https://www.energyguard.eu/ontology/ber#SEQ-M200">
        <dcterms:description xml:lang="en">Dryer left column state machine step</dcterms:description>
        <rdf:type rdf:resource="https://www.energyguard.eu/ontology#ControlSignalMeasurement"/>
        <rdf:type rdf:resource="https://www.energyguard.eu/ontology#Variable"/>
        <rdfs:label xml:lang="en">SEQ-M200</rdfs:label>
        <eg:aggregation>instantaneous</eg:aggregation>
        <eg:codeList>see Step Legend; 0 = Boot; 2 = Standby; 3 = Duty; 4 = Adsorb; 5 = Adsorb Full; 6 = Saturated; 7 = Pressurizing; 8 = Back Flush Check; 9 = Heating; 10 = Hot Flush; 11 = Cold Flush; 100 = I/O Error; 101 = Heating Fail; 102 = Back Flush Fail; 103 = Check Valve Leakage; 104 = Pressurizing Fail; 999 = Service Mode</eg:codeList>
        <eg:dataLakeMatch>normalised</eg:dataLakeMatch>
        <eg:dataLakeSensorId>SEQ_M200</eg:dataLakeSensorId>
        <eg:dataType>integer</eg:dataType>
        <eg:decimals>0</eg:decimals>
        <eg:maxValue>10000</eg:maxValue>
        <eg:minValue>0.0</eg:minValue>
        <eg:recordThreshold>change</eg:recordThreshold>
        <eg:sampling>Over threshold (0.1s) or 30s</eg:sampling>
        <eg:subsystem>dryer</eg:subsystem>
        <eg:unit>step</eg:unit>
        <eg:variableKind>state</eg:variableKind>
      </owl:NamedIndividual>
    </eg:hasMeasurement>
    <eg:hasMeasurement>
      <owl:NamedIndividual rdf:about="https://www.energyguard.eu/ontology/ber#SEQ-M300">
