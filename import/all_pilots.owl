        <eg:decimals>3</eg:decimals>
        <eg:hasUnit rdf:resource="http://qudt.org/vocab/unit/GM-PER-HR"/>
        <eg:maxValue>100</eg:maxValue>
        <eg:minValue>0.0</eg:minValue>
        <eg:recordThreshold>0.0005</eg:recordThreshold>
        <eg:sampling>Over threshold (0.1s) or 30s</eg:sampling>
        <eg:subsystem>dryer</eg:subsystem>
        <eg:unit>g/h</eg:unit>
        <eg:variableKind>calculated</eg:variableKind>
      </owl:NamedIndividual>
