  </owl:ObjectProperty>
  <owl:DatatypeProperty rdf:about="https://www.energyguard.eu/ontology/rdn/faults#Vb_scaledValue">
    <rdfs:comment>Phase B voltage value (scaled). Links to IEC61850 PhaseVoltageDA Data Attribute</rdfs:comment>
