  <owl:NamedIndividual rdf:about="https://www.energyguard.eu/ontology/rea#Dataset_Energy_efficiency_indicators_for_heating_of_multi_apartment_buildings_in_Riga">
    <dcterms:description xml:lang="en">Heating energy-efficiency indicators for 5,518 multi-apartment buildings: construction year, useful area, 3–5 year average and last-12-month specific heating consumption, energy efficiency class, comparison with equivalent buildings, renovation info, data quality flag, neighbourhood and building polygon.</dcterms:description>
    <dcterms:title xml:lang="en">Energy efficiency indicators for heating of multi-apartment buildings in Rīga</dcterms:title>
    <rdf:type rdf:resource="http://www.w3.org/ns/dcat#Dataset"/>
    <rdfs:label xml:lang="en">Energy efficiency indicators for heating of multi-apartment buildings in Rīga</rdfs:label>
    <eg:databaseServer>REDACTED_HOST:REDACTED_PORT</eg:databaseServer>
    <eg:databaseSystem>PostgreSQL</eg:databaseSystem>
    <eg:datasetType>Geospatial (vector)</eg:datasetType>
    <eg:hasVariable>
      <owl:NamedIndividual rdf:about="https://www.energyguard.eu/ontology/rea#Energy_efficiency_indicators_for_heating_of_multi_apartment_buildings_in_Riga__adrese">
        <dcterms:description xml:lang="en">Address of the building</dcterms:description>
        <rdf:type rdf:resource="https://www.energyguard.eu/ontology#Variable"/>
        <rdfs:label xml:lang="en">address</rdfs:label>
        <eg:dataLakeMatch>column</eg:dataLakeMatch>
        <eg:sourceColumnName>adrese</eg:sourceColumnName>
        <eg:storedInDatabaseColumn>adrese</eg:storedInDatabaseColumn>
      </owl:NamedIndividual>
    </eg:hasVariable>
    <eg:hasVariable>
      <owl:NamedIndividual rdf:about="https://www.energyguard.eu/ontology/rea#Energy_efficiency_indicators_for_heating_of_multi_apartment_buildings_in_Riga__apkaime">
        <dcterms:description xml:lang="en">Name of neighborhood or district, e.g. Centrs</dcterms:description>
        <rdf:type rdf:resource="https://www.energyguard.eu/ontology#Variable"/>
        <rdfs:label xml:lang="en">neighborhood</rdfs:label>
        <eg:dataLakeMatch>column</eg:dataLakeMatch>
        <eg:sourceColumnName>apkaime</eg:sourceColumnName>
        <eg:storedInDatabaseColumn>apkaime</eg:storedInDatabaseColumn>
      </owl:NamedIndividual>
    </eg:hasVariable>
    <eg:hasVariable rdf:resource="https://www.energyguard.eu/ontology/rea#Energy_efficiency_indicators_for_heating_of_multi_apartment_buildings_in_Riga__cadastrena"/>
    <eg:hasVariable>
      <owl:NamedIndividual rdf:about="https://www.energyguard.eu/ontology/rea#Energy_efficiency_indicators_for_heating_of_multi_apartment_buildings_in_Riga__ekspl_gads">
        <dcterms:description xml:lang="en">Year when the building was put into operation.</dcterms:description>
        <rdf:type rdf:resource="https://www.energyguard.eu/ontology#Variable"/>
        <rdfs:label xml:lang="en">construction_year</rdfs:label>
        <eg:dataLakeMatch>column</eg:dataLakeMatch>
        <eg:hasUnit rdf:resource="http://qudt.org/vocab/unit/YR"/>
        <eg:sourceColumnName>ekspl_gads</eg:sourceColumnName>
        <eg:storedInDatabaseColumn>ekspl_gads</eg:storedInDatabaseColumn>
        <eg:unit>year</eg:unit>
      </owl:NamedIndividual>
    </eg:hasVariable>
    <eg:hasVariable>
      <owl:NamedIndividual rdf:about="https://www.energyguard.eu/ontology/rea#Energy_efficiency_indicators_for_heating_of_multi_apartment_buildings_in_Riga__enef_klase">
        <dcterms:description xml:lang="en">Energy efficiency class (A+,A,B,C,D,E,F). The energy efficiency class for heating is determined by the average heating energy consumption over 3-5 years. The class assigned in the data set may differ from the class specified in the building energy certificate due to the fact that energy certification is carried out in detail for a specific building.</dcterms:description>
        <rdf:type rdf:resource="https://www.energyguard.eu/ontology#Variable"/>
        <rdfs:label xml:lang="en">energy_perf_class</rdfs:label>
        <eg:dataLakeMatch>column</eg:dataLakeMatch>
        <eg:sourceColumnName>enef_klase</eg:sourceColumnName>
        <eg:storedInDatabaseColumn>enef_klase</eg:storedInDatabaseColumn>
      </owl:NamedIndividual>
    </eg:hasVariable>
    <eg:hasVariable>
      <owl:NamedIndividual rdf:about="https://www.energyguard.eu/ontology/rea#Energy_efficiency_indicators_for_heating_of_multi_apartment_buildings_in_Riga__filtrs">
        <dcterms:description xml:lang="en">Data quality indicator, e.g. "Correct value". Indicates whether the data is valid or verified.</dcterms:description>
        <rdf:type rdf:resource="https://www.energyguard.eu/ontology#Variable"/>
        <rdfs:label xml:lang="en">data_quality_flag</rdfs:label>
        <eg:dataLakeMatch>column</eg:dataLakeMatch>
        <eg:sourceColumnName>filtrs</eg:sourceColumnName>
        <eg:storedInDatabaseColumn>filtrs</eg:storedInDatabaseColumn>
      </owl:NamedIndividual>
    </eg:hasVariable>
    <eg:hasVariable>
      <owl:NamedIndividual rdf:about="https://www.energyguard.eu/ontology/rea#Energy_efficiency_indicators_for_heating_of_multi_apartment_buildings_in_Riga__geometry">
        <dcterms:description xml:lang="en">Polygon geometry of the building</dcterms:description>
        <rdf:type rdf:resource="https://www.energyguard.eu/ontology#Variable"/>
        <rdfs:label xml:lang="en">geometry</rdfs:label>
        <eg:dataLakeMatch>column</eg:dataLakeMatch>
        <eg:storedInDatabaseColumn>geom</eg:storedInDatabaseColumn>
        <eg:unit>Polygon</eg:unit>
      </owl:NamedIndividual>
    </eg:hasVariable>
    <eg:hasVariable rdf:resource="https://www.energyguard.eu/ontology/rea#Energy_efficiency_indicators_for_heating_of_multi_apartment_buildings_in_Riga__id"/>
    <eg:hasVariable>
      <owl:NamedIndividual rdf:about="https://www.energyguard.eu/ontology/rea#Energy_efficiency_indicators_for_heating_of_multi_apartment_buildings_in_Riga__ip_paterin">
        <dcterms:description xml:lang="en">Actual specific heating consumption for the last 12 months, based on district heating data.</dcterms:description>
        <rdf:type rdf:resource="https://www.energyguard.eu/ontology#Variable"/>
        <rdfs:label xml:lang="en">heating_consumption</rdfs:label>
        <eg:dataLakeMatch>column</eg:dataLakeMatch>
        <eg:sourceColumnName>ip_paterin</eg:sourceColumnName>
        <eg:storedInDatabaseColumn>ip_paterin</eg:storedInDatabaseColumn>
        <eg:unit>kWh/m2/year</eg:unit>
      </owl:NamedIndividual>
    </eg:hasVariable>
    <eg:hasVariable>
      <owl:NamedIndividual rdf:about="https://www.energyguard.eu/ontology/rea#Energy_efficiency_indicators_for_heating_of_multi_apartment_buildings_in_Riga__ipatn_silt">
        <dcterms:description xml:lang="en">This indicator reflects percentage difference between specific heating consumption for the past 12 months (heating_consumption) and average heating consumption indicator for equivalent buildings. Equivalent buildings are buildings, which were built in approximately the same period of time and are similar in area. If the field “Comparison with equivalent buildings” contains a positive number, for example “+15%”, then this means that the selected building consumes 15% more heat energy for heating than similar buildings by area and year of construction. If the comparison is negative, for example “-20%”, then the selected building consumes 20% less heat energy for heating than similar buildings. If data is not available for all 12 months, the result is displayed as “No data”.</dcterms:description>
        <rdf:type rdf:resource="https://www.energyguard.eu/ontology#Variable"/>
        <rdfs:label xml:lang="en">heating_indicator</rdfs:label>
        <eg:dataLakeMatch>column</eg:dataLakeMatch>
        <eg:hasUnit rdf:resource="http://qudt.org/vocab/unit/PERCENT"/>
        <eg:sourceColumnName>ipatn_silt</eg:sourceColumnName>
        <eg:storedInDatabaseColumn>ipatn_silt</eg:storedInDatabaseColumn>
        <eg:unit>%</eg:unit>
      </owl:NamedIndividual>
    </eg:hasVariable>
    <eg:hasVariable>
      <owl:NamedIndividual rdf:about="https://www.energyguard.eu/ontology/rea#Energy_efficiency_indicators_for_heating_of_multi_apartment_buildings_in_Riga__lietd_plat">
        <dcterms:description xml:lang="en">Useful floor area of the building</dcterms:description>
        <rdf:type rdf:resource="https://www.energyguard.eu/ontology#Variable"/>
        <rdfs:label xml:lang="en">useful_area</rdfs:label>
        <eg:dataLakeMatch>column</eg:dataLakeMatch>
        <eg:hasUnit rdf:resource="http://qudt.org/vocab/unit/M2"/>
        <eg:sourceColumnName>lietd_plat</eg:sourceColumnName>
        <eg:storedInDatabaseColumn>lietd_plat</eg:storedInDatabaseColumn>
        <eg:unit>m2</eg:unit>
      </owl:NamedIndividual>
    </eg:hasVariable>
    <eg:hasVariable>
      <owl:NamedIndividual rdf:about="https://www.energyguard.eu/ontology/rea#Energy_efficiency_indicators_for_heating_of_multi_apartment_buildings_in_Riga__renovacija">
        <dcterms:description xml:lang="en">Renovation details, including year of the completion of renovation and funding source (i.e. LIAA (Latvian Investment and Development Agency ) or ALTUM (JSC “Development Finance Institution ALTUM) or Private funding (Privātlīdzekļi))</dcterms:description>
        <rdf:type rdf:resource="https://www.energyguard.eu/ontology#Variable"/>
        <rdfs:label xml:lang="en">renovation_info</rdfs:label>
        <eg:dataLakeMatch>column</eg:dataLakeMatch>
        <eg:sourceColumnName>renovacija</eg:sourceColumnName>
        <eg:storedInDatabaseColumn>renovacija</eg:storedInDatabaseColumn>
      </owl:NamedIndividual>
    </eg:hasVariable>
    <eg:hasVariable>
      <owl:NamedIndividual rdf:about="https://www.energyguard.eu/ontology/rea#Energy_efficiency_indicators_for_heating_of_multi_apartment_buildings_in_Riga__vid_ip_apk">
        <dcterms:description xml:lang="en">Average specific heating energy consumption over the last 3-5 years, based on district heating data.</dcterms:description>
        <rdf:type rdf:resource="https://www.energyguard.eu/ontology#Variable"/>
        <rdfs:label xml:lang="en">avg_heat_energy_consumption</rdfs:label>
        <eg:dataLakeMatch>column</eg:dataLakeMatch>
        <eg:sourceColumnName>vid_ip_apk</eg:sourceColumnName>
        <eg:storedInDatabaseColumn>vid_ip_apk</eg:storedInDatabaseColumn>
        <eg:unit>kWh/m2/year</eg:unit>
      </owl:NamedIndividual>
    </eg:hasVariable>
