  <owl:NamedIndividual rdf:about="https://www.energyguard.eu/ontology/ciemat#Dataset_CEDER_CIEMAT_Microgrid_Daily_Operational_Data_1_s">
    <dcterms:description xml:lang="en">Operational data from the CEDER-CIEMAT microgrid in Soria, Spain. The dataset includes measurements from photovoltaic plants, wind turbines, electrical loads, battery storage systems and auxiliary equipment. It is collected for daily monitoring, operational analysis and the development and validation of intelligent energy management strategies</dcterms:description>
    <dcterms:title xml:lang="en">CEDER-CIEMAT Microgrid – Daily Operational Data (1 s)</dcterms:title>
    <rdf:type rdf:resource="http://www.w3.org/ns/dcat#Dataset"/>
    <rdfs:label xml:lang="en">CEDER-CIEMAT Microgrid – Daily Operational Data (1 s)</rdfs:label>
    <eg:dataOwnerContact>CIEMAT, REDACTED_NAME: REDACTED_EMAIL, REDACTED_NAME: REDACTED_EMAIL, REDACTED_NAME: REDACTED_EMAIL</eg:dataOwnerContact>
    <eg:databaseServer>REDACTED_HOST:REDACTED_PORT</eg:databaseServer>
    <eg:databaseSystem>PostgreSQL</eg:databaseSystem>
    <eg:fileFormat>CSV, comma-separated, decimal point</eg:fileFormat>
    <eg:hasVariable>
      <owl:NamedIndividual rdf:about="https://www.energyguard.eu/ontology/ciemat#ACTARIS">
