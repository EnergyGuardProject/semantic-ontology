        <eg:validRange>≥ 0, non-decreasing</eg:validRange>
        <eg:variableKind>measured</eg:variableKind>
      </owl:NamedIndividual>
    </eg:hasVariable>
    <eg:hasVariable>
      <owl:NamedIndividual rdf:about="https://www.energyguard.eu/ontology/engreen#Operational_monitoring_dataset__collectTime">
        <dcterms:description xml:lang="en">Timestamp of the measurement in UTC (5-minute resolution).</dcterms:description>
        <rdf:type rdf:resource="https://www.energyguard.eu/ontology#Variable"/>
        <rdfs:label xml:lang="en">Timestamp</rdfs:label>
        <eg:dataLakeMatch>timestamp</eg:dataLakeMatch>
        <eg:dataType>datetime</eg:dataType>
        <eg:sourceColumnName>collectTime</eg:sourceColumnName>
        <eg:storedInDatabaseColumn>public.d_calendar.datetime</eg:storedInDatabaseColumn>
        <eg:subsystem>Inverter / Power sensor / Battery</eg:subsystem>
        <eg:validRange>2026 - ongoing</eg:validRange>
      </owl:NamedIndividual>
    </eg:hasVariable>
    <eg:licence>Restricted. Pseudonymised data of REC members, accessible only to EnergyGuard consortium partners (GDPR). Only derived aggregated, anonymised or synthetic datasets may be published (CC BY 4.0).</eg:licence>
    <eg:location>Antrodoco Renewable Energy Community, Antrodoco (RI), Lazio, Italy</eg:location>
    <eg:missingValues>FusionSolar: 'N/A' = not available or not recorded while the device was disconnected; '-' = counter not supported by the device. Solarman: empty cell = not applicable for the current flow direction or not available. Missing intervals = absent rows.</eg:missingValues>
    <eg:sourceSystem>Huawei FusionSolar and Deye Solarman cloud monitoring platforms (API and data export)</eg:sourceSystem>
    <eg:storedInDatabase>TEF7_ENGREEN</eg:storedInDatabase>
    <eg:storedInDatabaseTable>public.f_tsdata</eg:storedInDatabaseTable>
    <eg:systemDescribed>PV plants, inverters, grid connection meters (power sensors) and battery storage systems</eg:systemDescribed>
    <eg:tableLayout>long</eg:tableLayout>
    <eg:temporalCoverage>2025 – ongoing (automated acquisition since March 2026)</eg:temporalCoverage>
    <eg:timeResolution>5 min</eg:timeResolution>
    <eg:timeZone>FusionSolar: Italian local time with daylight saving time (timestamps marked 'DST' in summer). Solarman: time zone given in the 'Time Zone' column (UTC+01:00, no daylight saving shift).</eg:timeZone>
    <eg:updateFrequency>FusionSolar downloaded every 4 hours via API; data exported nightly to the Data Lake. Solarman exported periodically.</eg:updateFrequency>
  </owl:NamedIndividual>
