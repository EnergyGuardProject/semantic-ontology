    </eg:hasVariable>
    <eg:hasVariable>
      <owl:NamedIndividual rdf:about="https://www.energyguard.eu/ontology/engreen#Operational_monitoring_dataset__Total_yield_kWh">
        <dcterms:description xml:lang="en">Cumulative AC energy yield of the inverter</dcterms:description>
        <rdf:type rdf:resource="https://www.energyguard.eu/ontology#EnergyMeasurement"/>
        <rdf:type rdf:resource="https://www.energyguard.eu/ontology#Variable"/>
