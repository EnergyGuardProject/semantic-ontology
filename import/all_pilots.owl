        <rdf:type rdf:resource="https://www.energyguard.eu/ontology#Variable"/>
        <rdfs:label xml:lang="en">01.2019</rdfs:label>
        <eg:dataLakeMatch>none</eg:dataLakeMatch>
        <eg:hasUnit rdf:resource="http://qudt.org/vocab/unit/MegaW-HR"/>
        <eg:unit>MWH</eg:unit>
      </owl:NamedIndividual>
    </eg:hasVariable>
