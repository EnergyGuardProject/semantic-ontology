  <owl:NamedIndividual rdf:about="https://www.energyguard.eu/ontology/rea#Building_and_heating_consumption_data_Heating_2017_2024_xlsx__09_2017">
    <dcterms:description xml:lang="en">Heat consumption (heating + hot water) for month</dcterms:description>
    <rdf:type rdf:resource="https://www.energyguard.eu/ontology#Variable"/>
    <rdfs:label xml:lang="en">09.2017</rdfs:label>
    <eg:dataLakeMatch>none</eg:dataLakeMatch>
    <eg:hasUnit rdf:resource="http://qudt.org/vocab/unit/MegaW-HR"/>
    <eg:unit>MWH</eg:unit>
  </owl:NamedIndividual>
  <owl:NamedIndividual rdf:about="https://www.energyguard.eu/ontology/engreen#Operational_monitoring_dataset__Negative_active_energy_kWh">
    <dcterms:description xml:lang="en">Cumulative active energy measured by the power sensor in the negative flow direction (import from the grid)</dcterms:description>
    <rdf:type rdf:resource="https://www.energyguard.eu/ontology#EnergyMeasurement"/>
    <rdf:type rdf:resource="https://www.energyguard.eu/ontology#Variable"/>
    <rdfs:label xml:lang="en">Negative Active Energy</rdfs:label>
    <eg:aggregation>cumulative</eg:aggregation>
    <eg:aggregationNote>cumulative (lifetime)</eg:aggregationNote>
    <eg:dataLakeMatch>pattern</eg:dataLakeMatch>
    <eg:dataLakeSensorPattern>%\_reverse\_active\_cap</eg:dataLakeSensorPattern>
    <eg:dataType>float</eg:dataType>
    <eg:hasUnit rdf:resource="http://qudt.org/vocab/unit/KiloW-HR"/>
    <eg:sensorId>Pseudonymised power sensor code</eg:sensorId>
    <eg:sensorType>Grid power sensor (Huawei)</eg:sensorType>
    <eg:signConvention>negative direction = import from the grid</eg:signConvention>
    <eg:sourceColumnName>Negative active energy(kWh)</eg:sourceColumnName>
    <eg:subsystem>Power sensor</eg:subsystem>
    <eg:unit>kWh</eg:unit>
    <eg:validRange>≥ 0, non-decreasing</eg:validRange>
    <eg:variableKind>measured</eg:variableKind>
  </owl:NamedIndividual>
  <owl:NamedIndividual rdf:about="https://www.energyguard.eu/ontology/engreen#Dataset_GME_CSUD_Hourly_Electricity_Price_Dataset">
    <dcterms:description xml:lang="en">Hourly zonal electricity price of the Centro-Sud (CSUD) bidding zone of the Italian day-ahead market (MGP), published by GME (Gestore dei Mercati Energetici). It is the reference price used to value the electricity injected into the grid by REC members and to compute the economic indicators of the Digital Twin.</dcterms:description>
    <dcterms:title xml:lang="en">GME CSUD Hourly Electricity Price Dataset</dcterms:title>
    <rdf:type rdf:resource="http://www.w3.org/ns/dcat#Dataset"/>
    <rdfs:label xml:lang="en">GME CSUD Hourly Electricity Price Dataset</rdfs:label>
    <eg:dataOwnerContact>Original source: GME. Dataset compiled by ENGREEN; contact: REDACTED_NAME, REDACTED_EMAIL</eg:dataOwnerContact>
    <eg:fileFormat>XLSX, one sheet 'MGP-PrezziZonali-CSUD'; dates stored as text dd/mm/yyyy; decimal point. Uploaded to the EnergyGuard Data Lake as CSV.</eg:fileFormat>
    <eg:hasVariable>
      <owl:NamedIndividual rdf:about="https://www.energyguard.eu/ontology/engreen#GME_CSUD_Hourly_Electricity_Price_Dataset__Data">
        <dcterms:description xml:lang="en">Calendar date to which the zonal electricity price refers (dd/mm/yyyy)</dcterms:description>
        <rdf:type rdf:resource="https://www.energyguard.eu/ontology#Variable"/>
        <rdfs:label xml:lang="en">Date</rdfs:label>
        <eg:dataLakeMatch>none</eg:dataLakeMatch>
        <eg:dataType>text</eg:dataType>
        <eg:sourceColumnName>Data</eg:sourceColumnName>
      </owl:NamedIndividual>
    </eg:hasVariable>
    <eg:hasVariable>
      <owl:NamedIndividual rdf:about="https://www.energyguard.eu/ontology/engreen#GME_CSUD_Hourly_Electricity_Price_Dataset__Ora">
        <dcterms:description xml:lang="en">Hourly market interval associated with the price (1 = 00:00–01:00)</dcterms:description>
        <rdf:type rdf:resource="https://www.energyguard.eu/ontology#Variable"/>
        <rdfs:label xml:lang="en">Hour</rdfs:label>
        <eg:dataLakeMatch>none</eg:dataLakeMatch>
        <eg:dataType>integer</eg:dataType>
        <eg:hasUnit rdf:resource="http://qudt.org/vocab/unit/HR"/>
        <eg:sourceColumnName>Ora</eg:sourceColumnName>
        <eg:unit>h</eg:unit>
        <eg:validRange>0-23</eg:validRange>
      </owl:NamedIndividual>
    </eg:hasVariable>
    <eg:hasVariable>
      <owl:NamedIndividual rdf:about="https://www.energyguard.eu/ontology/engreen#GME_CSUD_Hourly_Electricity_Price_Dataset__PZ_t">
        <dcterms:description xml:lang="en">Hourly electricity price for the GME Centro-Sud (CSUD) bidding zone, used as the reference value for electricity sold to the grid</dcterms:description>
        <rdf:type rdf:resource="https://www.energyguard.eu/ontology#Variable"/>
        <rdfs:label xml:lang="en">Zonal electricity price</rdfs:label>
        <eg:aggregation>hourly value</eg:aggregation>
        <eg:dataLakeMatch>none</eg:dataLakeMatch>
        <eg:dataType>float</eg:dataType>
        <eg:sourceColumnName>PZ_t</eg:sourceColumnName>
        <eg:subsystem>CSUD bidding zone</eg:subsystem>
        <eg:unit>€/MWh</eg:unit>
        <eg:validRange>≥ 0 (2025: 0 – 0.289)</eg:validRange>
        <eg:variableKind>measured</eg:variableKind>
      </owl:NamedIndividual>
    </eg:hasVariable>
    <eg:licence>Public market data published by GME; reuse with citation of the source (GME terms of use)</eg:licence>
    <eg:location>Italy, Centro-Sud (CSUD) bidding zone, where the Antrodoco REC is located</eg:location>
    <eg:sourceSystem>GME market results (MGP zonal prices), open data</eg:sourceSystem>
    <eg:systemDescribed>Italian wholesale electricity market, day-ahead zonal prices</eg:systemDescribed>
    <eg:temporalCoverage>2025-01-01 – 2026-01-01</eg:temporalCoverage>
    <eg:timeResolution>Hourly</eg:timeResolution>
    <eg:timeZone>Italian local time with daylight saving time (GME convention: 23 hours on the spring change day, 25 on the autumn change day)</eg:timeZone>
    <eg:updateFrequency>One-off file for the 2025 reference year</eg:updateFrequency>
  </owl:NamedIndividual>
  <owl:NamedIndividual rdf:about="https://www.energyguard.eu/ontology/engreen#Dataset_The_Antrodoco_REC_Mapping_Dataset">
    <dcterms:description xml:lang="en">Static description of the members of the Antrodoco REC and of their energy assets: user role and type, GSE status, monitoring system, PV plant and battery characteristics and contracted power. It is the reference dataset that links each pseudonymised metering point to its technical characteristics and is used to build the REC Digital Twin. Names, addresses and geographical coordinates are not included; POD and CENSIMP codes are pseudonymised.</dcterms:description>
    <dcterms:title xml:lang="en">The Antrodoco REC Mapping Dataset</dcterms:title>
    <rdf:type rdf:resource="http://www.w3.org/ns/dcat#Dataset"/>
    <rdfs:label xml:lang="en">The Antrodoco REC Mapping Dataset</rdfs:label>
    <eg:dataOwnerContact>Data controller: C.E.R.A. (Comunità Energetica Rinnovabile Antrodoco). Data processor and contact: ENGREEN, REDACTED_NAME, REDACTED_EMAIL</eg:dataOwnerContact>
    <eg:fileFormat>XLSX source file (sheet 'Map' with data, sheet 'Legenda' with field rules), decimal point. Uploaded to the EnergyGuard Data Lake as CSV.</eg:fileFormat>
    <eg:hasVariable>
      <owl:NamedIndividual rdf:about="https://www.energyguard.eu/ontology/engreen#The_Antrodoco_REC_Mapping_Dataset__CENSIMP">
        <dcterms:description xml:lang="en">Pseudonymised GSE identification code of the generation plant, where applicable</dcterms:description>
        <rdf:type rdf:resource="https://www.energyguard.eu/ontology#Variable"/>
        <rdfs:label xml:lang="en">CENSIMP</rdfs:label>
        <eg:dataLakeMatch>none</eg:dataLakeMatch>
        <eg:dataType>text</eg:dataType>
        <eg:subsystem>PV plant</eg:subsystem>
        <eg:variableKind>static</eg:variableKind>
      </owl:NamedIndividual>
    </eg:hasVariable>
    <eg:hasVariable>
      <owl:NamedIndividual rdf:about="https://www.energyguard.eu/ontology/engreen#The_Antrodoco_REC_Mapping_Dataset__Contributo_PNRR">
        <dcterms:description xml:lang="en">Share of the eligible investment cost covered by the PNRR capital grant, used for the incentive tariff reduction</dcterms:description>
        <rdf:type rdf:resource="https://www.energyguard.eu/ontology#Variable"/>
        <rdfs:label xml:lang="en">PNRR contribution (D6.2 Tables 10, 12)</rdfs:label>
        <eg:dataLakeMatch>none</eg:dataLakeMatch>
        <eg:dataType>float</eg:dataType>
        <eg:hasUnit rdf:resource="http://qudt.org/vocab/unit/PERCENT"/>
        <eg:sourceColumnName>Contributo PNRR</eg:sourceColumnName>
        <eg:subsystem>PV plant</eg:subsystem>
        <eg:unit>%</eg:unit>
        <eg:validRange>0 – 100</eg:validRange>
        <eg:variableKind>static</eg:variableKind>
      </owl:NamedIndividual>
    </eg:hasVariable>
    <eg:hasVariable>
      <owl:NamedIndividual rdf:about="https://www.energyguard.eu/ontology/engreen#The_Antrodoco_REC_Mapping_Dataset__Esente">
        <dcterms:description xml:lang="en">Whether the consumption point is exempt from the PNRR tariff reduction when energy is shared with it</dcterms:description>
        <rdf:type rdf:resource="https://www.energyguard.eu/ontology#Variable"/>
        <rdfs:label xml:lang="en">GSE exemption (D6.2 Tables 10, 12)</rdfs:label>
        <eg:codeList>Si = yes; No = no</eg:codeList>
        <eg:dataLakeMatch>none</eg:dataLakeMatch>
        <eg:dataType>text</eg:dataType>
        <eg:sourceColumnName>Esente</eg:sourceColumnName>
        <eg:subsystem>Metering point</eg:subsystem>
        <eg:variableKind>static</eg:variableKind>
      </owl:NamedIndividual>
    </eg:hasVariable>
    <eg:hasVariable>
      <owl:NamedIndividual rdf:about="https://www.energyguard.eu/ontology/engreen#The_Antrodoco_REC_Mapping_Dataset__GSE">
        <dcterms:description xml:lang="en">Status of the user or asset with respect to registration and data availability through the GSE platform</dcterms:description>
        <rdf:type rdf:resource="https://www.energyguard.eu/ontology#Variable"/>
        <rdfs:label xml:lang="en">GSE status</rdfs:label>
        <eg:codeList>Si = registered, data available; Domanda inviata = application sent; Domanda da mandare = application to be sent</eg:codeList>
        <eg:dataLakeMatch>none</eg:dataLakeMatch>
        <eg:dataType>text</eg:dataType>
        <eg:sourceColumnName>GSE</eg:sourceColumnName>
        <eg:subsystem>REC member</eg:subsystem>
        <eg:variableKind>state</eg:variableKind>
      </owl:NamedIndividual>
    </eg:hasVariable>
    <eg:hasVariable>
      <owl:NamedIndividual rdf:about="https://www.energyguard.eu/ontology/engreen#The_Antrodoco_REC_Mapping_Dataset__Note">
        <dcterms:description xml:lang="en">Additional information on monitoring configuration or data availability (no personal data)</dcterms:description>
        <rdf:type rdf:resource="https://www.energyguard.eu/ontology#Variable"/>
        <rdfs:label xml:lang="en">Notes</rdfs:label>
        <eg:dataLakeMatch>none</eg:dataLakeMatch>
        <eg:dataType>text</eg:dataType>
        <eg:sourceColumnName>Note</eg:sourceColumnName>
        <eg:subsystem>REC member</eg:subsystem>
        <eg:variableKind>static</eg:variableKind>
      </owl:NamedIndividual>
    </eg:hasVariable>
    <eg:hasVariable>
      <owl:NamedIndividual rdf:about="https://www.energyguard.eu/ontology/engreen#The_Antrodoco_REC_Mapping_Dataset__POD">
        <dcterms:description xml:lang="en">Pseudonymised code of the Point of Delivery uniquely identifying the electricity supply or generation connection point</dcterms:description>
        <rdf:type rdf:resource="https://www.energyguard.eu/ontology#Variable"/>
        <rdfs:label xml:lang="en">POD</rdfs:label>
        <eg:dataLakeMatch>none</eg:dataLakeMatch>
