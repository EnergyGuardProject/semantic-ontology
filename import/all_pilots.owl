<?xml version="1.0" encoding="utf-8"?>
<rdf:RDF
  xmlns:rdn="https://www.energyguard.eu/ontology/rdn#"
  xmlns:rea="https://www.energyguard.eu/ontology/rea#"
  xmlns:eg="https://www.energyguard.eu/ontology#"
  xmlns:ciemat="https://www.energyguard.eu/ontology/ciemat#"
  xmlns:owl="http://www.w3.org/2002/07/owl#"
  xmlns:engreen="https://www.energyguard.eu/ontology/engreen#"
  xmlns:dcat="http://www.w3.org/ns/dcat#"
  xmlns:mp="https://www.energyguard.eu/ontology/merged-pilots#"
  xmlns:dcterms="http://purl.org/dc/terms/"
  xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
  xmlns:rdnts="https://www.energyguard.eu/ontology/rdn/timeseries#"
  xmlns:cartif="https://www.energyguard.eu/ontology/cartif#"
  xmlns:qb="http://purl.org/linked-data/cube#"
  xmlns:rdnf="https://www.energyguard.eu/ontology/rdn/faults#"
  xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
  xmlns:cea="https://www.energyguard.eu/ontology/cea#"
  xmlns:ber="https://www.energyguard.eu/ontology/ber#"
  xmlns:s4ener="https://saref.etsi.org/saref4ener/"
  xmlns:qudt="http://qudt.org/schema/qudt/"
  xmlns:sosa="http://www.w3.org/ns/sosa/"
>
  <engreen:UserProfile rdf:about="https://www.energyguard.eu/ontology/engreen#User">
    <rdfs:label>User 1 (Consumer)</rdfs:label>
    <engreen:hasAsset rdf:resource="https://www.energyguard.eu/ontology/engreen#Battery_User1"/>
    <engreen:hasContract rdf:resource="https://www.energyguard.eu/ontology/engreen#Contract_User1"/>
    <engreen:hasMeasurements rdf:resource="https://www.energyguard.eu/ontology/engreen#MeasurementSeries_User1"/>
    <engreen:hasRetributionScheme_User rdf:resource="https://www.energyguard.eu/ontology/engreen#Retribution_User1"/>
  </engreen:UserProfile>
  <engreen:MeasurementSeries rdf:about="https://www.energyguard.eu/ontology/engreen#MeasurementSeries_User">
    <rdfs:label>User 1 Measurement Series</rdfs:label>
    <eg:hasMeasurement>
      <engreen:BatteryMeasurement rdf:about="https://www.energyguard.eu/ontology/engreen#M_Battery_User1_00_00">
        <rdfs:label>User 1 Battery 00:00</rdfs:label>
        <engreen:batterySOC rdf:datatype="http://www.w3.org/2001/XMLSchema#float">65.0</engreen:batterySOC>
        <engreen:chargedDischargedEnergy rdf:datatype="http://www.w3.org/2001/XMLSchema#float">-0.069</engreen:chargedDischargedEnergy>
        <engreen:measuredAt rdf:resource="https://www.energyguard.eu/ontology/engreen#TS_2025_09_14T00_00"/>
      </engreen:BatteryMeasurement>
    </eg:hasMeasurement>
    <eg:hasMeasurement rdf:resource="https://www.energyguard.eu/ontology/engreen#M_Battery_User1_00_05"/>
    <eg:hasMeasurement>
      <engreen:ConsumptionMeasurement rdf:about="https://www.energyguard.eu/ontology/engreen#M_Consumption_User1_00_00">
        <rdfs:label>User 1 Consumption 00:00</rdfs:label>
        <engreen:consumptionValue rdf:datatype="http://www.w3.org/2001/XMLSchema#float">0.0</engreen:consumptionValue>
        <engreen:measuredAt rdf:resource="https://www.energyguard.eu/ontology/engreen#TS_2025_09_14T00_00"/>
      </engreen:ConsumptionMeasurement>
    </eg:hasMeasurement>
    <eg:hasMeasurement rdf:resource="https://www.energyguard.eu/ontology/engreen#M_Consumption_User1_00_05"/>
    <eg:hasMeasurement>
      <engreen:ProductionMeasurement rdf:about="https://www.energyguard.eu/ontology/engreen#M_Production_User1_00_00">
        <rdfs:label>User 1 Production 00:00</rdfs:label>
        <engreen:measuredAt rdf:resource="https://www.energyguard.eu/ontology/engreen#TS_2025_09_14T00_00"/>
        <engreen:productionValue rdf:datatype="http://www.w3.org/2001/XMLSchema#float">0.069</engreen:productionValue>
      </engreen:ProductionMeasurement>
    </eg:hasMeasurement>
    <eg:hasMeasurement rdf:resource="https://www.energyguard.eu/ontology/engreen#M_Production_User1_00_05"/>
  </engreen:MeasurementSeries>
  <owl:DatatypeProperty rdf:about="https://www.energyguard.eu/ontology#location">
    <rdfs:comment xml:lang="en">Site name, city, country.</rdfs:comment>
    <rdfs:label xml:lang="en">location</rdfs:label>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://www.energyguard.eu/ontology#notes">
    <rdfs:comment xml:lang="en">Additional notes reported by the pilot.</rdfs:comment>
    <rdfs:label xml:lang="en">notes</rdfs:label>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://www.energyguard.eu/ontology/rdn/faults#Va_rawValue">
    <rdfs:comment>Phase A voltage value (raw, unscaled). Links to IEC61850 PhaseVoltageDA Data
  Attribute</rdfs:comment>
    <rdfs:domain rdf:resource="https://www.energyguard.eu/ontology#Measurement"/>
    <rdfs:label>Phase A Voltage (raw)</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
    <rdfs:subPropertyOf rdf:resource="http://www.w3.org/ns/sosa/hasSimpleResult"/>
    <rdnf:hasIEC61850Type rdf:resource="https://www.energyguard.eu/ontology/rdn/faults#PhaseVoltageDA"/>
  </owl:DatatypeProperty>
  <owl:ObjectProperty rdf:about="https://www.energyguard.eu/ontology/engreen#hasAsset">
    <rdfs:domain rdf:resource="https://www.energyguard.eu/ontology/engreen#UserProfile"/>
    <rdfs:label>has asset</rdfs:label>
    <rdfs:range rdf:resource="https://www.energyguard.eu/ontology/engreen#EnergyAsset"/>
  </owl:ObjectProperty>
  <owl:DatatypeProperty rdf:about="https://www.energyguard.eu/ontology/rdn/faults#Va_scaledValue">
    <rdfs:comment>Phase A voltage value (scaled). Links to IEC61850 PhaseVoltageDA Data Attribute</rdfs:comment>
    <rdfs:domain rdf:resource="https://www.energyguard.eu/ontology#Measurement"/>
    <rdfs:label>Phase A Voltage (scaled)</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
    <rdfs:subPropertyOf rdf:resource="http://www.w3.org/ns/sosa/hasSimpleResult"/>
    <rdnf:hasIEC61850Type rdf:resource="https://www.energyguard.eu/ontology/rdn/faults#PhaseVoltageDA"/>
  </owl:DatatypeProperty>
  <owl:ObjectProperty rdf:about="https://www.energyguard.eu/ontology/merged-pilots#hasDataset">
    <rdfs:domain rdf:resource="https://www.energyguard.eu/ontology/merged-pilots#Pilot"/>
    <rdfs:label xml:lang="en">has dataset</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/ns/dcat#Dataset"/>
  </owl:ObjectProperty>
  <owl:NamedIndividual rdf:about="https://www.energyguard.eu/ontology/cartif#PumpGroup">
    <rdf:type rdf:resource="https://www.energyguard.eu/ontology/cartif#Pump"/>
    <eg:hasMeasurement>
      <owl:NamedIndividual rdf:about="https://www.energyguard.eu/ontology/cartif#HP_ON">
        <dcterms:description xml:lang="es">Estado de la bomba de calor</dcterms:description>
        <dcterms:description xml:lang="en">Heat pump status</dcterms:description>
        <rdf:type rdf:resource="https://www.energyguard.eu/ontology#StateMeasurement"/>
        <rdf:type rdf:resource="https://www.energyguard.eu/ontology#Variable"/>
        <rdfs:label xml:lang="en">HP_ON</rdfs:label>
        <eg:aggregation>none</eg:aggregation>
        <eg:codeList>0 / 1</eg:codeList>
        <eg:dataLakeMatch>exact</eg:dataLakeMatch>
        <eg:dataLakeSensorId>HP_ON</eg:dataLakeSensorId>
        <eg:dataType>integer</eg:dataType>
        <eg:representsComponent rdf:resource="https://www.energyguard.eu/ontology/cartif#Pump"/>
        <eg:sensorId>HP_ON</eg:sensorId>
        <eg:sensorType>Status</eg:sensorType>
        <eg:subsystem>Heat pump</eg:subsystem>
        <eg:validRange>0–1</eg:validRange>
        <eg:variableKind>measured</eg:variableKind>
      </owl:NamedIndividual>
    </eg:hasMeasurement>
    <eg:hasMeasurement>
      <owl:NamedIndividual rdf:about="https://www.energyguard.eu/ontology/cartif#HP_elect_pow">
        <dcterms:description xml:lang="en">Measurement of the pump's electrical power consumption</dcterms:description>
        <dcterms:description xml:lang="es">Medida de consumo eléctrico de la bomba</dcterms:description>
        <rdf:type rdf:resource="https://www.energyguard.eu/ontology#PowerMeasurement"/>
        <rdf:type rdf:resource="https://www.energyguard.eu/ontology#Variable"/>
        <rdfs:label xml:lang="en">HP_elect_pow</rdfs:label>
        <eg:aggregation>none</eg:aggregation>
        <eg:dataLakeMatch>exact</eg:dataLakeMatch>
        <eg:dataLakeSensorId>HP_elect_pow</eg:dataLakeSensorId>
        <eg:dataType>integer</eg:dataType>
        <eg:hasUnit rdf:resource="http://qudt.org/vocab/unit/W"/>
        <eg:representsComponent rdf:resource="https://www.energyguard.eu/ontology/cartif#Pump"/>
        <eg:sensorId>HP_elect_pow</eg:sensorId>
        <eg:sensorType>Power</eg:sensorType>
        <eg:subsystem>Electrolyser</eg:subsystem>
        <eg:unit>W</eg:unit>
        <eg:variableKind>measured</eg:variableKind>
      </owl:NamedIndividual>
    </eg:hasMeasurement>
    <eg:hasMeasurement>
      <owl:NamedIndividual rdf:about="https://www.energyguard.eu/ontology/cartif#POT_ELE">
        <dcterms:description xml:lang="es">Medida de potencia en el electrolizador</dcterms:description>
        <dcterms:description xml:lang="en">Power measurement in the electrolyzer</dcterms:description>
        <rdf:type rdf:resource="https://www.energyguard.eu/ontology#PowerMeasurement"/>
        <rdf:type rdf:resource="https://www.energyguard.eu/ontology#Variable"/>
        <rdfs:label xml:lang="en">POT_ELE</rdfs:label>
        <eg:aggregation>none</eg:aggregation>
        <eg:dataLakeMatch>exact</eg:dataLakeMatch>
        <eg:dataLakeSensorId>POT_ELE</eg:dataLakeSensorId>
        <eg:dataType>integer</eg:dataType>
        <eg:hasUnit rdf:resource="http://qudt.org/vocab/unit/W"/>
        <eg:representsComponent rdf:resource="https://www.energyguard.eu/ontology/cartif#Pump"/>
        <eg:sensorId>POT_ELE</eg:sensorId>
        <eg:sensorType>Power</eg:sensorType>
        <eg:subsystem>Electrolyser</eg:subsystem>
        <eg:unit>W</eg:unit>
        <eg:variableKind>measured</eg:variableKind>
      </owl:NamedIndividual>
    </eg:hasMeasurement>
    <eg:hasMeasurement>
      <owl:NamedIndividual rdf:about="https://www.energyguard.eu/ontology/cartif#POT_PILA">
        <dcterms:description xml:lang="es">Medida de potencia en la pila de combustible</dcterms:description>
        <dcterms:description xml:lang="en">Power measurement in the fuel cell</dcterms:description>
        <rdf:type rdf:resource="https://www.energyguard.eu/ontology#PowerMeasurement"/>
        <rdf:type rdf:resource="https://www.energyguard.eu/ontology#Variable"/>
        <rdfs:label xml:lang="en">POT_PILA</rdfs:label>
        <eg:aggregation>none</eg:aggregation>
        <eg:dataLakeMatch>exact</eg:dataLakeMatch>
        <eg:dataLakeSensorId>POT_PILA</eg:dataLakeSensorId>
        <eg:dataType>integer</eg:dataType>
        <eg:hasUnit rdf:resource="http://qudt.org/vocab/unit/W"/>
        <eg:representsComponent rdf:resource="https://www.energyguard.eu/ontology/cartif#Pump"/>
        <eg:sensorId>POT_PILA</eg:sensorId>
        <eg:sensorType>Power</eg:sensorType>
        <eg:subsystem>Fuel cell</eg:subsystem>
        <eg:unit>W</eg:unit>
        <eg:variableKind>measured</eg:variableKind>
      </owl:NamedIndividual>
    </eg:hasMeasurement>
    <eg:hasMeasurement>
      <owl:NamedIndividual rdf:about="https://www.energyguard.eu/ontology/cartif#Pump_State">
        <dcterms:description xml:lang="es">Estado de la bomba</dcterms:description>
        <dcterms:description xml:lang="en">Pump status</dcterms:description>
        <rdf:type rdf:resource="https://www.energyguard.eu/ontology#StateMeasurement"/>
        <rdf:type rdf:resource="https://www.energyguard.eu/ontology#Variable"/>
        <rdfs:label xml:lang="en">Pump_State</rdfs:label>
        <eg:aggregation>none</eg:aggregation>
        <eg:codeList>0 / 1</eg:codeList>
        <eg:dataLakeMatch>exact</eg:dataLakeMatch>
        <eg:dataLakeSensorId>Pump_State</eg:dataLakeSensorId>
        <eg:dataType>float</eg:dataType>
        <eg:hasUnit rdf:resource="http://qudt.org/vocab/unit/KiloW"/>
        <eg:representsComponent rdf:resource="https://www.energyguard.eu/ontology/cartif#Pump"/>
        <eg:sensorId>Pump_State</eg:sensorId>
        <eg:sensorType>Status</eg:sensorType>
        <eg:subsystem>Hydrogen test bench</eg:subsystem>
        <eg:validRange>0–1</eg:validRange>
        <eg:variableKind>state</eg:variableKind>
      </owl:NamedIndividual>
    </eg:hasMeasurement>
    <eg:hasMeasurement>
      <owl:NamedIndividual rdf:about="https://www.energyguard.eu/ontology/cartif#Resistor_Pow">
        <dcterms:description xml:lang="es">Medida de potencia de la resistencia del tanque</dcterms:description>
        <dcterms:description xml:lang="en">Power measurement of the tank heater</dcterms:description>
        <rdf:type rdf:resource="https://www.energyguard.eu/ontology#PowerMeasurement"/>
        <rdf:type rdf:resource="https://www.energyguard.eu/ontology#Variable"/>
        <rdfs:label xml:lang="en">Resistor_Pow</rdfs:label>
        <eg:aggregation>none</eg:aggregation>
        <eg:dataLakeMatch>exact</eg:dataLakeMatch>
        <eg:dataLakeSensorId>Resistor_Pow</eg:dataLakeSensorId>
        <eg:dataType>integer</eg:dataType>
        <eg:hasUnit rdf:resource="http://qudt.org/vocab/unit/W"/>
        <eg:representsComponent rdf:resource="https://www.energyguard.eu/ontology/cartif#Pump"/>
        <eg:sensorId>Resistor_Pow</eg:sensorId>
        <eg:sensorType>Power</eg:sensorType>
        <eg:subsystem>Hydrogen test bench</eg:subsystem>
        <eg:unit>W</eg:unit>
        <eg:variableKind>measured</eg:variableKind>
      </owl:NamedIndividual>
    </eg:hasMeasurement>
    <eg:hasMeasurement>
      <owl:NamedIndividual rdf:about="https://www.energyguard.eu/ontology/cartif#Resistor_SP">
        <dcterms:description xml:lang="es">Consigna de potencia dada a la resistencia del tanque</dcterms:description>
        <dcterms:description xml:lang="en">Power setpoint provided to the tank heater</dcterms:description>
        <rdf:type rdf:resource="https://www.energyguard.eu/ontology#PowerMeasurement"/>
        <rdf:type rdf:resource="https://www.energyguard.eu/ontology#Variable"/>
        <rdfs:label xml:lang="en">Resistor_SP</rdfs:label>
        <eg:aggregation>none</eg:aggregation>
        <eg:dataLakeMatch>exact</eg:dataLakeMatch>
        <eg:dataLakeSensorId>Resistor_SP</eg:dataLakeSensorId>
        <eg:dataType>integer</eg:dataType>
        <eg:hasUnit rdf:resource="http://qudt.org/vocab/unit/W"/>
        <eg:representsComponent rdf:resource="https://www.energyguard.eu/ontology/cartif#AuxiliaryDevice"/>
        <eg:sensorId>Resistor_SP</eg:sensorId>
        <eg:sensorType>Power</eg:sensorType>
        <eg:subsystem>Hydrogen test bench</eg:subsystem>
        <eg:unit>W</eg:unit>
        <eg:variableKind>setpoint</eg:variableKind>
      </owl:NamedIndividual>
    </eg:hasMeasurement>
  </owl:NamedIndividual>
  <owl:DatatypeProperty rdf:about="https://www.energyguard.eu/ontology#licence">
    <rdfs:comment xml:lang="en">Terms of use.</rdfs:comment>
    <rdfs:label xml:lang="en">licence</rdfs:label>
  </owl:DatatypeProperty>
  <owl:NamedIndividual rdf:about="https://www.energyguard.eu/ontology/cartif#BatterySystemGroup">
    <eg:hasMeasurement>
      <owl:NamedIndividual rdf:about="https://www.energyguard.eu/ontology/cartif#BATA_Current">
        <dcterms:description xml:lang="en">Current measurement in electrical battery A</dcterms:description>
        <dcterms:description xml:lang="es">Medida de corriente en la batería eléctrica A</dcterms:description>
        <rdf:type rdf:resource="https://www.energyguard.eu/ontology#Variable"/>
        <rdf:type rdf:resource="https://www.energyguard.eu/ontology/cartif#ElectricalMeasurement"/>
        <rdfs:label xml:lang="en">BATA_Current</rdfs:label>
        <eg:aggregation>none</eg:aggregation>
        <eg:dataLakeMatch>exact</eg:dataLakeMatch>
        <eg:dataLakeSensorId>BATA_Current</eg:dataLakeSensorId>
        <eg:dataType>integer</eg:dataType>
        <eg:hasUnit rdf:resource="http://qudt.org/vocab/unit/A"/>
        <eg:representsComponent rdf:resource="https://www.energyguard.eu/ontology#Battery"/>
        <eg:sensorId>BATA_Current</eg:sensorId>
        <eg:sensorType>Battery monitoring signal</eg:sensorType>
        <eg:subsystem>Battery</eg:subsystem>
        <eg:unit>A</eg:unit>
        <eg:variableKind>measured</eg:variableKind>
      </owl:NamedIndividual>
    </eg:hasMeasurement>
    <eg:hasMeasurement>
      <owl:NamedIndividual rdf:about="https://www.energyguard.eu/ontology/cartif#BATA_SOC">
        <dcterms:description xml:lang="es">Estado de carga en la batería eléctrica A</dcterms:description>
        <dcterms:description xml:lang="en">State of charge of electrical battery A</dcterms:description>
        <rdf:type rdf:resource="https://www.energyguard.eu/ontology#Variable"/>
        <rdf:type rdf:resource="https://www.energyguard.eu/ontology/cartif#ElectricalMeasurement"/>
        <rdfs:label xml:lang="en">BATA_SOC</rdfs:label>
        <eg:aggregation>none</eg:aggregation>
        <eg:dataLakeMatch>exact</eg:dataLakeMatch>
        <eg:dataLakeSensorId>BATA_SOC</eg:dataLakeSensorId>
        <eg:dataType>integer</eg:dataType>
        <eg:hasUnit rdf:resource="http://qudt.org/vocab/unit/PERCENT"/>
        <eg:representsComponent rdf:resource="https://www.energyguard.eu/ontology#Battery"/>
        <eg:sensorId>BATA_SOC</eg:sensorId>
        <eg:sensorType>Battery monitoring signal</eg:sensorType>
        <eg:subsystem>Battery</eg:subsystem>
        <eg:unit>%</eg:unit>
        <eg:validRange>0–100 %</eg:validRange>
        <eg:variableKind>measured</eg:variableKind>
      </owl:NamedIndividual>
    </eg:hasMeasurement>
    <eg:hasMeasurement>
      <owl:NamedIndividual rdf:about="https://www.energyguard.eu/ontology/cartif#BATA_Voltage">
        <dcterms:description xml:lang="es">Medida de voltaje en la batería eléctrica A</dcterms:description>
        <dcterms:description xml:lang="en">Voltage measurement in electrical battery A</dcterms:description>
        <rdf:type rdf:resource="https://www.energyguard.eu/ontology#Variable"/>
        <rdf:type rdf:resource="https://www.energyguard.eu/ontology/cartif#ElectricalMeasurement"/>
        <rdfs:label xml:lang="en">BATA_Voltage</rdfs:label>
        <eg:aggregation>none</eg:aggregation>
        <eg:dataLakeMatch>exact</eg:dataLakeMatch>
        <eg:dataLakeSensorId>BATA_Voltage</eg:dataLakeSensorId>
        <eg:dataType>integer</eg:dataType>
        <eg:hasUnit rdf:resource="http://qudt.org/vocab/unit/V"/>
        <eg:representsComponent rdf:resource="https://www.energyguard.eu/ontology#Battery"/>
        <eg:sensorId>BATA_Voltage</eg:sensorId>
        <eg:sensorType>Battery monitoring signal</eg:sensorType>
        <eg:subsystem>Battery</eg:subsystem>
        <eg:unit>V</eg:unit>
        <eg:variableKind>measured</eg:variableKind>
      </owl:NamedIndividual>
    </eg:hasMeasurement>
    <eg:hasMeasurement>
      <owl:NamedIndividual rdf:about="https://www.energyguard.eu/ontology/cartif#BATB_Current">
        <dcterms:description xml:lang="en">Current measurement in electrical battery B</dcterms:description>
        <dcterms:description xml:lang="es">Medida de corriente en la batería eléctrica B</dcterms:description>
        <rdf:type rdf:resource="https://www.energyguard.eu/ontology#Variable"/>
        <rdf:type rdf:resource="https://www.energyguard.eu/ontology/cartif#ElectricalMeasurement"/>
        <rdfs:label xml:lang="en">BATB_Current</rdfs:label>
        <eg:aggregation>none</eg:aggregation>
        <eg:dataLakeMatch>exact</eg:dataLakeMatch>
        <eg:dataLakeSensorId>BATB_Current</eg:dataLakeSensorId>
        <eg:dataType>integer</eg:dataType>
        <eg:hasUnit rdf:resource="http://qudt.org/vocab/unit/A"/>
        <eg:representsComponent rdf:resource="https://www.energyguard.eu/ontology#Battery"/>
        <eg:sensorId>BATB_Current</eg:sensorId>
        <eg:sensorType>Battery monitoring signal</eg:sensorType>
        <eg:subsystem>Battery</eg:subsystem>
        <eg:unit>A</eg:unit>
        <eg:variableKind>measured</eg:variableKind>
      </owl:NamedIndividual>
    </eg:hasMeasurement>
    <eg:hasMeasurement>
      <owl:NamedIndividual rdf:about="https://www.energyguard.eu/ontology/cartif#BATERIAS_Alarm">
        <dcterms:description xml:lang="en">Alarm signals related to battery status</dcterms:description>
        <dcterms:description xml:lang="es">Señales de alarma relacionadas con el estado de la Batería</dcterms:description>
        <rdf:type rdf:resource="https://www.energyguard.eu/ontology#StateMeasurement"/>
        <rdf:type rdf:resource="https://www.energyguard.eu/ontology#Variable"/>
        <rdf:type rdf:resource="https://www.energyguard.eu/ontology/cartif#Alarm"/>
        <rdfs:label xml:lang="en">BATERIAS_Alarm</rdfs:label>
        <eg:aggregation>none</eg:aggregation>
        <eg:codeList>0 / 1</eg:codeList>
        <eg:dataLakeMatch>exact</eg:dataLakeMatch>
        <eg:dataLakeSensorId>BATERIAS_Alarm</eg:dataLakeSensorId>
        <eg:dataType>integer</eg:dataType>
        <eg:representsComponent rdf:resource="https://www.energyguard.eu/ontology#Battery"/>
        <eg:sensorId>BATERIAS_Alarm</eg:sensorId>
        <eg:sensorType>Status</eg:sensorType>
        <eg:subsystem>Battery</eg:subsystem>
        <eg:validRange>0–1</eg:validRange>
        <eg:variableKind>alarm</eg:variableKind>
      </owl:NamedIndividual>
    </eg:hasMeasurement>
    <eg:hasMeasurement>
      <owl:NamedIndividual rdf:about="https://www.energyguard.eu/ontology/cartif#BATERIAS_War">
        <dcterms:description xml:lang="es">Señales de advertencias relacionadas con el estado de la Batería</dcterms:description>
        <dcterms:description xml:lang="en">Warning signals related to battery status</dcterms:description>
        <rdf:type rdf:resource="https://www.energyguard.eu/ontology#StateMeasurement"/>
        <rdf:type rdf:resource="https://www.energyguard.eu/ontology#Variable"/>
        <rdf:type rdf:resource="https://www.energyguard.eu/ontology/cartif#Warning"/>
        <rdfs:label xml:lang="en">BATERIAS_War</rdfs:label>
        <eg:aggregation>none</eg:aggregation>
        <eg:codeList>0 / 1</eg:codeList>
        <eg:dataLakeMatch>exact</eg:dataLakeMatch>
