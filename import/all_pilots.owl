  <owl:NamedIndividual rdf:about="https://www.energyguard.eu/ontology/engreen#Dataset_The_GSE_Historical_Metering_Dataset">
    <dcterms:description xml:lang="en">Hourly metering data of the REC metering points retrieved from the GSE (Gestore dei Servizi Energetici) platform, which ENGREEN accesses as REC operator. It consists of three files with the same structure: grid withdrawal (consumption points), grid injection and energy production (production units). It is used for historical analysis, baseline definition, load-profile reconstruction and Digital Twin calibration.</dcterms:description>
    <dcterms:title xml:lang="en">The GSE Historical Metering Dataset</dcterms:title>
    <rdf:type rdf:resource="http://www.w3.org/ns/dcat#Dataset"/>
    <rdfs:label xml:lang="en">The GSE Historical Metering Dataset</rdfs:label>
    <eg:dataOwnerContact>Data controller: C.E.R.A. (Comunità Energetica Rinnovabile Antrodoco). Data processor and contact: ENGREEN, REDACTED_NAME, REDACTED_EMAIL</eg:dataOwnerContact>
    <eg:fileFormat>XLSX source files, one sheet each: Withdrawn_Energy, Fed-In_Energy, Produced_Energy; decimal point. Uploaded to the EnergyGuard Data Lake as CSV.</eg:fileFormat>
    <eg:hasVariable>
      <owl:NamedIndividual rdf:about="https://www.energyguard.eu/ontology/engreen#The_GSE_Historical_Metering_Dataset__Codice_Misura">
        <dcterms:description xml:lang="en">Identifier of the metering stream (POD for grid withdrawal) or generation unit (GSE UPN code for injection and production), pseudonymised</dcterms:description>
        <rdf:type rdf:resource="https://www.energyguard.eu/ontology#Variable"/>
        <rdfs:label xml:lang="en">Measurement code</rdfs:label>
        <eg:dataLakeMatch>none</eg:dataLakeMatch>
        <eg:dataType>text</eg:dataType>
        <eg:sensorId>Pseudonymised measurement code</eg:sensorId>
        <eg:sensorType>Fiscal energy meter (DSO)</eg:sensorType>
        <eg:sourceColumnName>Codice Misura</eg:sourceColumnName>
        <eg:subsystem>Metering point / production unit</eg:subsystem>
        <eg:variableKind>static</eg:variableKind>
      </owl:NamedIndividual>
    </eg:hasVariable>
    <eg:hasVariable>
      <owl:NamedIndividual rdf:about="https://www.energyguard.eu/ontology/engreen#The_GSE_Historical_Metering_Dataset__Data">
        <dcterms:description xml:lang="en">Calendar date to which the measured value refers</dcterms:description>
        <rdf:type rdf:resource="https://www.energyguard.eu/ontology#Variable"/>
        <rdfs:label xml:lang="en">Date</rdfs:label>
        <eg:dataLakeMatch>none</eg:dataLakeMatch>
        <eg:dataType>datetime</eg:dataType>
        <eg:sourceColumnName>Data</eg:sourceColumnName>
      </owl:NamedIndividual>
    </eg:hasVariable>
    <eg:hasVariable>
      <owl:NamedIndividual rdf:about="https://www.energyguard.eu/ontology/engreen#The_GSE_Historical_Metering_Dataset__Ora">
        <dcterms:description xml:lang="en">Hourly interval to which the measured value refers (start of the hour)</dcterms:description>
        <rdf:type rdf:resource="https://www.energyguard.eu/ontology#Variable"/>
        <rdfs:label xml:lang="en">Hour</rdfs:label>
        <eg:dataLakeMatch>none</eg:dataLakeMatch>
        <eg:dataType>integer</eg:dataType>
        <eg:hasUnit rdf:resource="http://qudt.org/vocab/unit/HR"/>
        <eg:sourceColumnName>Ora</eg:sourceColumnName>
        <eg:unit>h</eg:unit>
        <eg:validRange>0 – 23</eg:validRange>
      </owl:NamedIndividual>
    </eg:hasVariable>
    <eg:hasVariable rdf:resource="https://www.energyguard.eu/ontology/engreen#The_GSE_Historical_Metering_Dataset__kWh"/>
    <eg:licence>Restricted. Pseudonymised data of REC members, accessible only to EnergyGuard consortium partners (GDPR). Only derived aggregated, anonymised or synthetic datasets may be published (CC BY 4.0).</eg:licence>
    <eg:location>Antrodoco Renewable Energy Community, Antrodoco (RI), Lazio, Italy</eg:location>
    <eg:missingValues>No explicit marker; missing periods = absent rows (availability varies by metering point)</eg:missingValues>
    <eg:sourceSystem>GSE platform (official metering data), manual export</eg:sourceSystem>
    <eg:systemDescribed>Grid withdrawal, grid injection and PV production of the REC metering points</eg:systemDescribed>
    <eg:temporalCoverage>2025-01-01 – 2026-04-30, ongoing (data published by GSE with a delay of about 60 days)</eg:temporalCoverage>
    <eg:timeResolution>Hourly</eg:timeResolution>
    <eg:timeZone>Italian local time with daylight saving time. Hour 0–23 = start of the hour.</eg:timeZone>
    <eg:updateFrequency>Periodic manual download from the GSE platform, then upload to the Data Lake</eg:updateFrequency>
  </owl:NamedIndividual>
  <owl:NamedIndividual rdf:about="https://www.energyguard.eu/ontology/engreen#Dataset_Operational_monitoring_dataset">
    <dcterms:description xml:lang="en">Time series of the operating data of the PV plants, inverters, grid meters and batteries of the REC producers and prosumers, collected from the Huawei FusionSolar (10 plants) and Deye Solarman (1 municipal plant with battery) monitoring platforms. It is the real-time operational layer of the Digital Twin and supports PV performance analysis, battery operation analysis and anomaly detection. Only a selected subset of the variables available on the platforms is retained.</dcterms:description>
    <dcterms:title xml:lang="en">Operational monitoring dataset</dcterms:title>
    <rdf:type rdf:resource="http://www.w3.org/ns/dcat#Dataset"/>
    <rdfs:label xml:lang="en">Operational monitoring dataset</rdfs:label>
    <eg:dataOwnerContact>Data controller: C.E.R.A. (Comunità Energetica Rinnovabile Antrodoco). Data processor and contact: ENGREEN, REDACTED_NAME, REDACTED_EMAIL</eg:dataOwnerContact>
    <eg:databaseServer>REDACTED_HOST:REDACTED_PORT</eg:databaseServer>
    <eg:databaseSystem>PostgreSQL</eg:databaseSystem>
    <eg:fileFormat>XLSX source exports. FusionSolar: one file per device (inverter, power sensor or battery), four header rows (time range, export time, legend, column names); column names and decimal separator follow the portal language. Solarman: one file per plant, one header row, numeric values stored as text. Uploaded to the EnergyGuard Data Lake as CSV.</eg:fileFormat>
    <eg:hasVariable>
      <owl:NamedIndividual rdf:about="https://www.energyguard.eu/ontology/engreen#Operational_monitoring_dataset__Active_power_W">
        <dcterms:description xml:lang="en">Instantaneous active power measured by the power meter at the grid connection point</dcterms:description>
        <rdf:type rdf:resource="https://www.energyguard.eu/ontology#PowerMeasurement"/>
        <rdf:type rdf:resource="https://www.energyguard.eu/ontology#Variable"/>
        <rdfs:label xml:lang="en">Active Power</rdfs:label>
        <eg:aggregation>instantaneous</eg:aggregation>
        <eg:dataLakeMatch>pattern</eg:dataLakeMatch>
        <eg:dataLakeSensorPattern>%\_active\_power</eg:dataLakeSensorPattern>
        <eg:dataType>float</eg:dataType>
        <eg:hasUnit rdf:resource="http://qudt.org/vocab/unit/W"/>
        <eg:sensorId>Pseudonymised power sensor code</eg:sensorId>
        <eg:sensorType>Grid power sensor (Huawei)</eg:sensorType>
        <eg:signConvention>+ = export to the grid; - = import from the grid</eg:signConvention>
        <eg:sourceColumnName>Active power(W)</eg:sourceColumnName>
        <eg:subsystem>Power sensor</eg:subsystem>
        <eg:unit>W</eg:unit>
        <eg:validRange>limited by plant and contracted power</eg:validRange>
        <eg:variableKind>measured</eg:variableKind>
      </owl:NamedIndividual>
    </eg:hasVariable>
    <eg:hasVariable>
      <owl:NamedIndividual rdf:about="https://www.energyguard.eu/ontology/engreen#Operational_monitoring_dataset__Active_power_kW">
        <dcterms:description xml:lang="en">Instantaneous active power measured by the inverter (AC output)</dcterms:description>
        <rdf:type rdf:resource="https://www.energyguard.eu/ontology#PowerMeasurement"/>
        <rdf:type rdf:resource="https://www.energyguard.eu/ontology#Variable"/>
        <rdfs:label xml:lang="en">Active Power</rdfs:label>
        <eg:aggregation>instantaneous</eg:aggregation>
        <eg:dataLakeMatch>pattern</eg:dataLakeMatch>
        <eg:dataLakeSensorPattern>%\_active\_power</eg:dataLakeSensorPattern>
        <eg:dataType>float</eg:dataType>
        <eg:hasUnit rdf:resource="http://qudt.org/vocab/unit/KiloW"/>
        <eg:sensorId>Pseudonymised inverter code</eg:sensorId>
        <eg:sensorType>PV inverter (Huawei)</eg:sensorType>
        <eg:sourceColumnName>Active power(kW)</eg:sourceColumnName>
        <eg:subsystem>Inverter</eg:subsystem>
        <eg:unit>kW</eg:unit>
        <eg:validRange>0 – inverter nominal power</eg:validRange>
        <eg:variableKind>measured</eg:variableKind>
      </owl:NamedIndividual>
    </eg:hasVariable>
    <eg:hasVariable>
      <owl:NamedIndividual rdf:about="https://www.energyguard.eu/ontology/engreen#Operational_monitoring_dataset__Batteria_SOC">
        <dcterms:description xml:lang="en">Battery state of charge, representing the available stored energy relative to its capacity</dcterms:description>
        <rdf:type rdf:resource="https://www.energyguard.eu/ontology#StateOfChargeMeasurement"/>
        <rdf:type rdf:resource="https://www.energyguard.eu/ontology#Variable"/>
        <rdfs:label xml:lang="en">Battery SOC</rdfs:label>
        <eg:aggregation>instantaneous</eg:aggregation>
        <eg:dataLakeMatch>pattern</eg:dataLakeMatch>
        <eg:dataLakeSensorPattern>%\_battery\_soc</eg:dataLakeSensorPattern>
        <eg:dataType>float</eg:dataType>
        <eg:hasUnit rdf:resource="http://qudt.org/vocab/unit/PERCENT"/>
        <eg:sensorId>Pseudonymised battery code</eg:sensorId>
        <eg:sensorType>Battery (Huawei LUNA2000)</eg:sensorType>
        <eg:sourceColumnName>Batteria SOC(%)</eg:sourceColumnName>
        <eg:subsystem>Battery</eg:subsystem>
        <eg:unit>%</eg:unit>
        <eg:validRange>0 – 100</eg:validRange>
        <eg:variableKind>measured</eg:variableKind>
      </owl:NamedIndividual>
    </eg:hasVariable>
    <eg:hasVariable>
      <owl:NamedIndividual rdf:about="https://www.energyguard.eu/ontology/engreen#Operational_monitoring_dataset__Battery_Power_W">
        <dcterms:description xml:lang="en">Instantaneous power exchanged with the battery during charging or discharging</dcterms:description>
        <rdf:type rdf:resource="https://www.energyguard.eu/ontology#PowerMeasurement"/>
        <rdf:type rdf:resource="https://www.energyguard.eu/ontology#Variable"/>
