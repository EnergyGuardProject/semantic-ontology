  <owl:NamedIndividual rdf:about="https://www.energyguard.eu/ontology/rea#Dataset_Buildings_monthly_heat_series_ARCGIS_Server">
    <dcterms:description xml:lang="en">Monthly heat consumption updates from 01.2021 to the current month for the 4,845 multi-apartment buildings that don't share a heat generator, pulled from the georiga ArcGIS REST service to extend the historical heating dataset.</dcterms:description>
    <dcterms:title xml:lang="en">Buildings monthly heat series - ARCGIS Server</dcterms:title>
    <rdf:type rdf:resource="http://www.w3.org/ns/dcat#Dataset"/>
    <rdfs:label xml:lang="en">Buildings monthly heat series - ARCGIS Server</rdfs:label>
    <eg:databaseServer>REDACTED_HOST:REDACTED_PORT</eg:databaseServer>
    <eg:databaseSystem>PostgreSQL</eg:databaseSystem>
    <eg:hasVariable>
      <owl:NamedIndividual rdf:about="https://www.energyguard.eu/ontology/rea#Buildings_monthly_heat_series_ARCGIS_Server__01_2021_current_month_current_year">
        <rdf:type rdf:resource="https://www.energyguard.eu/ontology#Variable"/>
        <rdfs:label xml:lang="en">01.2021 - current_month._current_year</rdfs:label>
        <eg:dataLakeMatch>column</eg:dataLakeMatch>
        <eg:storedInDatabaseColumn>public.f_tsdata.f_value</eg:storedInDatabaseColumn>
      </owl:NamedIndividual>
    </eg:hasVariable>
    <eg:hasVariable>
      <owl:NamedIndividual rdf:about="https://www.energyguard.eu/ontology/rea#Buildings_monthly_heat_series_ARCGIS_Server__Adrese">
        <rdf:type rdf:resource="https://www.energyguard.eu/ontology#Variable"/>
        <rdfs:label xml:lang="en">Adrese</rdfs:label>
        <eg:dataLakeMatch>column</eg:dataLakeMatch>
        <eg:storedInDatabaseColumn>public.d_sensor.name</eg:storedInDatabaseColumn>
      </owl:NamedIndividual>
    </eg:hasVariable>
    <eg:hasVariable>
      <owl:NamedIndividual rdf:about="https://www.energyguard.eu/ontology/rea#Buildings_monthly_heat_series_ARCGIS_Server__Kadastra_Nr">
        <rdf:type rdf:resource="https://www.energyguard.eu/ontology#Variable"/>
        <rdfs:label xml:lang="en">Kadastra Nr.</rdfs:label>
        <eg:dataLakeMatch>column</eg:dataLakeMatch>
        <eg:storedInDatabaseColumn>public.d_sensor.sensor_id</eg:storedInDatabaseColumn>
      </owl:NamedIndividual>
    </eg:hasVariable>
    <eg:notes>These are the monthly updates for the heating consumption time series data. | They come from https://georiga.lv/server/rest/services/REA/MapServer/0/query?where=1%3D1&amp;outFields=*&amp;returnGeometry=true&amp;f=json. | It is based on the previous dataset, but the updates are not for every building - they are from the residential multi-apartment that not share heat generator, i.e. the cadastral numbers/building (4845) of https://epuntuagr.sharepoint.com/:x:/r/sites/EnergyGuardConsortium/Document%20Library/5-Work%20Packages%20Working%20Folders/WP4%20-%20EnergyGuard%20TEF%20AI%20Development%20Sandbox%20and%20Integration/T4.5/Buildings%20list%20for%20DT.xlsx?d=w4abad13559c341549c714c7c9ab36303&amp;csf=1&amp;web=1&amp;e=SExlJV. | The updates from georiga sevrer will enrich the dataset, by adding the new monthly value to the historical ones.</eg:notes>
    <eg:storedInDatabase>TEF6_REA</eg:storedInDatabase>
    <eg:storedInDatabaseTable>public.f_tsdata</eg:storedInDatabaseTable>
    <eg:tableLayout>long</eg:tableLayout>
  </owl:NamedIndividual>
  <owl:NamedIndividual rdf:about="https://www.energyguard.eu/ontology/engreen#The_Weather_Dataset__cloud_cover">
    <dcterms:description xml:lang="en">Total cloud cover, representing the percentage of sky covered by clouds</dcterms:description>
    <rdf:type rdf:resource="https://www.energyguard.eu/ontology#Variable"/>
    <rdfs:label xml:lang="en">cloud_pct</rdfs:label>
