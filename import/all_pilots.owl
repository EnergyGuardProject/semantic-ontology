  <owl:Class rdf:about="https://www.energyguard.eu/ontology/merged-pilots#ENGREEN">
    <rdfs:label>ENGREEN</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://www.energyguard.eu/ontology/merged-pilots#Pilot"/>
    <mp:hasDataset rdf:resource="https://www.energyguard.eu/ontology/engreen#Dataset_GME_CSUD_Hourly_Electricity_Price_Dataset"/>
    <mp:hasDataset rdf:resource="https://www.energyguard.eu/ontology/engreen#Dataset_Operational_monitoring_dataset"/>
    <mp:hasDataset rdf:resource="https://www.energyguard.eu/ontology/engreen#Dataset_Shelly_consumer_monitoring_dataset"/>
    <mp:hasDataset rdf:resource="https://www.energyguard.eu/ontology/engreen#Dataset_The_Antrodoco_REC_Mapping_Dataset"/>
    <mp:hasDataset rdf:resource="https://www.energyguard.eu/ontology/engreen#Dataset_The_GSE_Historical_Metering_Dataset"/>
    <mp:hasDataset>
      <owl:NamedIndividual rdf:about="https://www.energyguard.eu/ontology/engreen#Dataset_The_Weather_Dataset">
        <dcterms:description xml:lang="en">Hourly meteorological and solar radiation data for the Antrodoco area from the Open-Meteo historical weather API, extracted for a single reference point covering the REC (no coordinates of individual installations are processed). It is used to model PV production, interpret consumption patterns and analyse abnormal asset behaviour.</dcterms:description>
        <dcterms:title xml:lang="en">The Weather Dataset</dcterms:title>
        <rdf:type rdf:resource="http://www.w3.org/ns/dcat#Dataset"/>
        <rdfs:label xml:lang="en">The Weather Dataset</rdfs:label>
        <eg:dataOwnerContact>Original source: Open-Meteo. Dataset compiled by ENGREEN; contact: REDACTED_NAME, REDACTED_EMAIL</eg:dataOwnerContact>
        <eg:databaseServer>REDACTED_HOST:REDACTED_PORT</eg:databaseServer>
        <eg:databaseSystem>PostgreSQL</eg:databaseSystem>
        <eg:fileFormat>CSV, comma, decimal point. Two header lines with location metadata (latitude, longitude, elevation, UTC offset, time zone), an empty line, then column names. Uploaded to the EnergyGuard Data Lake as CSV.</eg:fileFormat>
        <eg:hasVariable rdf:resource="https://www.energyguard.eu/ontology/engreen#The_Weather_Dataset__cloud_cover"/>
        <eg:hasVariable rdf:resource="https://www.energyguard.eu/ontology/engreen#The_Weather_Dataset__diffuse_radiation_W_m2"/>
        <eg:hasVariable rdf:resource="https://www.energyguard.eu/ontology/engreen#The_Weather_Dataset__direct_normal_irradiance_W_m2"/>
        <eg:hasVariable rdf:resource="https://www.energyguard.eu/ontology/engreen#The_Weather_Dataset__shortwave_radiation_W_m2"/>
        <eg:hasVariable rdf:resource="https://www.energyguard.eu/ontology/engreen#The_Weather_Dataset__temperature_2m_C"/>
        <eg:hasVariable rdf:resource="https://www.energyguard.eu/ontology/engreen#The_Weather_Dataset__wind_speed_10m_km_h"/>
        <eg:licence>Open-Meteo data, CC BY 4.0 (attribution to Open-Meteo.com)</eg:licence>
        <eg:location>Antrodoco (RI), Italy, reference point 42.4253 N, 13.0837 E, 481 m a.s.l.</eg:location>
        <eg:missingValues>Empty cell = value not available</eg:missingValues>
        <eg:sourceSystem>Open-Meteo Historical Weather API (weather model data)</eg:sourceSystem>
        <eg:storedInDatabase>TEF7_ENGREEN</eg:storedInDatabase>
        <eg:storedInDatabaseTable>public.f_tsdata</eg:storedInDatabaseTable>
        <eg:systemDescribed>Local weather and solar radiation conditions</eg:systemDescribed>
        <eg:tableLayout>long</eg:tableLayout>
        <eg:temporalCoverage>2025-01-01 – 2025-12-31</eg:temporalCoverage>
        <eg:timeResolution>Hourly</eg:timeResolution>
        <eg:timeZone>Local time as returned by Open-Meteo; time zone and UTC offset are reported in the file header</eg:timeZone>
        <eg:updateFrequency>One-off historical export</eg:updateFrequency>
      </owl:NamedIndividual>
    </mp:hasDataset>
  </owl:Class>
