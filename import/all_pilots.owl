  <dcat:Dataset rdf:about="https://www.energyguard.eu/ontology/rdn/faults#Dataset_RDN_Faults_2025_10_29">
    <dcterms:description>Time-series export for RDN (ScopeView). Data values are externalized to a
  CSV; CSVW metadata provided in repo.</dcterms:description>
    <dcterms:hasPart>
      <rdnf:ScopeViewDevice rdf:about="https://www.energyguard.eu/ontology/rdn/faults#ScopeView_LCGRM1_1">
        <dcterms:creator>ScopeView</dcterms:creator>
        <dcterms:description>Recorder device instance created from LCGRM1_1_11_15_54.cfg</dcterms:description>
        <rdfs:label>ScopeView recorder LCGRM1_1</rdfs:label>
        <rdnf:hasConfiguration rdf:resource="https://www.energyguard.eu/data/LCGRM1_1_11_15_54.cfg"/>
      </rdnf:ScopeViewDevice>
    </dcterms:hasPart>
    <dcterms:title>RDN ScopeView Faults Dataset</dcterms:title>
    <rdf:type rdf:resource="https://www.energyguard.eu/ontology/rdn/faults#Dataset"/>
    <dcat:distribution>
      <rdf:Description rdf:nodeID="b1ecc29d144a12da3">
        <dcterms:format>text/csv</dcterms:format>
        <dcterms:hasFormat rdf:resource="https://www.energyguard.eu/data/rdn_scopeview_faults.csv-metadata.json"/>
        <dcat:downloadURL rdf:resource="https://www.energyguard.eu/data/rdn_scopeview_faults.csv"/>
      </rdf:Description>
    </dcat:distribution>
    <dcat:distribution>
      <rdf:Description rdf:nodeID="b2451d2e5a3fe52b3">
        <dcterms:description>Raw ScopeView ASCII capture (.dat)</dcterms:description>
        <dcterms:format>text/plain</dcterms:format>
        <dcat:downloadURL rdf:resource="https://www.energyguard.eu/data/LCGRM1_1_11_15_54.dat"/>
      </rdf:Description>
    </dcat:distribution>
    <dcat:distribution>
      <rdf:Description rdf:nodeID="bc1c3854875e1de13">
        <dcterms:description>ScopeView configuration file (.cfg) with channel order and calibration</dcterms:description>
        <dcterms:format>text/plain</dcterms:format>
        <dcat:downloadURL rdf:resource="https://www.energyguard.eu/data/LCGRM1_1_11_15_54.cfg"/>
      </rdf:Description>
    </dcat:distribution>
    <dcat:hasPart rdf:resource="https://www.energyguard.eu/ontology#Measurement"/>
  </dcat:Dataset>
