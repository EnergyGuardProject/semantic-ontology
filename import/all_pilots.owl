  <owl:ObjectProperty rdf:about="https://www.energyguard.eu/ontology/rea#hasEnergySystem">
    <rdfs:comment xml:lang="en">Links a building to its energy systems (heating, cooling, etc.). Aligned with SAREF.</rdfs:comment>
    <rdfs:domain rdf:resource="https://www.energyguard.eu/ontology/rea#Building"/>
    <rdfs:label xml:lang="en">has Energy System</rdfs:label>
    <rdfs:range rdf:resource="https://www.energyguard.eu/ontology/rea#EnergySystem"/>
    <rdfs:subPropertyOf rdf:resource="https://saref.etsi.org/core/hasFunction"/>
  </owl:ObjectProperty>
  <sosa:ObservationCollection rdf:about="https://www.energyguard.eu/ontology/ber#FlowMeasurementGroup">
    <rdf:type rdf:resource="https://www.energyguard.eu/ontology#FlowMeasurement"/>
    <eg:hasMeasurement>
      <owl:NamedIndividual rdf:about="https://www.energyguard.eu/ontology/ber#FT-H200">
        <dcterms:description xml:lang="en">Stack estimated H2 production</dcterms:description>
        <rdf:type rdf:resource="https://www.energyguard.eu/ontology#FlowMeasurement"/>
        <rdf:type rdf:resource="https://www.energyguard.eu/ontology#Variable"/>
        <rdfs:label xml:lang="en">FT-H200</rdfs:label>
        <eg:aggregation>instantaneous</eg:aggregation>
        <eg:dataLakeMatch>normalised</eg:dataLakeMatch>
        <eg:dataLakeSensorId>FT_H200</eg:dataLakeSensorId>
        <eg:dataType>float</eg:dataType>
        <eg:decimals>1</eg:decimals>
        <eg:hasUnit rdf:resource="http://qudt.org/vocab/unit/GM-PER-HR"/>
        <eg:maxValue>300</eg:maxValue>
        <eg:minValue>0.0</eg:minValue>
        <eg:recordThreshold>0.05</eg:recordThreshold>
        <eg:sampling>Over threshold (0.1s) or 30s</eg:sampling>
        <eg:subsystem>h2</eg:subsystem>
        <eg:unit>g/h</eg:unit>
        <eg:variableKind>calculated</eg:variableKind>
      </owl:NamedIndividual>
    </eg:hasMeasurement>
    <eg:hasMeasurement>
      <owl:NamedIndividual rdf:about="https://www.energyguard.eu/ontology/ber#FT-M200-1">
        <dcterms:description xml:lang="en">Drier left column calculated H2 flow</dcterms:description>
        <rdf:type rdf:resource="https://www.energyguard.eu/ontology#FlowMeasurement"/>
        <rdf:type rdf:resource="https://www.energyguard.eu/ontology#Variable"/>
        <rdfs:label xml:lang="en">FT-M200-1</rdfs:label>
        <eg:aggregation>instantaneous</eg:aggregation>
        <eg:dataLakeMatch>normalised</eg:dataLakeMatch>
        <eg:dataLakeSensorId>FT_M200_1</eg:dataLakeSensorId>
        <eg:dataType>float</eg:dataType>
        <eg:decimals>2</eg:decimals>
        <eg:hasUnit rdf:resource="http://qudt.org/vocab/unit/GM-PER-HR"/>
        <eg:maxValue>300</eg:maxValue>
        <eg:minValue>0.0</eg:minValue>
        <eg:recordThreshold>0.005</eg:recordThreshold>
        <eg:sampling>Over threshold (0.1s) or 30s</eg:sampling>
        <eg:subsystem>dryer</eg:subsystem>
        <eg:unit>g/h</eg:unit>
        <eg:variableKind>calculated</eg:variableKind>
      </owl:NamedIndividual>
    </eg:hasMeasurement>
    <eg:hasMeasurement>
      <owl:NamedIndividual rdf:about="https://www.energyguard.eu/ontology/ber#FT-M200-2">
        <dcterms:description xml:lang="en">Drier left column calculated H2O flow</dcterms:description>
        <rdf:type rdf:resource="https://www.energyguard.eu/ontology#FlowMeasurement"/>
        <rdf:type rdf:resource="https://www.energyguard.eu/ontology#Variable"/>
        <rdfs:label xml:lang="en">FT-M200-2</rdfs:label>
        <eg:aggregation>instantaneous</eg:aggregation>
        <eg:dataLakeMatch>normalised</eg:dataLakeMatch>
        <eg:dataLakeSensorId>FT_M200_2</eg:dataLakeSensorId>
        <eg:dataType>float</eg:dataType>
        <eg:decimals>3</eg:decimals>
        <eg:hasUnit rdf:resource="http://qudt.org/vocab/unit/GM-PER-HR"/>
        <eg:maxValue>100</eg:maxValue>
        <eg:minValue>0.0</eg:minValue>
        <eg:recordThreshold>0.0005</eg:recordThreshold>
        <eg:sampling>Over threshold (0.1s) or 30s</eg:sampling>
        <eg:subsystem>dryer</eg:subsystem>
        <eg:unit>g/h</eg:unit>
        <eg:variableKind>calculated</eg:variableKind>
      </owl:NamedIndividual>
    </eg:hasMeasurement>
    <eg:hasMeasurement>
      <owl:NamedIndividual rdf:about="https://www.energyguard.eu/ontology/ber#FT-M300-1">
        <dcterms:description xml:lang="en">Drier right column calculated H2 flow</dcterms:description>
        <rdf:type rdf:resource="https://www.energyguard.eu/ontology#FlowMeasurement"/>
        <rdf:type rdf:resource="https://www.energyguard.eu/ontology#Variable"/>
        <rdfs:label xml:lang="en">FT-M300-1</rdfs:label>
        <eg:aggregation>instantaneous</eg:aggregation>
        <eg:dataLakeMatch>normalised</eg:dataLakeMatch>
        <eg:dataLakeSensorId>FT_M300_1</eg:dataLakeSensorId>
        <eg:dataType>float</eg:dataType>
        <eg:decimals>2</eg:decimals>
        <eg:hasUnit rdf:resource="http://qudt.org/vocab/unit/GM-PER-HR"/>
        <eg:maxValue>300</eg:maxValue>
        <eg:minValue>0.0</eg:minValue>
        <eg:recordThreshold>0.005</eg:recordThreshold>
        <eg:sampling>Over threshold (0.1s) or 30s</eg:sampling>
        <eg:subsystem>dryer</eg:subsystem>
        <eg:unit>g/h</eg:unit>
        <eg:variableKind>calculated</eg:variableKind>
      </owl:NamedIndividual>
    </eg:hasMeasurement>
    <eg:hasMeasurement>
      <owl:NamedIndividual rdf:about="https://www.energyguard.eu/ontology/ber#FT-M300-2">
        <dcterms:description xml:lang="en">Drier right column calculated H2O flow</dcterms:description>
        <rdf:type rdf:resource="https://www.energyguard.eu/ontology#FlowMeasurement"/>
        <rdf:type rdf:resource="https://www.energyguard.eu/ontology#Variable"/>
        <rdfs:label xml:lang="en">FT-M300-2</rdfs:label>
        <eg:aggregation>instantaneous</eg:aggregation>
        <eg:dataLakeMatch>normalised</eg:dataLakeMatch>
