  <owl:NamedIndividual rdf:about="https://www.energyguard.eu/ontology/cartif#FuelCellGroup">
    <eg:hasMeasurement>
      <owl:NamedIndividual rdf:about="https://www.energyguard.eu/ontology/cartif#FC_Alarm">
        <dcterms:description xml:lang="en">Alarm signal for the fuel cell status</dcterms:description>
        <dcterms:description xml:lang="es">Señal de alarma en el estado de la pila de combustible</dcterms:description>
        <rdf:type rdf:resource="https://www.energyguard.eu/ontology#StateMeasurement"/>
        <rdf:type rdf:resource="https://www.energyguard.eu/ontology#Variable"/>
        <rdf:type rdf:resource="https://www.energyguard.eu/ontology/cartif#Alarm"/>
        <rdfs:label xml:lang="en">FC_Alarm</rdfs:label>
        <eg:aggregation>none</eg:aggregation>
        <eg:codeList>0 / 1</eg:codeList>
        <eg:dataLakeMatch>exact</eg:dataLakeMatch>
        <eg:dataLakeSensorId>FC_Alarm</eg:dataLakeSensorId>
        <eg:dataType>integer</eg:dataType>
        <eg:representsComponent rdf:resource="https://www.energyguard.eu/ontology/cartif#FuelCell"/>
        <eg:sensorId>FC_Alarm</eg:sensorId>
        <eg:sensorType>Status</eg:sensorType>
        <eg:subsystem>Fuel cell</eg:subsystem>
        <eg:validRange>0–1</eg:validRange>
        <eg:variableKind>alarm</eg:variableKind>
      </owl:NamedIndividual>
    </eg:hasMeasurement>
    <eg:hasMeasurement>
      <owl:NamedIndividual rdf:about="https://www.energyguard.eu/ontology/cartif#FC_Current">
        <dcterms:description xml:lang="en">Current measurement in the fuel cell</dcterms:description>
        <dcterms:description xml:lang="es">Medida de corriente en la pila de combustible</dcterms:description>
        <rdf:type rdf:resource="https://www.energyguard.eu/ontology#Variable"/>
        <rdf:type rdf:resource="https://www.energyguard.eu/ontology/cartif#ElectricalMeasurement"/>
        <rdfs:label xml:lang="en">FC_Current</rdfs:label>
        <eg:aggregation>none</eg:aggregation>
        <eg:dataLakeMatch>exact</eg:dataLakeMatch>
        <eg:dataLakeSensorId>FC_Current</eg:dataLakeSensorId>
        <eg:dataType>float</eg:dataType>
        <eg:hasUnit rdf:resource="http://qudt.org/vocab/unit/A"/>
        <eg:representsComponent rdf:resource="https://www.energyguard.eu/ontology/cartif#FuelCell"/>
        <eg:sensorId>FC_Current</eg:sensorId>
        <eg:sensorType>Fuel-cell monitoring signal</eg:sensorType>
        <eg:subsystem>Fuel cell</eg:subsystem>
        <eg:unit>A</eg:unit>
        <eg:variableKind>measured</eg:variableKind>
      </owl:NamedIndividual>
    </eg:hasMeasurement>
    <eg:hasMeasurement>
      <owl:NamedIndividual rdf:about="https://www.energyguard.eu/ontology/cartif#FC_State">
        <dcterms:description xml:lang="es">Estado de la pila de combustible</dcterms:description>
        <dcterms:description xml:lang="en">Fuel cell status</dcterms:description>
        <rdf:type rdf:resource="https://www.energyguard.eu/ontology#StateMeasurement"/>
        <rdf:type rdf:resource="https://www.energyguard.eu/ontology#Variable"/>
        <rdfs:label xml:lang="en">FC_State</rdfs:label>
        <eg:aggregation>none</eg:aggregation>
        <eg:codeList>0 = Off; 1 = On</eg:codeList>
        <eg:dataLakeMatch>exact</eg:dataLakeMatch>
        <eg:dataLakeSensorId>FC_State</eg:dataLakeSensorId>
        <eg:dataType>integer</eg:dataType>
        <eg:hasUnit rdf:resource="http://qudt.org/vocab/unit/KiloW"/>
        <eg:representsComponent rdf:resource="https://www.energyguard.eu/ontology/cartif#FuelCell"/>
        <eg:sensorId>FC_State</eg:sensorId>
        <eg:sensorType>PLC/Modbus input register 20 (source signal; physical sensor type not specified)</eg:sensorType>
        <eg:subsystem>Fuel cell</eg:subsystem>
        <eg:validRange>0, 1</eg:validRange>
        <eg:variableKind>state</eg:variableKind>
      </owl:NamedIndividual>
    </eg:hasMeasurement>
    <eg:hasMeasurement>
      <owl:NamedIndividual rdf:about="https://www.energyguard.eu/ontology/cartif#FC_Voltage">
        <dcterms:description xml:lang="en">Current measurement in the fuel cell</dcterms:description>
        <dcterms:description xml:lang="es">Medida de corriente en la pila de combustible</dcterms:description>
        <rdf:type rdf:resource="https://www.energyguard.eu/ontology#Variable"/>
        <rdf:type rdf:resource="https://www.energyguard.eu/ontology/cartif#ElectricalMeasurement"/>
        <rdfs:label xml:lang="en">FC_Voltage</rdfs:label>
        <eg:aggregation>none</eg:aggregation>
        <eg:dataLakeMatch>exact</eg:dataLakeMatch>
        <eg:dataLakeSensorId>FC_Voltage</eg:dataLakeSensorId>
        <eg:dataType>float</eg:dataType>
        <eg:hasUnit rdf:resource="http://qudt.org/vocab/unit/V"/>
        <eg:representsComponent rdf:resource="https://www.energyguard.eu/ontology/cartif#FuelCell"/>
        <eg:sensorId>FC_Voltage</eg:sensorId>
        <eg:sensorType>Fuel-cell monitoring signal</eg:sensorType>
        <eg:subsystem>Fuel cell</eg:subsystem>
        <eg:unit>V</eg:unit>
        <eg:variableKind>measured</eg:variableKind>
      </owl:NamedIndividual>
    </eg:hasMeasurement>
    <eg:hasMeasurement>
      <owl:NamedIndividual rdf:about="https://www.energyguard.eu/ontology/cartif#FC_War">
        <dcterms:description xml:lang="es">Señal de advertencia en el estado de la pila de combustible</dcterms:description>
        <dcterms:description xml:lang="en">Warning signal for the fuel cell status</dcterms:description>
        <rdf:type rdf:resource="https://www.energyguard.eu/ontology#StateMeasurement"/>
        <rdf:type rdf:resource="https://www.energyguard.eu/ontology#Variable"/>
        <rdf:type rdf:resource="https://www.energyguard.eu/ontology/cartif#Warning"/>
        <rdfs:label xml:lang="en">FC_War</rdfs:label>
        <eg:aggregation>none</eg:aggregation>
        <eg:codeList>0 / 1</eg:codeList>
        <eg:dataLakeMatch>exact</eg:dataLakeMatch>
        <eg:dataLakeSensorId>FC_War</eg:dataLakeSensorId>
        <eg:dataType>integer</eg:dataType>
        <eg:representsComponent rdf:resource="https://www.energyguard.eu/ontology/cartif#FuelCell"/>
        <eg:sensorId>FC_War</eg:sensorId>
        <eg:sensorType>Status</eg:sensorType>
        <eg:subsystem>Fuel cell</eg:subsystem>
        <eg:validRange>0–1</eg:validRange>
        <eg:variableKind>state</eg:variableKind>
      </owl:NamedIndividual>
    </eg:hasMeasurement>
    <eg:hasMeasurement>
      <owl:NamedIndividual rdf:about="https://www.energyguard.eu/ontology/cartif#FC_flow_Rate">
        <dcterms:description xml:lang="en">Flow rate measurement of H2 consumed by the fuel cell</dcterms:description>
        <dcterms:description xml:lang="es">Medida de flujo de H2 consumido en la pila de combustible</dcterms:description>
        <rdf:type rdf:resource="https://www.energyguard.eu/ontology#HydrogenMeasurement"/>
        <rdf:type rdf:resource="https://www.energyguard.eu/ontology#Variable"/>
        <rdfs:label xml:lang="en">FC_flow_Rate</rdfs:label>
        <eg:aggregation>none</eg:aggregation>
        <eg:dataLakeMatch>exact</eg:dataLakeMatch>
        <eg:dataLakeSensorId>FC_flow_Rate</eg:dataLakeSensorId>
        <eg:dataType>integer</eg:dataType>
        <eg:representsComponent rdf:resource="https://www.energyguard.eu/ontology/cartif#FuelCell"/>
        <eg:sensorId>FC_flow_Rate</eg:sensorId>
        <eg:sensorType>Fuel-cell monitoring signal</eg:sensorType>
        <eg:subsystem>Fuel cell</eg:subsystem>
        <eg:unit>NL/h</eg:unit>
        <eg:variableKind>measured</eg:variableKind>
      </owl:NamedIndividual>
    </eg:hasMeasurement>
  </owl:NamedIndividual>
