  <owl:NamedIndividual rdf:about="https://www.energyguard.eu/ontology/cartif#Dataset_CARTIF_hydrogen_test_bench_operational_data_15_s">
    <dcterms:description xml:lang="en">Original PLC/SCADA operational time-series export from the CARTIF hydrogen test bench, covering the hydrogen generation, storage and energy conversion equipment and associated monitoring and control signals. The dataset is provided for internal use within the EnergyGuard consortium.</dcterms:description>
    <dcterms:title xml:lang="en">CARTIF hydrogen test bench operational data (15 s)</dcterms:title>
    <rdf:type rdf:resource="http://www.w3.org/ns/dcat#Dataset"/>
    <rdfs:label xml:lang="en">CARTIF hydrogen test bench operational data (15 s)</rdfs:label>
    <eg:dataOwnerContact>CARTIF (no named contact)</eg:dataOwnerContact>
    <eg:databaseServer>REDACTED_HOST:REDACTED_PORT</eg:databaseServer>
    <eg:databaseSystem>PostgreSQL</eg:databaseSystem>
    <eg:fileFormat>CSV</eg:fileFormat>
    <eg:hasVariable rdf:resource="https://www.energyguard.eu/ontology/cartif#ALTA_PRESION_MH1_Alarm"/>
    <eg:hasVariable rdf:resource="https://www.energyguard.eu/ontology/cartif#ALTA_PRESION_MH2_Alarm"/>
