        <eg:hasUnit rdf:resource="http://qudt.org/vocab/unit/W"/>
        <eg:sensorId>Plant code</eg:sensorId>
        <eg:sensorType>Battery system (Deye inverter)</eg:sensorType>
        <eg:signConvention>+ = discharging; - = charging</eg:signConvention>
        <eg:sourceColumnName>Battery Power(W)</eg:sourceColumnName>
        <eg:subsystem>Battery</eg:subsystem>
        <eg:unit>W</eg:unit>
        <eg:validRange>limited by battery power rating</eg:validRange>
        <eg:variableKind>measured</eg:variableKind>
      </owl:NamedIndividual>
    </eg:hasVariable>
    <eg:hasVariable>
      <owl:NamedIndividual rdf:about="https://www.energyguard.eu/ontology/engreen#Operational_monitoring_dataset__Daily_energy_kWh">
        <dcterms:description xml:lang="en">Electrical energy produced by the PV inverter during the current day (reset at midnight)</dcterms:description>
