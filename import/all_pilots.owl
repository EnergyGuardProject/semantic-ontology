  </owl:Class>
  <owl:NamedIndividual rdf:about="https://www.energyguard.eu/ontology/rea#Building_and_heating_consumption_data_Heating_2017_2024_xlsx__02_2017">
    <dcterms:description xml:lang="en">Heat consumption (heating + hot water) for month</dcterms:description>
