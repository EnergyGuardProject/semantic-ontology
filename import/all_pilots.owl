    <eg:hasVariable rdf:resource="https://www.energyguard.eu/ontology/cartif#BAJA_TEMP_MH2_Alarm"/>
    <eg:hasVariable rdf:resource="https://www.energyguard.eu/ontology/cartif#BATA_Current"/>
    <eg:hasVariable rdf:resource="https://www.energyguard.eu/ontology/cartif#BATA_SOC"/>
    <eg:hasVariable rdf:resource="https://www.energyguard.eu/ontology/cartif#BATA_Voltage"/>
    <eg:hasVariable rdf:resource="https://www.energyguard.eu/ontology/cartif#BATB_Current"/>
    <eg:hasVariable rdf:resource="https://www.energyguard.eu/ontology/cartif#BATB_SOC"/>
    <eg:hasVariable rdf:resource="https://www.energyguard.eu/ontology/cartif#BATB_Voltage"/>
    <eg:hasVariable rdf:resource="https://www.energyguard.eu/ontology/cartif#BATERIAS_Alarm"/>
