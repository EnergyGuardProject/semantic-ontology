  </owl:NamedIndividual>
  <owl:NamedIndividual rdf:about="https://www.energyguard.eu/ontology/rea#Dataset_Building_and_heating_consumption_data_Heating_2017_2024_xlsx">
    <dcterms:description xml:lang="en">Monthly heat consumption (heating + hot water, MWh) for 7,033 buildings from 01.2017 to 12.2024, split into annual heating and hot water totals and 5-year averages, plus building characteristics (type, operating year, areas, apartments, floors, volume) and energy certificate info.</dcterms:description>
    <dcterms:title xml:lang="en">Building and heating consumption data - Heating 2017-2024.xlsx</dcterms:title>
    <rdf:type rdf:resource="http://www.w3.org/ns/dcat#Dataset"/>
    <rdfs:label xml:lang="en">Building and heating consumption data - Heating 2017-2024.xlsx</rdfs:label>
    <eg:hasVariable>
      <owl:NamedIndividual rdf:about="https://www.energyguard.eu/ontology/rea#Building_and_heating_consumption_data_Heating_2017_2024_xlsx__01_2017">
        <dcterms:description xml:lang="en">Heat consumption (heating + hot water) for month</dcterms:description>
        <rdf:type rdf:resource="https://www.energyguard.eu/ontology#Variable"/>
        <rdfs:label xml:lang="en">01.2017</rdfs:label>
        <eg:codeList>Methodology how heat consumption is divided between heating and hot water: Heat energy consumption in the building is recorded at the individual heating substation, where a heat meter registers the total amount of heat energy on a monthly basis, covering both space heating and domestic hot water preparation. As these consumptions are not measured separately, the allocation of heat energy is carried out by calculation. The heat energy used for domestic hot water preparation is determined based on the average heat consumption during the summer months, when space heating is not provided; the calculated average monthly consumption is multiplied by 12 to obtain the annual heat energy consumption for domestic hot water. The heat energy consumed for space heating is determined by subtracting the calculated domestic hot water heat energy from the total heat energy recorded at the heating substation.</eg:codeList>
        <eg:dataLakeMatch>none</eg:dataLakeMatch>
        <eg:hasUnit rdf:resource="http://qudt.org/vocab/unit/MegaW-HR"/>
        <eg:unit>MWH</eg:unit>
      </owl:NamedIndividual>
    </eg:hasVariable>
    <eg:hasVariable rdf:resource="https://www.energyguard.eu/ontology/rea#Building_and_heating_consumption_data_Heating_2017_2024_xlsx__01_2018"/>
    <eg:hasVariable>
