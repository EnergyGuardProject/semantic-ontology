    <rdf:type rdf:resource="https://www.energyguard.eu/ontology#Variable"/>
    <rdfs:label xml:lang="en">AS-Z126</rdfs:label>
    <eg:aggregation>instantaneous</eg:aggregation>
    <eg:dataLakeMatch>normalised</eg:dataLakeMatch>
    <eg:dataLakeSensorId>AS_Z126</eg:dataLakeSensorId>
    <eg:dataType>boolean</eg:dataType>
    <eg:recordThreshold>change</eg:recordThreshold>
    <eg:sampling>Over threshold (0.1s) or 30s</eg:sampling>
    <eg:subsystem>system</eg:subsystem>
    <eg:variableKind>measured</eg:variableKind>
  </owl:NamedIndividual>
  <owl:NamedIndividual rdf:about="https://www.energyguard.eu/ontology/ber#IT_3201">
    <dcterms:description xml:lang="en">L2 Current</dcterms:description>
    <rdf:type rdf:resource="https://www.energyguard.eu/ontology#CurrentMeasurement"/>
    <rdf:type rdf:resource="https://www.energyguard.eu/ontology#Variable"/>
    <rdfs:label xml:lang="en">IT-3201</rdfs:label>
    <eg:aggregation>instantaneous</eg:aggregation>
    <eg:dataLakeMatch>normalised</eg:dataLakeMatch>
    <eg:dataLakeSensorId>IT_3201</eg:dataLakeSensorId>
    <eg:dataType>float</eg:dataType>
    <eg:decimals>2</eg:decimals>
    <eg:hasUnit rdf:resource="http://qudt.org/vocab/unit/A"/>
    <eg:maxValue>30</eg:maxValue>
    <eg:minValue>0.0</eg:minValue>
    <eg:recordThreshold>0.005</eg:recordThreshold>
    <eg:sampling>Over threshold (0.1s) or 30s</eg:sampling>
    <eg:subsystem>power</eg:subsystem>
    <eg:unit>A</eg:unit>
    <eg:variableKind>measured</eg:variableKind>
  </owl:NamedIndividual>
  <owl:NamedIndividual rdf:about="https://www.energyguard.eu/ontology/cartif#BATB_SOC">
    <dcterms:description xml:lang="es">Estado de carga en la batería eléctrica B</dcterms:description>
    <dcterms:description xml:lang="en">State of charge of electrical battery B</dcterms:description>
    <rdf:type rdf:resource="https://www.energyguard.eu/ontology#Variable"/>
    <rdf:type rdf:resource="https://www.energyguard.eu/ontology/cartif#ElectricalMeasurement"/>
    <rdfs:label xml:lang="en">BATB_SOC</rdfs:label>
    <eg:aggregation>none</eg:aggregation>
    <eg:dataLakeMatch>exact</eg:dataLakeMatch>
    <eg:dataLakeSensorId>BATB_SOC</eg:dataLakeSensorId>
    <eg:dataType>integer</eg:dataType>
    <eg:hasUnit rdf:resource="http://qudt.org/vocab/unit/PERCENT"/>
    <eg:representsComponent rdf:resource="https://www.energyguard.eu/ontology#Battery"/>
    <eg:sensorId>BATB_SOC</eg:sensorId>
    <eg:sensorType>Battery monitoring signal</eg:sensorType>
    <eg:subsystem>Battery</eg:subsystem>
    <eg:unit>%</eg:unit>
    <eg:validRange>0–100 %</eg:validRange>
    <eg:variableKind>measured</eg:variableKind>
  </owl:NamedIndividual>
  <owl:NamedIndividual rdf:about="https://www.energyguard.eu/ontology/rea#Energy_performance_of_renovated_buildings__renov_izma">
    <dcterms:description xml:lang="en">Cost of renovation, that payed owner of the flat (accordingly to flat area)</dcterms:description>
    <rdf:type rdf:resource="https://www.energyguard.eu/ontology#Variable"/>
    <rdfs:label xml:lang="en">costs_for_flat</rdfs:label>
    <eg:dataLakeMatch>column</eg:dataLakeMatch>
    <eg:sourceColumnName>renov_izma</eg:sourceColumnName>
    <eg:storedInDatabaseColumn>renov_izma</eg:storedInDatabaseColumn>
    <eg:unit>EUR/m2</eg:unit>
  </owl:NamedIndividual>
  <owl:NamedIndividual rdf:about="https://www.energyguard.eu/ontology/rea#Building_and_heating_consumption_data_Heating_2017_2024_xlsx__10_2018">
    <dcterms:description xml:lang="en">Heat consumption (heating + hot water) for month</dcterms:description>
    <rdf:type rdf:resource="https://www.energyguard.eu/ontology#Variable"/>
    <rdfs:label xml:lang="en">10.2018</rdfs:label>
    <eg:dataLakeMatch>none</eg:dataLakeMatch>
    <eg:hasUnit rdf:resource="http://qudt.org/vocab/unit/MegaW-HR"/>
    <eg:unit>MWH</eg:unit>
  </owl:NamedIndividual>
  <owl:NamedIndividual rdf:about="https://www.energyguard.eu/ontology/engreen#Dataset_Shelly_consumer_monitoring_dataset">
    <dcterms:description xml:lang="en">Electricity consumption and voltage data from Shelly energy meters installed by ENGREEN at five residential consumers of the REC, as a representative sample of demand-side behaviour. It complements the hourly GSE data with higher-resolution measurements and supports load-profile analysis, Digital Twin validation and demand-side modelling.</dcterms:description>
    <dcterms:title xml:lang="en">Shelly consumer monitoring dataset</dcterms:title>
    <rdf:type rdf:resource="http://www.w3.org/ns/dcat#Dataset"/>
    <rdfs:label xml:lang="en">Shelly consumer monitoring dataset</rdfs:label>
    <eg:dataOwnerContact>Data controller: C.E.R.A. (Comunità Energetica Rinnovabile Antrodoco). Data processor and contact: ENGREEN, REDACTED_NAME, REDACTED_EMAIL</eg:dataOwnerContact>
    <eg:databaseServer>REDACTED_HOST:REDACTED_PORT</eg:databaseServer>
    <eg:databaseSystem>PostgreSQL</eg:databaseSystem>
    <eg:fileFormat><![CDATA[CSV exported from Shelly Cloud, one file per meter and variable group: one block per variable (title row, header row 'Ore, <unit>'), comma separator, decimal point, timestamps dd/mm/yyyy hh:mm. Uploaded to the EnergyGuard Data Lake as CSV.]]></eg:fileFormat>
    <eg:hasVariable>
      <owl:NamedIndividual rdf:about="https://www.energyguard.eu/ontology/engreen#Shelly_consumer_monitoring_dataset__Consumo">
        <dcterms:description xml:lang="en">Energy consumed during the interval</dcterms:description>
        <rdf:type rdf:resource="https://www.energyguard.eu/ontology#EnergyMeasurement"/>
        <rdf:type rdf:resource="https://www.energyguard.eu/ontology#Variable"/>
        <rdfs:label xml:lang="en">Consumption</rdfs:label>
        <eg:aggregation>sum</eg:aggregation>
        <eg:aggregationNote>sum over the interval</eg:aggregationNote>
        <eg:dataLakeMatch>pattern</eg:dataLakeMatch>
        <eg:dataLakeSensorPattern>%\_total\_act\_energy</eg:dataLakeSensorPattern>
        <eg:dataType>float</eg:dataType>
        <eg:hasUnit rdf:resource="http://qudt.org/vocab/unit/W-HR"/>
        <eg:sensorId>Pseudonymised meter code</eg:sensorId>
        <eg:sensorType>Energy meter (Shelly)</eg:sensorType>
        <eg:sourceColumnName>Consumo</eg:sourceColumnName>
        <eg:subsystem>Household connection point</eg:subsystem>
        <eg:unit>Wh</eg:unit>
        <eg:validRange>≥ 0</eg:validRange>
        <eg:variableKind>measured</eg:variableKind>
      </owl:NamedIndividual>
    </eg:hasVariable>
    <eg:hasVariable>
      <owl:NamedIndividual rdf:about="https://www.energyguard.eu/ontology/engreen#Shelly_consumer_monitoring_dataset__Voltaggio_minimo">
        <dcterms:description xml:lang="en">Instantaneous voltage measured by the meter (channel 0) at the timestamp of the record</dcterms:description>
        <rdf:type rdf:resource="https://www.energyguard.eu/ontology#Variable"/>
        <rdf:type rdf:resource="https://www.energyguard.eu/ontology#VoltageMeasurement"/>
        <rdfs:label xml:lang="en">Voltage</rdfs:label>
        <eg:aggregation>instantaneous</eg:aggregation>
        <eg:dataLakeMatch>pattern</eg:dataLakeMatch>
        <eg:dataLakeSensorPattern>%\_voltage</eg:dataLakeSensorPattern>
        <eg:dataType>float</eg:dataType>
        <eg:hasUnit rdf:resource="http://qudt.org/vocab/unit/V"/>
        <eg:sensorId>Pseudonymised meter code</eg:sensorId>
        <eg:sensorType>Energy meter (Shelly)</eg:sensorType>
        <eg:sourceColumnName>Voltaggio minimo</eg:sourceColumnName>
        <eg:subsystem>Household connection point</eg:subsystem>
        <eg:unit>V</eg:unit>
        <eg:validRange>about 180 – 250</eg:validRange>
        <eg:variableKind>measured</eg:variableKind>
      </owl:NamedIndividual>
    </eg:hasVariable>
    <eg:hasVariable>
      <owl:NamedIndividual rdf:about="https://www.energyguard.eu/ontology/engreen#Shelly_consumer_monitoring_dataset__collectTime">
        <dcterms:description xml:lang="en">Timestamp of the hourly interval in UTC, referring to the end of the interval</dcterms:description>
        <rdf:type rdf:resource="https://www.energyguard.eu/ontology#Variable"/>
        <rdfs:label xml:lang="en">Date / Hour</rdfs:label>
        <eg:dataLakeMatch>timestamp</eg:dataLakeMatch>
        <eg:dataType>datetime</eg:dataType>
        <eg:sourceColumnName>collectTime</eg:sourceColumnName>
        <eg:storedInDatabaseColumn>public.d_calendar.datetime</eg:storedInDatabaseColumn>
      </owl:NamedIndividual>
    </eg:hasVariable>
