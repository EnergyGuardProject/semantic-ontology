  <owl:DatatypeProperty rdf:about="https://www.energyguard.eu/ontology/rea#groundFloors">
    <rdfs:comment xml:lang="en">Number of ground-level floors (BuildingGroundFloors)</rdfs:comment>
    <rdfs:domain rdf:resource="https://www.energyguard.eu/ontology/rea#Building"/>
    <rdfs:label xml:lang="en">ground Floors</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
  </owl:DatatypeProperty>
  <owl:Class rdf:about="https://www.energyguard.eu/ontology/rea#Organization">
    <rdfs:comment xml:lang="en">Building owner, manager, or facility operator. Aligned with FOAF:Organization.</rdfs:comment>
    <rdfs:label xml:lang="en">Organization</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://xmlns.com/foaf/0.1/Organization"/>
  </owl:Class>
  <owl:DatatypeProperty rdf:about="https://www.energyguard.eu/ontology#variableKind">
    <rdfs:comment xml:lang="en">measured | calculated | setpoint | state | alarm | output | static | modelled | … (lower case).</rdfs:comment>
    <rdfs:label xml:lang="en">variable kind</rdfs:label>
  </owl:DatatypeProperty>
  <owl:ObjectProperty rdf:about="https://www.energyguard.eu/ontology/rea#hasGeometry">
