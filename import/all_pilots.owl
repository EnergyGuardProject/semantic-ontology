  <owl:NamedIndividual rdf:about="https://www.energyguard.eu/ontology/engreen#The_GSE_Historical_Metering_Dataset__kWh">
    <dcterms:description xml:lang="en">Energy measured during the hourly interval: grid withdrawal, grid injection or energy production depending on the file</dcterms:description>
    <rdf:type rdf:resource="https://www.energyguard.eu/ontology#Variable"/>
    <rdfs:label xml:lang="en">Energy value</rdfs:label>
    <eg:aggregation>sum</eg:aggregation>
    <eg:aggregationNote>hourly sum</eg:aggregationNote>
    <eg:dataLakeMatch>none</eg:dataLakeMatch>
    <eg:dataType>float</eg:dataType>
    <eg:hasUnit rdf:resource="http://qudt.org/vocab/unit/KiloW-HR"/>
    <eg:sensorId>Pseudonymised measurement code</eg:sensorId>
    <eg:sensorType>Fiscal energy meter (DSO)</eg:sensorType>
    <eg:signConvention>always positive; the flow direction is given by the file</eg:signConvention>
    <eg:sourceColumnName>kWh</eg:sourceColumnName>
    <eg:subsystem>Metering point / production unit</eg:subsystem>
    <eg:unit>kWh</eg:unit>
    <eg:validRange>≥ 0</eg:validRange>
    <eg:variableKind>measured</eg:variableKind>
  </owl:NamedIndividual>
