    <rdfs:label xml:lang="en">sensor id</rdfs:label>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://www.energyguard.eu/ontology#unitUCUM">
    <rdfs:label xml:lang="en">unit u c u m</rdfs:label>
  </owl:DatatypeProperty>
  <owl:NamedIndividual rdf:about="https://www.energyguard.eu/ontology/ber#AS_Z126">
    <dcterms:description xml:lang="en">8FU8 Cooling Circulation Pump</dcterms:description>
