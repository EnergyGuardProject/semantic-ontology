    <eg:hasUnit rdf:resource="http://qudt.org/vocab/unit/PERCENT"/>
    <eg:sensorType>Weather model</eg:sensorType>
    <eg:sourceColumnName>cloud_cover (%)</eg:sourceColumnName>
    <eg:subsystem>Weather</eg:subsystem>
    <eg:unit>%</eg:unit>
    <eg:validRange>0 – 100</eg:validRange>
    <eg:variableKind>modelled</eg:variableKind>
  </owl:NamedIndividual>
