    <rdnf:hasIEC61850Type rdf:resource="https://www.energyguard.eu/ontology/rdn/faults#PhaseVoltageDA"/>
  </owl:DatatypeProperty>
  <owl:ObjectProperty rdf:about="https://www.energyguard.eu/ontology/merged-pilots#hasPilot">
    <rdfs:domain rdf:resource="https://www.energyguard.eu/ontology/merged-pilots#Pilots"/>
    <rdfs:range rdf:resource="https://www.energyguard.eu/ontology/merged-pilots#Pilot"/>
  </owl:ObjectProperty>
