<?xml version="1.0"?>
<rdf:RDF xmlns="http://www.energyguard.eu/ontology/pilot1_ts#"
     xml:base="http://www.energyguard.eu/ontology/pilot1_ts"
     xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
     xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
     xmlns:owl="http://www.w3.org/2002/07/owl#"
     xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
     xmlns:saref="https://saref.etsi.org/core/"
    xmlns:s4ener="https://saref.etsi.org/saref4ener/"
    xmlns:sosa="http://www.w3.org/ns/sosa/"
    xmlns:qb="http://purl.org/linked-data/cube#"
    xmlns:dcat="http://www.w3.org/ns/dcat#"
    xmlns:dct="http://purl.org/dc/terms/">

    <!-- Ontology Header -->
    <owl:Ontology rdf:about="http://www.energyguard.eu/ontology/pilot1_ts">
        <rdfs:label>EGuard Pilot 1 Time Series Ontology</rdfs:label>
        <rdfs:comment>Ontology for Substation XII dataset with combined measurements per timestamp, using standard ontologies for alignment.</rdfs:comment>
        <owl:versionInfo>2.1 - Standardized class/property mapping</owl:versionInfo>
        <owl:imports rdf:resource="https://saref.etsi.org/core/"/>
        <owl:imports rdf:resource="https://saref.etsi.org/saref4ener/"/>
        <owl:imports rdf:resource="http://www.w3.org/ns/sosa/"/>
    </owl:Ontology>

    <!-- Classes -->
    <owl:Class rdf:about="#Dataset">
        <rdfs:subClassOf rdf:resource="https://saref.etsi.org/saref4ener/PowerProfile"/>
        <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/sosa/ObservationCollection"/>
        <rdfs:label>Dataset</rdfs:label>
        <rdfs:comment>A collection of time-ordered measurements for a substation.</rdfs:comment>
    </owl:Class>

    <owl:Class rdf:about="#Substation">
        <rdfs:subClassOf rdf:resource="https://saref.etsi.org/core/Device"/>
        <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/sosa/FeatureOfInterest"/>
        <rdfs:label>Substation</rdfs:label>
        <rdfs:comment>An electrical substation, feature of interest for measurements.</rdfs:comment>
    </owl:Class>

    <!-- Resolution properties for Substation -->
    <owl:DatatypeProperty rdf:about="#hasTemporalResolution">
        <rdfs:domain rdf:resource="#Substation"/>
        <rdfs:range rdf:resource="xsd:duration"/>
        <rdfs:label>temporal resolution</rdfs:label>
        <rdfs:comment>Sampling interval or temporal resolution related to measurements from this substation (xsd:duration, e.g., PT15M for 15 minutes).</rdfs:comment>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="#hasSpatialResolution">
        <rdfs:domain rdf:resource="#Substation"/>
        <rdfs:range rdf:resource="xsd:string"/>
        <rdfs:label>spatial resolution</rdfs:label>
        <rdfs:comment>Spatial resolution or location granularity for the substation measurements (e.g., "substation", "feeder", or numeric distance unit). Use a string for flexible descriptions; can be replaced by more specific units later.</rdfs:comment>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="#hasMeasurementResolution">
        <rdfs:domain rdf:resource="#Substation"/>
        <rdfs:range rdf:resource="xsd:float"/>
        <rdfs:label>measurement resolution</rdfs:label>
        <rdfs:comment>Numeric resolution of the measured values (e.g., smallest resolvable power increment in kW). If units are required, consider pairing with a unit property or QUDT representation.</rdfs:comment>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="#startTime">
        <rdfs:domain rdf:resource="#Dataset"/>
        <rdfs:range rdf:resource="xsd:dateTime"/>
        <rdfs:label>start time</rdfs:label>
        <rdfs:comment>The beginning timestamp of the dataset observation period.</rdfs:comment>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="#endTime">
        <rdfs:domain rdf:resource="#Dataset"/>
        <rdfs:range rdf:resource="xsd:dateTime"/>
        <rdfs:label>end time</rdfs:label>
        <rdfs:comment>The ending timestamp of the dataset observation period.</rdfs:comment>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="#filename">
        <rdfs:domain rdf:resource="#Dataset"/>
        <rdfs:range rdf:resource="xsd:string"/>
        <rdfs:label>filename</rdfs:label>
        <rdfs:comment>The source CSV file name for this dataset.</rdfs:comment>
    </owl:DatatypeProperty>

    <!-- Object Properties -->
    <owl:ObjectProperty rdf:about="#representsSubstation">
        <rdfs:domain rdf:resource="#Dataset"/>
        <rdfs:range rdf:resource="#Substation"/>
        <rdfs:label>represents substation</rdfs:label>
        <rdfs:comment>Links a dataset to the substation it represents.</rdfs:comment>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="#partOfDataset">
        <rdfs:domain rdf:resource="http://www.w3.org/ns/sosa/Observation"/>
        <rdfs:range rdf:resource="#Dataset"/>
        <rdfs:label>part of dataset</rdfs:label>
        <rdfs:comment>Links an observation to the dataset it belongs to (used by CSVW/instances).</rdfs:comment>
    </owl:ObjectProperty>

    <!-- Data Cube: DSD and measure definitions so CSV columns can be treated as time-series -->
    <qb:DataStructureDefinition rdf:about="#DSD_Substation_XII">
        <qb:component>
            <qb:Component>
                <qb:dimension rdf:resource="#time"/>
            </qb:Component>
        </qb:component>
        <qb:component>
            <qb:Component>
                <qb:measure rdf:resource="#windMeasure"/>
            </qb:Component>
        </qb:component>
        <qb:component>
            <qb:Component>
                <qb:measure rdf:resource="#solarMeasure"/>
            </qb:Component>
        </qb:component>
        <qb:component>
            <qb:Component>
                <qb:measure rdf:resource="#netLoadMeasure"/>
            </qb:Component>
        </qb:component>
    </qb:DataStructureDefinition>

    <!-- MeasurementType: represents properties and units for each time-series (wind/solar/netload) -->
    <owl:Class rdf:about="#MeasurementType">
        <rdfs:subClassOf rdf:resource="https://saref.etsi.org/saref4ener/PowerValueType"/>
        <rdfs:label>MeasurementType</rdfs:label>
        <rdfs:comment>Represents a measurement type for a time series: includes unit and a link to the cube measure property used for the series.</rdfs:comment>
    </owl:Class>

    <owl:DatatypeProperty rdf:about="#unitOfMeasure">
        <rdfs:domain rdf:resource="#MeasurementType"/>
        <rdfs:range rdf:resource="xsd:string"/>
        <rdfs:label>unit of measure</rdfs:label>
        <rdfs:comment>Unit used for measurements (e.g., kW). Consider replacing with qudt:unit for stronger typing.</rdfs:comment>
    </owl:DatatypeProperty>

    <owl:ObjectProperty rdf:about="#representsMeasure">
        <rdfs:domain rdf:resource="#MeasurementType"/>
        <rdfs:range rdf:resource="http://purl.org/linked-data/cube#MeasureProperty"/>
        <rdfs:label>represents measure</rdfs:label>
        <rdfs:comment>Links a MeasurementType to the corresponding qb:MeasureProperty used in the Data Structure Definition.</rdfs:comment>
    </owl:ObjectProperty>

    <!-- Per-series MeasurementType instances: each series has a MeasurementType with unit and representsMeasure -->
    <MeasurementType rdf:about="#WindMeasureType">
        <rdfs:label>Wind measurement type (kW)</rdfs:label>
        <unitOfMeasure rdf:datatype="xsd:string">kW</unitOfMeasure>
        <representsMeasure rdf:resource="#windMeasure"/>
    </MeasurementType>

    <MeasurementType rdf:about="#SolarMeasureType">
        <rdfs:label>Solar measurement type (kW)</rdfs:label>
        <unitOfMeasure rdf:datatype="xsd:string">kW</unitOfMeasure>
        <representsMeasure rdf:resource="#solarMeasure"/>
    </MeasurementType>

    <MeasurementType rdf:about="#NetLoadMeasureType">
        <rdfs:label>Net load measurement type (kW)</rdfs:label>
        <unitOfMeasure rdf:datatype="xsd:string">kW</unitOfMeasure>
        <representsMeasure rdf:resource="#netLoadMeasure"/>
    </MeasurementType>

    <!-- Cube properties: time dimension + measure properties mapped to existing measurement properties -->
    <owl:DatatypeProperty rdf:about="#time">
        <rdfs:subPropertyOf rdf:resource="#hasTimestamp"/>
        <rdfs:range rdf:resource="xsd:dateTime"/>
        <rdfs:label>time</rdfs:label>
    </owl:DatatypeProperty>

    <!-- Define cube measure properties and link them to the ontology measurement properties -->
    <rdf:Property rdf:about="#windMeasure">
        <rdf:type rdf:resource="http://purl.org/linked-data/cube#MeasureProperty"/>
        <rdfs:subPropertyOf rdf:resource="#hasWindValue"/>
        <rdfs:label>wind measure</rdfs:label>
        <rdfs:comment>Measure property used in the Data Cube DSD for wind generation column.</rdfs:comment>
    </rdf:Property>

    <rdf:Property rdf:about="#solarMeasure">
        <rdf:type rdf:resource="http://purl.org/linked-data/cube#MeasureProperty"/>
        <rdfs:subPropertyOf rdf:resource="#hasSolarValue"/>
        <rdfs:label>solar measure</rdfs:label>
        <rdfs:comment>Measure property used in the Data Cube DSD for solar generation column.</rdfs:comment>
    </rdf:Property>

    <rdf:Property rdf:about="#netLoadMeasure">
        <rdf:type rdf:resource="http://purl.org/linked-data/cube#MeasureProperty"/>
        <rdfs:subPropertyOf rdf:resource="#hasNetLoadValue"/>
        <rdfs:label>net load measure</rdfs:label>
        <rdfs:comment>Measure property used in the Data Cube DSD for net load column.</rdfs:comment>
    </rdf:Property>

    <!-- Individuals -->
    <Substation rdf:about="#Substation_XII">
        <rdfs:label>Substation XII</rdfs:label>
        <rdfs:comment>Substation XII monitoring station with renewable energy generation</rdfs:comment>
    </Substation>

    <Dataset rdf:about="#Dataset_XII_2023_01_01">
        <rdf:type rdf:resource="dcat:Dataset"/>
        <filename rdf:datatype="xsd:string">Substation_XII_2023-01-01.csv</filename>
        <startTime rdf:datatype="xsd:dateTime">2023-01-01T00:00:00</startTime>
        <endTime rdf:datatype="xsd:dateTime">2023-01-01T03:45:00</endTime>
        <representsSubstation rdf:resource="#Substation_XII"/>
        <dct:hasPart rdf:resource="#WindSeries"/>
        <dct:hasPart rdf:resource="#SolarSeries"/>
        <dct:hasPart rdf:resource="#NetLoadSeries"/>
        <dcat:distribution>
            <dcat:Distribution>
                <dcat:downloadURL rdf:resource="./data/Substation_XII_2023-01-01.csv"/>
                <dcat:mediaType>text/csv</dcat:mediaType>
                <dct:hasFormat rdf:resource="./data/Substation_XII_2023-01-01.csv-metadata.json"/>
            </dcat:Distribution>
        </dcat:distribution>
    </Dataset>

    <!-- Time series as datasets (one dataset per CSV, one qb:DataSet per column/series) -->
    <qb:DataSet rdf:about="#WindSeries">
        <rdfs:label>Wind generation time series - Substation XII</rdfs:label>
        <dct:hasPart rdf:resource="#Dataset_XII_2023_01_01"/>
        <qb:structure rdf:resource="#DSD_Substation_XII"/>
    <s4ener:hasPowerValueType rdf:resource="#WindMeasureType"/>
        <dcat:distribution>
            <dcat:Distribution>
                <dcat:downloadURL rdf:resource="./data/Substation_XII_2023-01-01.csv"/>
                <dcat:mediaType>text/csv</dcat:mediaType>
                <dct:hasFormat rdf:resource="./data/Substation_XII_2023-01-01.csv-metadata.json"/>
            </dcat:Distribution>
        </dcat:distribution>
    </qb:DataSet>

    <qb:DataSet rdf:about="#SolarSeries">
        <rdfs:label>Solar generation time series - Substation XII</rdfs:label>
        <dct:hasPart rdf:resource="#Dataset_XII_2023_01_01"/>
        <qb:structure rdf:resource="#DSD_Substation_XII"/>
    <s4ener:hasPowerValueType rdf:resource="#SolarMeasureType"/>
        <dcat:distribution>
            <dcat:Distribution>
                <dcat:downloadURL rdf:resource="./data/Substation_XII_2023-01-01.csv"/>
                <dcat:mediaType>text/csv</dcat:mediaType>
                <dct:hasFormat rdf:resource="./data/Substation_XII_2023-01-01.csv-metadata.json"/>
            </dcat:Distribution>
        </dcat:distribution>
    </qb:DataSet>

    <qb:DataSet rdf:about="#NetLoadSeries">
        <rdfs:label>Net load time series - Substation XII</rdfs:label>
        <dct:hasPart rdf:resource="#Dataset_XII_2023_01_01"/>
        <qb:structure rdf:resource="#DSD_Substation_XII"/>
    <s4ener:hasPowerValueType rdf:resource="#NetLoadMeasureType"/>
        <dcat:distribution>
            <dcat:Distribution>
                <dcat:downloadURL rdf:resource="./data/Substation_XII_2023-01-01.csv"/>
                <dcat:mediaType>text/csv</dcat:mediaType>
                <dct:hasFormat rdf:resource="./data/Substation_XII_2023-01-01.csv-metadata.json"/>
            </dcat:Distribution>
        </dcat:distribution>
    </qb:DataSet>

</rdf:RDF>
