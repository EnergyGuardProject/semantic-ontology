    <owl:Ontology rdf:about="http://www.energyguard.eu/ontology/ber/v3">
        <rdfs:label>BER Pilot 3 Ontology (Refactored v3)</rdfs:label>
        <rdfs:comment>v3: dataset and measurement individuals explicitly reference their owning SystemComponent via eg:representsComponent. Converted from ontology_v2/pilot3_ber_refactored.owl (sample conversion).</rdfs:comment>
        <owl:versionInfo>3.0.0-refactored</owl:versionInfo>
        <owl:imports rdf:resource="https://saref.etsi.org/core/v4.1.1/" />
        <owl:imports rdf:resource="https://saref.etsi.org/saref4ener/v2.1.1/" />
        <owl:imports rdf:resource="http://www.w3.org/ns/sosa/" />
        <owl:imports rdf:resource="http://qudt.org/schema/qudt/" />
        <owl:imports rdf:resource="http://www.w3.org/ns/dcat#" />
        
        <owl:imports rdf:resource="../ontology_v2/pilot3_ber_refactored.owl" />
    </owl:Ontology>

    <owl:Class rdf:about="eg:Measurement">
        <rdfs:subClassOf rdf:resource="sosa:Observation" />
    </owl:Class>

    <owl:Class rdf:about="eg:TemperatureMeasurement">
        <rdfs:subClassOf rdf:resource="eg:Measurement" />
    </owl:Class>
    <owl:Class rdf:about="eg:PressureMeasurement">
        <rdfs:subClassOf rdf:resource="eg:Measurement" />
    </owl:Class>
    <owl:Class rdf:about="eg:FlowMeasurement">
        <rdfs:subClassOf rdf:resource="eg:Measurement" />
    </owl:Class>
    <owl:Class rdf:about="eg:LevelMeasurement">
        <rdfs:subClassOf rdf:resource="eg:Measurement" />
    </owl:Class>
    <owl:Class rdf:about="eg:CompositionMeasurement">
        <rdfs:subClassOf rdf:resource="eg:Measurement" />
    </owl:Class>
    <owl:Class rdf:about="eg:VoltageMeasurement">
        <rdfs:subClassOf rdf:resource="eg:Measurement" />
    </owl:Class>
    <owl:Class rdf:about="eg:CurrentMeasurement">
        <rdfs:subClassOf rdf:resource="eg:Measurement" />
    </owl:Class>
    <owl:Class rdf:about="eg:PowerMeasurement">
        <rdfs:subClassOf rdf:resource="eg:Measurement" />
    </owl:Class>
    <owl:Class rdf:about="eg:PowerQualityMeasurement">
        <rdfs:subClassOf rdf:resource="eg:Measurement" />
    </owl:Class>
    <owl:Class rdf:about="eg:ControlSignalMeasurement">
        <rdfs:subClassOf rdf:resource="eg:Measurement" />
    </owl:Class>
    <owl:Class rdf:about="eg:TimerMeasurement">
        <rdfs:subClassOf rdf:resource="eg:Measurement" />
    </owl:Class>
    <owl:Class rdf:about="eg:StateMeasurement">
        <rdfs:subClassOf rdf:resource="eg:Measurement" />
    </owl:Class>

    <owl:ObjectProperty rdf:about="eg:hasMeasurement">
        <rdfs:domain rdf:resource="eg:SystemComponent" />
        <rdfs:range rdf:resource="eg:Measurement" />
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="eg:isPartOfComponent">
        <rdfs:domain rdf:resource="eg:Measurement" />
        <rdfs:range rdf:resource="eg:SystemComponent" />
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="eg:representsMeasurement">
        <rdfs:domain rdf:resource="dcat:Dataset" />
        <rdfs:range rdf:resource="eg:Measurement" />
    </owl:ObjectProperty>

    
    <ns3:Dataset rdf:about="eg:BER_Dataset_2025_10_15">
        <ns3:title>BER System 2025-10-15</ns3:title>
        <ns3:mediaType>text/csv</ns3:mediaType>
        <eg:startTime rdf:datatype="xsd:dateTime">2025-10-15T00:00:00+00:00</eg:startTime>
        <eg:endTime rdf:datatype="xsd:dateTime">2025-10-15T23:59:59+00:00</eg:endTime>
        <eg:sampleRate rdf:datatype="xsd:float">1.0</eg:sampleRate>
        
        <eg:representsMeasurement rdf:resource="#TemperatureMeasurementGroup" />
        <eg:representsMeasurement rdf:resource="#PressureMeasurementGroup" />
        <eg:representsMeasurement rdf:resource="#FlowMeasurementGroup" />
        <eg:representsMeasurement rdf:resource="#LevelMeasurementGroup" />
        <eg:representsMeasurement rdf:resource="#CompositionMeasurementGroup" />
        <eg:representsMeasurement rdf:resource="#VoltageMeasurementGroup" />
        <eg:representsMeasurement rdf:resource="#CurrentMeasurementGroup" />
        <eg:representsMeasurement rdf:resource="#PowerMeasurementGroup" />
        <eg:representsMeasurement rdf:resource="#PowerQualityMeasurementGroup" />
        <eg:representsMeasurement rdf:resource="#ControlSignalMeasurementGroup" />
        <eg:representsMeasurement rdf:resource="#TimerMeasurementGroup" />
        <eg:representsMeasurement rdf:resource="#StateMeasurementGroup" />

        <ns3:distribution>
            <ns3:Distribution>
                <ns3:downloadURL rdf:resource="./data/BER_System_2025-10-15.lp" />
                <ns3:mediaType>text/csv</ns3:mediaType>
                <dct:hasFormat rdf:resource="./data/BER_System_2025-10-15.lp-metadata.json" />
            </ns3:Distribution>
        </ns3:distribution>
    </ns3:Dataset>


