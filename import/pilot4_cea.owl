        <eg:hasMeasurement rdf:resource="#t_SOEC_kh_1" />
        <eg:hasMeasurement rdf:resource="#t_SOEC_kh_2" />
        <eg:hasMeasurement rdf:resource="#t_SOEC_kh_3" />
        <eg:hasMeasurement rdf:resource="#t_SOEC_kh_4" />
    </owl:NamedIndividual>

