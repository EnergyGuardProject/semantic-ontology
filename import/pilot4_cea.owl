        <eg:hasMeasurement rdf:resource="#cns_FV102" />
        <eg:hasMeasurement rdf:resource="#cns_Stacks_Inlets_deltaP" />
        <eg:hasMeasurement rdf:resource="#cns_X_O2_Vent" />
        <eg:hasMeasurement rdf:resource="#cns_j" />
        <eg:hasMeasurement rdf:resource="#SC_calc_S1" />
        <eg:hasMeasurement rdf:resource="#SC_calc_S2" />
        <eg:hasMeasurement rdf:resource="#SC_calc_S3" />
        <eg:hasMeasurement rdf:resource="#SC_calc_S4" />
    </owl:NamedIndividual>

    <owl:NamedIndividual rdf:about="eg:TimerGroup">
        <rdf:type rdf:resource="eg:MeasurementGroup" />
