        <eg:hasMeasurement rdf:resource="#DPT213" />
        <eg:hasMeasurement rdf:resource="#DPT214" />
        <eg:hasMeasurement rdf:resource="#DPT311" />
        <eg:hasMeasurement rdf:resource="#DPT403" />
    </owl:NamedIndividual>

    <owl:NamedIndividual rdf:about="eg:FlowMeasurementGroup">
        <rdf:type rdf:resource="eg:MeasurementGroup" />
