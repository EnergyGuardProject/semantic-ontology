        <eg:hasMeasurement rdf:resource="eg:MV3C103_State"/>
        <eg:hasMeasurement rdf:resource="eg:MV3C105_State"/>
        <eg:hasMeasurement rdf:resource="eg:MV3C108_State"/>
        <eg:hasMeasurement rdf:resource="eg:SV2H208_State"/>
        <eg:hasMeasurement rdf:resource="eg:SV2H303_State"/>
        <eg:hasMeasurement rdf:resource="eg:SV2H405_State"/>
        <eg:hasMeasurement rdf:resource="eg:SV2H406_State"/>
    </owl:NamedIndividual>

    <owl:NamedIndividual rdf:about="eg:AuxiliaryDeviceGroup">
        <rdf:type rdf:resource="eg:AuxiliaryDevice" />
        <eg:hasMeasurement rdf:resource="eg:Fan_State" />
        <eg:hasMeasurement rdf:resource="eg:Heater_State" />
        <eg:hasMeasurement rdf:resource="eg:Dryer_State" />
        <eg:hasMeasurement rdf:resource="eg:SYS" />
        <eg:hasMeasurement rdf:resource="eg:GENERAL_Alarm" />
        <eg:hasMeasurement rdf:resource="eg:GENERAL_War" />
        <eg:hasMeasurement rdf:resource="eg:TERMICO_Alarm" />
        <eg:hasMeasurement rdf:resource="eg:TERMICO_War" />
        <eg:hasMeasurement rdf:resource="eg:PTH401" />
        <eg:hasMeasurement rdf:resource="eg:PTH403" />
        <eg:hasMeasurement rdf:resource="eg:PTH404" />
        <eg:hasMeasurement rdf:resource="eg:TT102" />
        <eg:hasMeasurement rdf:resource="eg:TT107" />
        <eg:hasMeasurement rdf:resource="eg:TT111" />
        <eg:hasMeasurement rdf:resource="eg:TT113" />
        <eg:hasMeasurement rdf:resource="eg:TT114" />
    </owl:NamedIndividual>

