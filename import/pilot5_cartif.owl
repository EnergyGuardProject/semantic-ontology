        <eg:hasMeasurement rdf:resource="eg:MH1_Empty"/>
        <eg:hasMeasurement rdf:resource="eg:MH1_accumulated_H2_NL"/>
        <eg:hasMeasurement rdf:resource="eg:MH1_Full"/>
        <eg:hasMeasurement rdf:resource="eg:ALTA_PRESION_MH1_Alarm"/>
        <eg:hasMeasurement rdf:resource="eg:ALTA_PRESION_MH2_Alarm"/>
        <eg:hasMeasurement rdf:resource="eg:ALTA_TEMP_MH1_Alarm"/>
        <eg:hasMeasurement rdf:resource="eg:ALTA_TEMP_MH2_Alarm"/>
        <eg:hasMeasurement rdf:resource="eg:BAJA_TEMP_MH1_Alarm"/>
        <eg:hasMeasurement rdf:resource="eg:BAJA_TEMP_MH2_Alarm"/>
        <eg:hasMeasurement rdf:resource="eg:BMHEMPTY_War"/>
        <eg:hasMeasurement rdf:resource="eg:BMHFULL_War"/>
        <eg:hasMeasurement rdf:resource="eg:MH1_H"/>
        <eg:hasMeasurement rdf:resource="eg:MH1_L"/>
        <eg:hasMeasurement rdf:resource="eg:MH1_acc"/>
        <eg:hasMeasurement rdf:resource="eg:MH2_H"/>
        <eg:hasMeasurement rdf:resource="eg:MH2_L"/>
        <eg:hasMeasurement rdf:resource="eg:MH2_acc"/>
        <eg:hasMeasurement rdf:resource="eg:MH2_accumulated_H2_NL"/>
        <eg:hasMeasurement rdf:resource="eg:Purging_MH1"/>
        <eg:hasMeasurement rdf:resource="eg:Purging_MH2"/>
    </owl:NamedIndividual>

    <owl:NamedIndividual rdf:about="eg:FuelCellGroup">
        <eg:hasMeasurement rdf:resource="eg:FC_Current"/>
        <eg:hasMeasurement rdf:resource="eg:FC_Voltage"/>
        <eg:hasMeasurement rdf:resource="eg:FC_State"/>
        <eg:hasMeasurement rdf:resource="eg:FC_flow_Rate"/>
        <eg:hasMeasurement rdf:resource="eg:FC_Alarm"/>
        <eg:hasMeasurement rdf:resource="eg:FC_War"/>
    </owl:NamedIndividual>

    <owl:NamedIndividual rdf:about="eg:BatterySystemGroup">
        <eg:hasMeasurement rdf:resource="eg:BATA_Current"/>
        <eg:hasMeasurement rdf:resource="eg:BATA_Voltage"/>
        <eg:hasMeasurement rdf:resource="eg:BATA_SOC"/>
        <eg:hasMeasurement rdf:resource="eg:BATB_Current"/>
