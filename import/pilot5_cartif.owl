    </owl:NamedIndividual>

    <owl:NamedIndividual rdf:about="eg:ALTA_PRESION_MH2_Alarm">
        <eg:representsComponent rdf:resource="eg:MetalHydrideTank"/>
        <rdf:type rdf:resource="eg:Alarm"/>
        <rdfs:label>ALTA_PRESION_MH2 Alarm</rdfs:label>
        <eg:storedInDatabaseTable rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Cartif_Hydrogen_2024_06_02_table</eg:storedInDatabaseTable>
        <eg:storedInDatabaseColumn rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ALTA_PRESION_MH2_Alarm</eg:storedInDatabaseColumn>
    </owl:NamedIndividual>

    <owl:NamedIndividual rdf:about="eg:ALTA_TEMP_MH1_Alarm">
        <eg:representsComponent rdf:resource="eg:MetalHydrideTank"/>
        <rdf:type rdf:resource="eg:Alarm"/>
        <rdfs:label>ALTA_TEMP_MH1 Alarm</rdfs:label>
        <eg:storedInDatabaseTable rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Cartif_Hydrogen_2024_06_02_table</eg:storedInDatabaseTable>
        <eg:storedInDatabaseColumn rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ALTA_TEMP_MH1_Alarm</eg:storedInDatabaseColumn>
    </owl:NamedIndividual>

    <owl:NamedIndividual rdf:about="eg:ALTA_TEMP_MH2_Alarm">
        <eg:representsComponent rdf:resource="eg:MetalHydrideTank"/>
        <rdf:type rdf:resource="eg:Alarm"/>
        <rdfs:label>ALTA_TEMP_MH2 Alarm</rdfs:label>
        <eg:storedInDatabaseTable rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Cartif_Hydrogen_2024_06_02_table</eg:storedInDatabaseTable>
        <eg:storedInDatabaseColumn rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ALTA_TEMP_MH2_Alarm</eg:storedInDatabaseColumn>
    </owl:NamedIndividual>

    <owl:NamedIndividual rdf:about="eg:BAJA_TEMP_MH1_Alarm">
        <eg:representsComponent rdf:resource="eg:MetalHydrideTank"/>
        <rdf:type rdf:resource="eg:Warning"/>
        <rdfs:label>BAJA_TEMP_MH1 Warning</rdfs:label>
        <eg:storedInDatabaseTable rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Cartif_Hydrogen_2024_06_02_table</eg:storedInDatabaseTable>
        <eg:storedInDatabaseColumn rdf:datatype="http://www.w3.org/2001/XMLSchema#string">BAJA_TEMP_MH1_Alarm</eg:storedInDatabaseColumn>
