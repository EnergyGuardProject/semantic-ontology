<?xml version="1.0"?>
<rdf:RDF xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
    xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
    xmlns:owl="http://www.w3.org/2002/07/owl#"
    xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
    xmlns:saref="https://saref.etsi.org/core/"
    xmlns:s4ener="https://saref.etsi.org/saref4ener/"
    xmlns:sosa="http://www.w3.org/ns/sosa/"
    xmlns:ssn="http://www.w3.org/ns/ssn/"
    xmlns:qudt="http://qudt.org/schema/qudt/"
    xmlns:unit="http://qudt.org/vocab/unit/"
    xmlns:eg="http://www.energyguard.eu/ontology#"
    xmlns:dcat="http://www.w3.org/ns/dcat#"
    xmlns:dct="http://purl.org/dc/terms/">

    <!-- Ontology Header -->
    <owl:Ontology rdf:about="http://www.energyguard.eu/ontology/cartif/v3">
        <rdfs:label>CARTIF Hydrogen System Ontology (Refactored v3)</rdfs:label>
        <rdfs:comment>Version aligned with Pilot2 v3 schema: each measurement NamedIndividual explicitly references the component it represents.</rdfs:comment>
        <owl:versionInfo>3.0.0-refactored</owl:versionInfo>

        <!-- Import standard ontologies used for mappings -->
        <owl:imports rdf:resource="https://saref.etsi.org/core/"/>
        <owl:imports rdf:resource="https://saref.etsi.org/saref4ener/"/>
        <owl:imports rdf:resource="http://www.w3.org/ns/sosa/"/>
        <owl:imports rdf:resource="http://www.w3.org/ns/ssn/"/>
        <owl:imports rdf:resource="http://qudt.org/schema/qudt/"/>
    </owl:Ontology>

    <!-- ==============================
         CLASSES
    ============================== -->

    <!-- Dataset -->
    <owl:Class rdf:about="eg:Dataset">
        <rdfs:subClassOf rdf:resource="dcat:Dataset" />
    </owl:Class>

    <!-- Measurement mapped to SOSA Observation -->
    <owl:Class rdf:about="eg:Measurement">
        <rdfs:subClassOf rdf:resource="s4ener:Measurement" />
        <rdfs:label>Measurement</rdfs:label>
        <rdfs:comment>A time-stamped reading from any sensor or system (numeric, state, or signal).</rdfs:comment>
    </owl:Class>

    <owl:Class rdf:about="eg:TemperatureMeasurement">
        <rdfs:subClassOf rdf:resource="eg:Measurement"/>
        <rdfs:label>Temperature Measurement</rdfs:label>
        <rdfs:comment>Temperature readings from sensors or stacks (e.g., TT111, TT113, TT114).</rdfs:comment>
    </owl:Class>

    <owl:Class rdf:about="eg:PowerMeasurement">
        <rdfs:subClassOf rdf:resource="eg:Measurement"/>
        <rdfs:label>Power Measurement</rdfs:label>
        <rdfs:comment>Electrical power generation or consumption (e.g., POT_ELE, POT_PILA, HP_elect_pow, Resistor_Pow).</rdfs:comment>
    </owl:Class>

    <owl:Class rdf:about="eg:ElectricalMeasurement">
        <rdfs:subClassOf rdf:resource="eg:Measurement"/>
        <rdfs:label>Electrical Measurement</rdfs:label>
        <rdfs:comment>Electrical quantities such as current, voltage and SOC (A, V, %).</rdfs:comment>
    </owl:Class>

    <owl:Class rdf:about="eg:HydrogenMeasurement">
        <rdfs:subClassOf rdf:resource="eg:Measurement"/>
        <rdfs:label>Hydrogen Measurement</rdfs:label>
        <rdfs:comment>Hydrogen-related data: flow, pressure, or storage (e.g., ELE_H2_Flow_Rate, FC_flow_Rate, MH1_accumulated_H2_NL).</rdfs:comment>
    </owl:Class>

    <owl:Class rdf:about="eg:PressureMeasurement">
        <rdfs:subClassOf rdf:resource="eg:Measurement"/>
        <rdfs:label>Pressure Measurement</rdfs:label>
        <rdfs:comment>Hydrogen-related pressure data (e.g., PTH403, PTH404).</rdfs:comment>
    </owl:Class>

    <owl:Class rdf:about="eg:FlowMeasurement">
        <rdfs:subClassOf rdf:resource="eg:Measurement"/>
        <rdfs:label>Flow Measurement</rdfs:label>
        <rdfs:comment>Hydrogen-related flow data (e.g., ELE_H2_Flow_Rate, FC_flow_Rate).</rdfs:comment>
    </owl:Class>

    <owl:Class rdf:about="eg:StateMeasurement">
        <rdfs:subClassOf rdf:resource="eg:Measurement"/>
        <rdfs:label>State Measurement</rdfs:label>
        <rdfs:comment>Operational states of components (e.g., SYS, MH1_Active, MH2_Empty).</rdfs:comment>
    </owl:Class>

    <!-- SystemComponent mapped to SAREF Device -->
    <owl:Class rdf:about="eg:SystemComponent">
        <rdfs:subClassOf rdf:resource="saref:Device"/>
        <rdfs:label>System Component</rdfs:label>
        <rdfs:comment>Physical equipment or subsystem in the facility.</rdfs:comment>
    </owl:Class>

    <!-- Specific system components with additional SAREF/S4ENER mappings where applicable -->
    <owl:Class rdf:about="eg:Battery">
        <rdfs:subClassOf rdf:resource="eg:SystemComponent"/>
        <rdfs:subClassOf rdf:resource="s4ener:Storage"/>
        <rdfs:label>Battery</rdfs:label>
        <rdfs:comment>Energy storage device with voltage, current, and SOC (e.g., BATA, BATB).</rdfs:comment>
    </owl:Class>

    <owl:Class rdf:about="eg:Electrolyzer">
        <rdfs:subClassOf rdf:resource="eg:SystemComponent"/>
        <rdfs:subClassOf rdf:resource="s4ener:EnergyConsumer"/>
        <rdfs:label>Electrolyzer</rdfs:label>
        <rdfs:comment>Produces hydrogen from water and electricity (e.g., ELECTROLIZADOR).</rdfs:comment>
    </owl:Class>

    <owl:Class rdf:about="eg:FuelCell">
        <rdfs:subClassOf rdf:resource="eg:SystemComponent"/>
        <rdfs:subClassOf rdf:resource="s4ener:EnergyProducer"/>
        <rdfs:label>Fuel Cell</rdfs:label>
        <rdfs:comment>Consumes hydrogen to generate electricity (e.g., FC).</rdfs:comment>
    </owl:Class>

    <owl:Class rdf:about="eg:MetalHydrideTank">
        <rdfs:subClassOf rdf:resource="eg:SystemComponent"/>
        <rdfs:subClassOf rdf:resource="s4ener:Storage"/>
        <rdfs:label>Metal Hydride Tank</rdfs:label>
        <rdfs:comment>Hydrogen storage tanks with multiple level and state signals (e.g., MH1, MH2).</rdfs:comment>
    </owl:Class>

    <owl:Class rdf:about="eg:Pump">
        <rdfs:subClassOf rdf:resource="eg:SystemComponent"/>
        <rdfs:subClassOf rdf:resource="saref:Actuator"/>
        <rdfs:label>Pump</rdfs:label>
        <rdfs:comment>Moves fluids/hydrogen through the system (e.g., Pump_State).</rdfs:comment>
    </owl:Class>

    <owl:Class rdf:about="eg:Valve">
        <rdfs:subClassOf rdf:resource="eg:SystemComponent"/>
        <rdfs:subClassOf rdf:resource="saref:Actuator"/>
        <rdfs:label>Valve</rdfs:label>
        <rdfs:comment>Regulates hydrogen or thermal circuit flow (e.g., MV3C101_State, SV2H208_State).</rdfs:comment>
    </owl:Class>

    <owl:Class rdf:about="eg:AuxiliaryDevice">
        <rdfs:subClassOf rdf:resource="eg:SystemComponent"/>
        <rdfs:subClassOf rdf:resource="saref:Actuator"/>
        <rdfs:label>Auxiliary Device</rdfs:label>
        <rdfs:comment>Supports hydrogen or thermal management subsystems (e.g., Dryer, Fan, Heater, Resistor).</rdfs:comment>
    </owl:Class>

    <owl:Class rdf:about="eg:Sensor">
        <rdfs:subClassOf rdf:resource="eg:SystemComponent"/>
        <rdfs:subClassOf rdf:resource="sosa:Sensor"/>
        <rdfs:label>Sensor</rdfs:label>
        <rdfs:comment>Measures environmental or process parameters (e.g., TT102, TT107, PTH401).</rdfs:comment>
    </owl:Class>

    <owl:Class rdf:about="eg:State">
        <rdfs:label>State</rdfs:label>
        <rdfs:comment>Boolean or coded indicator for operational states, alarms, warnings (e.g., MH1_Active, FC_War).</rdfs:comment>
    </owl:Class>

    <owl:Class rdf:about="eg:Alarm">
        <rdfs:subClassOf rdf:resource="eg:State"/>
        <rdfs:label>Alarm</rdfs:label>
        <rdfs:comment>Active alarm signals (e.g., ALTA_PRESION_MH1_Alarm, FC_Alarm).</rdfs:comment>
    </owl:Class>

    <owl:Class rdf:about="eg:Warning">
        <rdfs:subClassOf rdf:resource="eg:State"/>
        <rdfs:label>Warning</rdfs:label>
        <rdfs:comment>Non-critical warning signals (e.g., BAJA_TEMP_MH1_Alarm, BATERIAS_War).</rdfs:comment>
    </owl:Class>

    <!-- ==============================
         PROPERTIES (minimal, used by instances)
    ============================== -->

    <owl:ObjectProperty rdf:ID="hasMeasurement">
        <rdfs:domain rdf:resource="eg:SystemComponent"/>
        <rdfs:range rdf:resource="eg:Measurement"/>
        <rdfs:label>has measurement</rdfs:label>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="eg:hasState">
        <rdfs:domain rdf:resource="eg:SystemComponent"/>
        <rdfs:range rdf:resource="eg:State"/>
        <rdfs:label>has state</rdfs:label>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="eg:hasAlarm">
        <rdfs:domain rdf:resource="eg:SystemComponent"/>
        <rdfs:range rdf:resource="eg:Alarm"/>
        <rdfs:subPropertyOf rdf:resource="eg:hasState"/>
        <rdfs:label>has alarm</rdfs:label>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="eg:hasWarning">
        <rdfs:domain rdf:resource="eg:SystemComponent"/>
        <rdfs:range rdf:resource="eg:Warning"/>
        <rdfs:subPropertyOf rdf:resource="eg:hasState"/>
        <rdfs:label>has warning</rdfs:label>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="eg:representsComponent">
        <rdfs:domain rdf:resource="eg:Dataset"/>
        <rdfs:range rdf:resource="eg:SystemComponent"/>
        <rdfs:label>represents component</rdfs:label>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:ID="hasUnit">
        <rdfs:domain rdf:resource="eg:Measurement" />
        <rdfs:range rdf:resource="qudt:Unit" />
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:ID="recordedInDataset">
        <rdfs:domain rdf:resource="eg:Measurement" />
        <rdfs:range rdf:resource="eg:Dataset" />
        <owl:equivalentProperty rdf:resource="s4ener:recordedInDataset" />
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:ID="representsComponent">
        <rdfs:domain rdf:resource="eg:Dataset" />
        <rdfs:range rdf:resource="eg:SystemComponent" />
        <owl:equivalentProperty rdf:resource="s4ener:representsComponent" />
    </owl:ObjectProperty>
    
    <!-- <owl:ObjectProperty rdf:ID="hasMeasurement">
        <rdfs:domain rdf:resource="eg:Dataset"/>
        <rdfs:range rdf:resource="eg:Measurement"/>
        <owl:equivalentProperty rdf:resource="s4ener:hasMeasurement"/>
        <owl:equivalentProperty rdf:resource="saref:hasMeasurement"/>
    </owl:ObjectProperty> -->

    <!-- Minimal datatype properties -->
    <owl:DatatypeProperty rdf:about="eg:filename">
        <rdfs:domain rdf:resource="eg:Dataset"/>
        <rdfs:range rdf:resource="xsd:string"/>
        <rdfs:label>filename</rdfs:label>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="eg:startTime">
        <rdfs:domain rdf:resource="eg:Dataset"/>
        <rdfs:range rdf:resource="xsd:dateTime"/>
        <rdfs:label>start time</rdfs:label>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="eg:endTime">
        <rdfs:domain rdf:resource="eg:Dataset"/>
        <rdfs:range rdf:resource="xsd:dateTime"/>
        <rdfs:label>end time</rdfs:label>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="eg:sampleRate">
        <rdfs:domain rdf:resource="eg:Dataset"/>
        <rdfs:range rdf:resource="xsd:float"/>
        <rdfs:label>sample rate</rdfs:label>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="eg:measurementType">
        <rdfs:domain rdf:resource="eg:Measurement"/>
        <rdfs:range rdf:resource="xsd:string"/>
        <rdfs:label>measurement type</rdfs:label>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="eg:unit">
        <rdfs:domain rdf:resource="eg:Measurement"/>
        <rdfs:range rdf:resource="xsd:string"/>
        <rdfs:label>unit</rdfs:label>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="eg:value">
        <rdfs:domain rdf:resource="eg:Measurement"/>
        <rdfs:label>value</rdfs:label>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="eg:timestamp">
        <rdfs:domain rdf:resource="eg:Measurement"/>
        <rdfs:range rdf:resource="xsd:dateTime"/>
        <rdfs:label>timestamp</rdfs:label>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="eg:alarmLevel">
        <rdfs:domain rdf:resource="eg:Alarm"/>
        <rdfs:label>alarm level</rdfs:label>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="eg:stateCode">
        <rdfs:domain rdf:resource="eg:State"/>
        <rdfs:label>state code</rdfs:label>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="eg:location">
        <rdfs:domain rdf:resource="eg:SystemComponent"/>
        <rdfs:range rdf:resource="xsd:string"/>
        <rdfs:label>location</rdfs:label>
    </owl:DatatypeProperty>

    <!-- ==============================
         DATASET INSTANCE (keeps original sample content)
    ============================== -->
    <eg:Dataset rdf:ID="Dataset_2024_06_02">
        <eg:filename>Cartif_Hydrogen_2024-06-02.csv</eg:filename>
        <eg:startTime rdf:datatype="xsd:dateTime">2024-06-02T00:00:00+00:00</eg:startTime>
        <eg:endTime rdf:datatype="xsd:dateTime">2024-06-02T23:59:59+00:00</eg:endTime>
        <eg:sampleRate rdf:datatype="xsd:float">15.0</eg:sampleRate>

        <eg:representsComponent rdf:resource="eg:ElectrolyzerGroup"/>
        <eg:representsComponent rdf:resource="eg:MetalHydrideTankGroup"/>
        <eg:representsComponent rdf:resource="eg:FuelCellGroup"/>
        <eg:representsComponent rdf:resource="eg:BatteryGroup"/>
        <eg:representsComponent rdf:resource="eg:PumpGroup"/>
        <eg:representsComponent rdf:resource="eg:ValveGroup"/>
        <eg:representsComponent rdf:resource="eg:AuxiliaryDeviceGroup"/>

        <dcat:distribution>
            <dcat:Distribution>
                <dcat:downloadURL rdf:resource="./data/Cartif_Hydrogen_2024-06-02.csv"/>
                <dcat:mediaType>text/csv</dcat:mediaType>
                <dct:hasFormat rdf:resource="./data/Cartif_Hydrogen_2024-06-02.csv-metadata.json"/>
            </dcat:Distribution>
        </dcat:distribution>
    </eg:Dataset>

    <!-- DatasetComponent instances (kept as simple individuals referencing measurements) -->
    <owl:NamedIndividual rdf:about="eg:ElectrolyzerGroup">
        <rdf:type rdf:resource="eg:Electrolyzer" />
        <eg:hasMeasurement rdf:resource="eg:ELE_Current" />
        <eg:hasMeasurement rdf:resource="eg:ELE_Stack_Voltage" />
        <eg:hasMeasurement rdf:resource="eg:ELE_H2_Flow_Rate" />
        <eg:hasMeasurement rdf:resource="eg:ELE_State" />
        <eg:hasMeasurement rdf:resource="eg:ELE_Inner_H2_Pressure" />
        <eg:hasMeasurement rdf:resource="eg:ELE_Outer_H2_Pressure" />
        <eg:hasMeasurement rdf:resource="eg:ELE_water" />
        <eg:hasMeasurement rdf:resource="eg:EL_preheat" />
        <eg:hasMeasurement rdf:resource="eg:EL_temp" />
        <eg:hasMeasurement rdf:resource="eg:ELECTROLIZADOR_Alarm" />
        <eg:hasMeasurement rdf:resource="eg:ELECTROLIZADOR_War" />
    </owl:NamedIndividual>

    <owl:NamedIndividual rdf:about="eg:MetalHydrideTankGroup">
        <eg:representsComponent rdf:resource="eg:MetalHydrideTank" />
