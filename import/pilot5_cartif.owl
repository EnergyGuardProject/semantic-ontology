        <eg:hasMeasurement rdf:resource="eg:BATERIAS_War"/>
        <eg:hasMeasurement rdf:resource="eg:BAT_CURR_BATSTATE"/>
    </owl:NamedIndividual>

    <owl:NamedIndividual rdf:about="eg:PumpGroup">
        <rdf:type rdf:resource="eg:Pump" />
        <eg:hasMeasurement rdf:resource="eg:Pump_State"/>
        <eg:hasMeasurement rdf:resource="eg:POT_ELE"/>
        <eg:hasMeasurement rdf:resource="eg:POT_PILA"/>
        <eg:hasMeasurement rdf:resource="eg:Resistor_Pow"/>
        <eg:hasMeasurement rdf:resource="eg:HP_ON"/>
        <eg:hasMeasurement rdf:resource="eg:HP_elect_pow"/>
        <eg:hasMeasurement rdf:resource="eg:Resistor_SP"/>
    </owl:NamedIndividual>

    <owl:NamedIndividual rdf:about="eg:ValveGroup">
        <rdf:type rdf:resource="eg:Valve" />
