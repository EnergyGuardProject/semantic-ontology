    <owl:NamedIndividual rdf:ID="ALTA_PRESION_MH1_Alarm">
        <eg:representsComponent rdf:resource="eg:MetalHydrideTank"/>
        <rdf:type rdf:resource="eg:Alarm"/>
        <rdfs:label>ALTA_PRESION_MH1 Alarm</rdfs:label>
