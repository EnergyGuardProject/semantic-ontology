    <dcat:dataset>
      <dcat:Dataset rdf:about="https://ontology.energy-guard.eu/rea#Dataset_Air_quality">
        <dcterms:description xml:lang="en">Hourly concentrations of PM2.5, PM10, NO2, SO2 and O3 (µg/m³) from 3 Riga monitoring stations: Mīlgrāvis, Brīvības iela and Pārdaugava.</dcterms:description>
        <dcterms:publisher rdf:resource="https://ontology.energy-guard.eu/pilots#REA"/>
