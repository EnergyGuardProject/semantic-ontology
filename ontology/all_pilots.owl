    <rdfs:domain rdf:resource="https://ontology.energy-guard.eu/core#Variable"/>
    <rdfs:label xml:lang="en">data lake sensor pattern</rdfs:label>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://ontology.energy-guard.eu/core#storedInDatabaseTable">
    <rdfs:comment xml:lang="en">The table of the pilot's lake database that holds the dataset. A dataset without one is not in the lake.</rdfs:comment>
    <rdfs:domain rdf:resource="http://www.w3.org/ns/dcat#Dataset"/>
    <rdfs:label xml:lang="en">stored in database table</rdfs:label>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://ontology.energy-guard.eu/core#timeZone">
    <rdfs:domain rdf:resource="http://www.w3.org/ns/dcat#Dataset"/>
    <rdfs:label xml:lang="en">time zone</rdfs:label>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://ontology.energy-guard.eu/core#codeList">
    <rdfs:comment xml:lang="en">The meaning of coded values, e.g. 0 = Automatic; 1 = Service Mode.</rdfs:comment>
    <rdfs:domain rdf:resource="https://ontology.energy-guard.eu/core#Variable"/>
    <rdfs:label xml:lang="en">code list</rdfs:label>
  </owl:DatatypeProperty>
  <owl:Ontology rdf:about="https://ontology.energy-guard.eu/core">
    <dcterms:description xml:lang="en">Catalogue of the datasets and variables delivered by the seven EnergyGuard pilots and the location of each series in the EnergyGuard data lake. It describes the data; it does not contain measurements.</dcterms:description>
    <dcterms:license rdf:resource="https://www.gnu.org/licenses/gpl-3.0.html"/>
    <dcterms:title xml:lang="en">EnergyGuard Ontology (all pilots)</dcterms:title>
    <owl:versionIRI rdf:resource="https://ontology.energy-guard.eu/core/2.1.0"/>
    <owl:versionInfo>2.1.0</owl:versionInfo>
  </owl:Ontology>
  <owl:DatatypeProperty rdf:about="https://ontology.energy-guard.eu/core#decimals">
    <rdfs:domain rdf:resource="https://ontology.energy-guard.eu/core#Variable"/>
    <rdfs:label xml:lang="en">decimals</rdfs:label>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://ontology.energy-guard.eu/core#variableKind">
    <rdfs:comment xml:lang="en">measured, calculated, setpoint, state, alarm, output, static, modelled, timestamp (the time column) or identifier (address, cadastre number, id). A physical sensor (sosa:Sensor) is measured by definition and does not repeat it.</rdfs:comment>
    <rdfs:domain rdf:resource="https://ontology.energy-guard.eu/core#Variable"/>
    <rdfs:label xml:lang="en">variable kind</rdfs:label>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://ontology.energy-guard.eu/core#aggregation">
    <rdfs:comment xml:lang="en">Only given when the value is not instantaneous: mean, sum or cumulative.</rdfs:comment>
    <rdfs:domain rdf:resource="https://ontology.energy-guard.eu/core#Variable"/>
    <rdfs:label xml:lang="en">aggregation</rdfs:label>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://ontology.energy-guard.eu/core#dataType">
    <rdfs:comment xml:lang="en">float, integer, boolean, text, date, timestamp or geometry (the data lake's PostgreSQL types).</rdfs:comment>
    <rdfs:domain rdf:resource="https://ontology.energy-guard.eu/core#Variable"/>
    <rdfs:label xml:lang="en">data type</rdfs:label>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://ontology.energy-guard.eu/core#storedInDatabaseColumn">
    <rdfs:comment xml:lang="en">The column of a wide lake table that holds the variable.</rdfs:comment>
    <rdfs:domain rdf:resource="https://ontology.energy-guard.eu/core#Variable"/>
    <rdfs:label xml:lang="en">stored in database column</rdfs:label>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://ontology.energy-guard.eu/core#signConvention">
    <rdfs:domain rdf:resource="https://ontology.energy-guard.eu/core#Variable"/>
    <rdfs:label xml:lang="en">sign convention</rdfs:label>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://ontology.energy-guard.eu/core#dataLakeSensorId">
    <rdfs:comment xml:lang="en">The sensor_id of the series in the lake table.</rdfs:comment>
    <rdfs:label xml:lang="en">data lake sensor id</rdfs:label>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://ontology.energy-guard.eu/core#storedInDatabase">
    <rdfs:comment xml:lang="en">The data lake database that holds the pilot's datasets (one database per pilot).</rdfs:comment>
    <rdfs:domain rdf:resource="http://xmlns.com/foaf/0.1/Organization"/>
    <rdfs:label xml:lang="en">stored in database</rdfs:label>
  </owl:DatatypeProperty>
