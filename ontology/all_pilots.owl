        <dcterms:accessRights rdf:resource="http://publications.europa.eu/resource/authority/access-right/RESTRICTED"/>
        <dcterms:description xml:lang="en">Original PLC/SCADA operational time-series export from the CARTIF hydrogen test bench, covering the hydrogen generation, storage and energy conversion equipment and associated monitoring and control signals. The dataset is provided for internal use within the EnergyGuard consortium. System covered: Hydrogen test bench, including electrolyser, fuel cell, metal-hydride hydrogen storage, electrical batteries and thermal auxiliaries. Source: Hydrogen test bench PLC/SCADA.</dcterms:description>
        <dcterms:format>CSV</dcterms:format>
