        <schema1:variableMeasured rdf:resource="https://ontology.energy-guard.eu/rea#Air_quality__SO2_g_m3"/>
        <skos:note>TO BE UPDATED based on air quality from open portal:https://data.gov.lv/dati/dataset/ikmenesa-gaisa-kvalitate | 1 data row per day and hour, e.g. 2024.01.01 00:00, 2024.01.01 01:00, ..., 2024.01.01 23:00</skos:note>
        <dcat:landingPage rdf:resource="https://gmsd.riga.lv/main.php?i_lang=2"/>
        <eg:storedInDatabaseTable>public.f_tsdata</eg:storedInDatabaseTable>
      </dcat:Dataset>
    </dcat:dataset>
