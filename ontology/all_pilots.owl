  <eg:Variable rdf:about="https://ontology.energy-guard.eu/engreen#The_GSE_Historical_Metering_Dataset__kWh">
    <dcterms:description xml:lang="en">Energy measured during the hourly interval: grid withdrawal, grid injection or energy production depending on the file</dcterms:description>
    <dcterms:identifier>Pseudonymised measurement code</dcterms:identifier>
    <qudt:hasUnit rdf:resource="http://qudt.org/vocab/unit/KiloW-HR"/>
    <rdfs:label xml:lang="en">Energy value</rdfs:label>
    <skos:note xml:lang="en">Valid range: ≥ 0</skos:note>
    <skos:note>hourly sum</skos:note>
    <csvw:name>kWh</csvw:name>
    <sosa:isHostedBy rdf:resource="https://ontology.energy-guard.eu/engreen#Platform_Metering_point_production_unit"/>
    <sosa:observes rdf:resource="https://ontology.energy-guard.eu/property#Energy"/>
    <eg:aggregation>sum</eg:aggregation>
    <eg:dataType>float</eg:dataType>
    <eg:signConvention>always positive; the flow direction is given by the file</eg:signConvention>
