    <dcat:dataset>
      <dcat:Dataset rdf:about="https://ontology.energy-guard.eu/rea#Dataset_Building_and_heating_consumption_data_Heating_2017_2024_xlsx">
        <dcterms:description xml:lang="en">Monthly heat consumption (heating + hot water, MWh) for 7,033 buildings from 01.2017 to 12.2024, split into annual heating and hot water totals and 5-year averages, plus building characteristics (type, operating year, areas, apartments, floors, volume) and energy certificate info.</dcterms:description>
