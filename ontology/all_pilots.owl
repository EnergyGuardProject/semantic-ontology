  <eg:Variable rdf:about="https://ontology.energy-guard.eu/ber#SEQ_X101">
    <dcterms:description xml:lang="en">Main state machine step</dcterms:description>
    <schema1:maxValue rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">10000.0</schema1:maxValue>
    <schema1:minValue rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">0.0</schema1:minValue>
    <schema1:unitText>step</schema1:unitText>
    <rdfs:label xml:lang="en">SEQ-X101</rdfs:label>
    <sosa:isHostedBy rdf:resource="https://ontology.energy-guard.eu/ber#Platform_control"/>
    <sosa:observes rdf:resource="https://ontology.energy-guard.eu/property#State"/>
    <eg:codeList>see Step Legend; 0 = Boot; 1 = Dump; 2 = Empty; 3 = Filling; 4 = Cleaning; 5 = Circulating; 6 = Wait For Chiller; 7 = Ext Fan Starting; 8 = Int Fan Starting; 9 = Psu Comm Check; 10 = Ready To Start; 11 = Psu Starting; 12 = Warming Up; 13 = Running; 14 = Unloading; 15 = Cooling Down; 16 = Maintain; 100 = Emergency Stop; 101 = Dump Fail; 102 = Filling Fail; 103 = Cleaning Fail; 104 = Circulation Fail; 105 = Chiller Fail; 106 = Ext Fan Start Fail; 107 = Int Fan Start Fail; 108 = Psu Comm Fail; 109 = Psu Start Fail; 110 = Warm Up Press Low; 111 = Conductivity Too High; 112 = Feed Temp Too High; 113 = Delta Temp Too High; 114 = H2 Line Overpressure; 115 = Feed Press Too Low; 116 = Feed Press Too High; 117 = Feed Tank Starvation; 118 = Ventilation Trip; 119 = PSU Trip; 120 = Dryer Not Available; 121 = Dryer Oversaturated; 122 = Feed Tank Overflow; 130 = I/O Error; 131 = ACB Trip; 132 = Fuse Trip; 133 = Storage Tank Starvation; 134 = Storage Tank Overtemp; 135 = Safety Checksum Error; 136 = Deoxo Heater Fail; 137 = Dryer Chkv Leakage; 138 = Pems Comm Fail; 150 = Hybernation; 999 = Service Mode</eg:codeList>
    <eg:dataLakeSensorId>SEQ_X101</eg:dataLakeSensorId>
    <eg:dataType>integer</eg:dataType>
    <eg:decimals rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">0</eg:decimals>
    <eg:variableKind>state</eg:variableKind>
  </eg:Variable>
