    <dcat:dataset>
      <dcat:Dataset rdf:about="https://ontology.energy-guard.eu/ciemat#Dataset_CEDER_CIEMAT_Microgrid_Daily_Operational_Data_1_s">
        <dcterms:accrualPeriodicity rdf:resource="http://publications.europa.eu/resource/authority/frequency/DAILY"/>
        <dcterms:description xml:lang="en">Operational data from the CEDER-CIEMAT microgrid in Soria, Spain. The dataset includes measurements from photovoltaic plants, wind turbines, electrical loads, battery storage systems and auxiliary equipment. It is collected for daily monitoring, operational analysis and the development and validation of intelligent energy management strategies. System covered: Microgrid operation, including photovoltaic plants, wind turbines, electrical consumption, energy storage systems and auxiliary equipment. Source: CEDER-CIEMAT microgrid monitoring and data acquisition system (SCADA / monitoring infrastructure).</dcterms:description>
        <dcterms:format>CSV, comma-separated, decimal point</dcterms:format>
        <dcterms:publisher rdf:resource="https://ontology.energy-guard.eu/pilots#CIEMAT"/>
        <dcterms:spatial rdf:resource="https://ontology.energy-guard.eu/ciemat#Place_CEDER_CIEMAT_Microgrid_Daily_Operational_Data_1_s"/>
