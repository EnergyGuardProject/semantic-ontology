    <dcat:dataset>
      <dcat:Dataset rdf:about="https://ontology.energy-guard.eu/engreen#Dataset_GME_CSUD_Hourly_Electricity_Price_Dataset">
        <dcterms:accrualPeriodicity rdf:resource="http://publications.europa.eu/resource/authority/frequency/NEVER"/>
        <dcterms:description xml:lang="en">Hourly zonal electricity price of the Centro-Sud (CSUD) bidding zone of the Italian day-ahead market (MGP), published by GME (Gestore dei Mercati Energetici). It is the reference price used to value the electricity injected into the grid by REC members and to compute the economic indicators of the Digital Twin. System covered: Italian wholesale electricity market, day-ahead zonal prices. Source: GME market results (MGP zonal prices), open data.</dcterms:description>
        <dcterms:format>XLSX, one sheet 'MGP-PrezziZonali-CSUD'; dates stored as text dd/mm/yyyy; decimal point. Uploaded to the EnergyGuard Data Lake as CSV.</dcterms:format>
        <dcterms:license rdf:resource="https://ontology.energy-guard.eu/engreen#Licence_GME_CSUD_Hourly_Electricity_Price_Dataset"/>
        <dcterms:publisher rdf:resource="https://ontology.energy-guard.eu/pilots#ENGREEN"/>
        <dcterms:spatial rdf:resource="https://ontology.energy-guard.eu/engreen#Place_GME_CSUD_Hourly_Electricity_Price_Dataset"/>
        <dcterms:temporal rdf:resource="https://ontology.energy-guard.eu/engreen#Period_GME_CSUD_Hourly_Electricity_Price_Dataset"/>
        <dcterms:title xml:lang="en">GME CSUD Hourly Electricity Price Dataset</dcterms:title>
        <schema1:variableMeasured rdf:resource="https://ontology.energy-guard.eu/engreen#GME_CSUD_Hourly_Electricity_Price_Dataset__Data"/>
        <schema1:variableMeasured rdf:resource="https://ontology.energy-guard.eu/engreen#GME_CSUD_Hourly_Electricity_Price_Dataset__Ora"/>
        <schema1:variableMeasured rdf:resource="https://ontology.energy-guard.eu/engreen#GME_CSUD_Hourly_Electricity_Price_Dataset__PZ_t"/>
        <dcat:temporalResolution rdf:datatype="http://www.w3.org/2001/XMLSchema#duration">PT1H</dcat:temporalResolution>
        <eg:timeZone>Italian local time with daylight saving time (GME convention: 23 hours on the spring change day, 25 on the autumn change day)</eg:timeZone>
      </dcat:Dataset>
    </dcat:dataset>
    <dcat:dataset>
      <dcat:Dataset rdf:about="https://ontology.energy-guard.eu/engreen#Dataset_Operational_monitoring_dataset">
        <dcterms:accessRights rdf:resource="http://publications.europa.eu/resource/authority/access-right/RESTRICTED"/>
        <dcterms:accrualPeriodicity rdf:resource="http://publications.europa.eu/resource/authority/frequency/DAILY"/>
        <dcterms:description xml:lang="en">Time series of the operating data of the PV plants, inverters, grid meters and batteries of the REC producers and prosumers, collected from the Huawei FusionSolar (10 plants) and Deye Solarman (1 municipal plant with battery) monitoring platforms. It is the real-time operational layer of the Digital Twin and supports PV performance analysis, battery operation analysis and anomaly detection. Only a selected subset of the variables available on the platforms is retained. System covered: PV plants, inverters, grid connection meters (power sensors) and battery storage systems. Source: Huawei FusionSolar and Deye Solarman cloud monitoring platforms (API and data export).</dcterms:description>
        <dcterms:format>XLSX source exports. FusionSolar: one file per device (inverter, power sensor or battery), four header rows (time range, export time, legend, column names); column names and decimal separator follow the portal language. Solarman: one file per plant, one header row, numeric values stored as text. Uploaded to the EnergyGuard Data Lake as CSV.</dcterms:format>
        <dcterms:license rdf:resource="https://creativecommons.org/licenses/by/4.0/"/>
        <dcterms:publisher rdf:resource="https://ontology.energy-guard.eu/pilots#ENGREEN"/>
        <dcterms:spatial rdf:resource="https://ontology.energy-guard.eu/engreen#Place_Operational_monitoring_dataset"/>
        <dcterms:temporal rdf:resource="https://ontology.energy-guard.eu/engreen#Period_Operational_monitoring_dataset"/>
        <dcterms:title xml:lang="en">Operational monitoring dataset</dcterms:title>
        <schema1:variableMeasured rdf:resource="https://ontology.energy-guard.eu/engreen#Operational_monitoring_dataset__Active_power_W"/>
        <schema1:variableMeasured rdf:resource="https://ontology.energy-guard.eu/engreen#Operational_monitoring_dataset__Active_power_kW"/>
        <schema1:variableMeasured rdf:resource="https://ontology.energy-guard.eu/engreen#Operational_monitoring_dataset__Batteria_SOC"/>
        <schema1:variableMeasured rdf:resource="https://ontology.energy-guard.eu/engreen#Operational_monitoring_dataset__Battery_Power_W"/>
        <schema1:variableMeasured rdf:resource="https://ontology.energy-guard.eu/engreen#Operational_monitoring_dataset__Daily_energy_kWh"/>
        <schema1:variableMeasured rdf:resource="https://ontology.energy-guard.eu/engreen#Operational_monitoring_dataset__Grid_Power_W"/>
        <schema1:variableMeasured rdf:resource="https://ontology.energy-guard.eu/engreen#Operational_monitoring_dataset__Negative_active_energy_kWh"/>
        <schema1:variableMeasured rdf:resource="https://ontology.energy-guard.eu/engreen#Operational_monitoring_dataset__Positive_active_energy_kWh"/>
        <schema1:variableMeasured rdf:resource="https://ontology.energy-guard.eu/engreen#Operational_monitoring_dataset__Potenza_di_carica_e_scarica_kW"/>
        <schema1:variableMeasured rdf:resource="https://ontology.energy-guard.eu/engreen#Operational_monitoring_dataset__Production_Power_W"/>
        <schema1:variableMeasured rdf:resource="https://ontology.energy-guard.eu/engreen#Operational_monitoring_dataset__SoC"/>
        <schema1:variableMeasured rdf:resource="https://ontology.energy-guard.eu/engreen#Operational_monitoring_dataset__Total_yield_kWh"/>
        <schema1:variableMeasured rdf:resource="https://ontology.energy-guard.eu/engreen#Operational_monitoring_dataset__collectTime"/>
        <csvw:null>FusionSolar: 'N/A' = not available or not recorded while the device was disconnected; '-' = counter not supported by the device. Solarman: empty cell = not applicable for the current flow direction or not available. Missing intervals = absent rows.</csvw:null>
        <dcat:temporalResolution rdf:datatype="http://www.w3.org/2001/XMLSchema#duration">PT5M</dcat:temporalResolution>
        <eg:storedInDatabaseTable>public.f_tsdata</eg:storedInDatabaseTable>
        <eg:timeZone>FusionSolar: Italian local time with daylight saving time (timestamps marked 'DST' in summer). Solarman: time zone given in the 'Time Zone' column (UTC+01:00, no daylight saving shift).</eg:timeZone>
      </dcat:Dataset>
    </dcat:dataset>
    <dcat:dataset>
      <dcat:Dataset rdf:about="https://ontology.energy-guard.eu/engreen#Dataset_Shelly_consumer_monitoring_dataset">
        <dcterms:accessRights rdf:resource="http://publications.europa.eu/resource/authority/access-right/RESTRICTED"/>
        <dcterms:accrualPeriodicity rdf:resource="http://publications.europa.eu/resource/authority/frequency/DAILY"/>
        <dcterms:description xml:lang="en">Electricity consumption and voltage data from Shelly energy meters installed by ENGREEN at five residential consumers of the REC, as a representative sample of demand-side behaviour. It complements the hourly GSE data with higher-resolution measurements and supports load-profile analysis, Digital Twin validation and demand-side modelling. System covered: Residential electricity consumption at the grid connection point (5 households). Source: Shelly energy meters, Shelly Cloud (API).</dcterms:description>
        <dcterms:format><![CDATA[CSV exported from Shelly Cloud, one file per meter and variable group: one block per variable (title row, header row 'Ore, <unit>'), comma separator, decimal point, timestamps dd/mm/yyyy hh:mm. Uploaded to the EnergyGuard Data Lake as CSV.]]></dcterms:format>
        <dcterms:license rdf:resource="https://creativecommons.org/licenses/by/4.0/"/>
        <dcterms:publisher rdf:resource="https://ontology.energy-guard.eu/pilots#ENGREEN"/>
        <dcterms:spatial rdf:resource="https://ontology.energy-guard.eu/engreen#Place_Shelly_consumer_monitoring_dataset"/>
        <dcterms:temporal rdf:resource="https://ontology.energy-guard.eu/engreen#Period_Shelly_consumer_monitoring_dataset"/>
        <dcterms:title xml:lang="en">Shelly consumer monitoring dataset</dcterms:title>
        <schema1:variableMeasured rdf:resource="https://ontology.energy-guard.eu/engreen#Shelly_consumer_monitoring_dataset__Consumo"/>
        <schema1:variableMeasured rdf:resource="https://ontology.energy-guard.eu/engreen#Shelly_consumer_monitoring_dataset__Voltaggio_minimo"/>
        <schema1:variableMeasured rdf:resource="https://ontology.energy-guard.eu/engreen#Shelly_consumer_monitoring_dataset__collectTime"/>
        <csvw:null>No explicit marker; missing intervals = absent rows</csvw:null>
        <dcat:temporalResolution rdf:datatype="http://www.w3.org/2001/XMLSchema#duration">PT15M</dcat:temporalResolution>
        <eg:storedInDatabaseTable>public.f_tsdata</eg:storedInDatabaseTable>
        <eg:timeZone>Italian local time (Europe/Rome)</eg:timeZone>
      </dcat:Dataset>
    </dcat:dataset>
    <dcat:dataset>
      <dcat:Dataset rdf:about="https://ontology.energy-guard.eu/engreen#Dataset_The_Antrodoco_REC_Mapping_Dataset">
        <dcterms:accessRights rdf:resource="http://publications.europa.eu/resource/authority/access-right/RESTRICTED"/>
        <dcterms:accrualPeriodicity rdf:resource="http://publications.europa.eu/resource/authority/frequency/IRREG"/>
        <dcterms:description xml:lang="en">Static description of the members of the Antrodoco REC and of their energy assets: user role and type, GSE status, monitoring system, PV plant and battery characteristics and contracted power. It is the reference dataset that links each pseudonymised metering point to its technical characteristics and is used to build the REC Digital Twin. Names, addresses and geographical coordinates are not included; POD and CENSIMP codes are pseudonymised. System covered: REC members (consumers, producers, prosumers), PV plants and battery storage systems. Source: REC mapping compiled by ENGREEN as REC operator (membership data, GSE portal, plant documentation).</dcterms:description>
        <dcterms:format>XLSX source file (sheet 'Map' with data, sheet 'Legenda' with field rules), decimal point. Uploaded to the EnergyGuard Data Lake as CSV.</dcterms:format>
        <dcterms:license rdf:resource="https://creativecommons.org/licenses/by/4.0/"/>
        <dcterms:publisher rdf:resource="https://ontology.energy-guard.eu/pilots#ENGREEN"/>
        <dcterms:spatial rdf:resource="https://ontology.energy-guard.eu/engreen#Place_The_Antrodoco_REC_Mapping_Dataset"/>
        <dcterms:temporal rdf:resource="https://ontology.energy-guard.eu/engreen#Period_The_Antrodoco_REC_Mapping_Dataset"/>
        <dcterms:title xml:lang="en">The Antrodoco REC Mapping Dataset</dcterms:title>
        <schema1:variableMeasured rdf:resource="https://ontology.energy-guard.eu/engreen#The_Antrodoco_REC_Mapping_Dataset__CENSIMP"/>
        <schema1:variableMeasured rdf:resource="https://ontology.energy-guard.eu/engreen#The_Antrodoco_REC_Mapping_Dataset__Contributo_PNRR"/>
        <schema1:variableMeasured rdf:resource="https://ontology.energy-guard.eu/engreen#The_Antrodoco_REC_Mapping_Dataset__Esente"/>
        <schema1:variableMeasured rdf:resource="https://ontology.energy-guard.eu/engreen#The_Antrodoco_REC_Mapping_Dataset__GSE"/>
        <schema1:variableMeasured rdf:resource="https://ontology.energy-guard.eu/engreen#The_Antrodoco_REC_Mapping_Dataset__Note"/>
        <schema1:variableMeasured rdf:resource="https://ontology.energy-guard.eu/engreen#The_Antrodoco_REC_Mapping_Dataset__POD"/>
        <schema1:variableMeasured rdf:resource="https://ontology.energy-guard.eu/engreen#The_Antrodoco_REC_Mapping_Dataset__PV_azimuth"/>
        <schema1:variableMeasured rdf:resource="https://ontology.energy-guard.eu/engreen#The_Antrodoco_REC_Mapping_Dataset__PV_installation_year"/>
        <schema1:variableMeasured rdf:resource="https://ontology.energy-guard.eu/engreen#The_Antrodoco_REC_Mapping_Dataset__PV_model"/>
        <schema1:variableMeasured rdf:resource="https://ontology.energy-guard.eu/engreen#The_Antrodoco_REC_Mapping_Dataset__PV_number"/>
        <schema1:variableMeasured rdf:resource="https://ontology.energy-guard.eu/engreen#The_Antrodoco_REC_Mapping_Dataset__PV_power"/>
        <schema1:variableMeasured rdf:resource="https://ontology.energy-guard.eu/engreen#The_Antrodoco_REC_Mapping_Dataset__PV_tilt"/>
        <schema1:variableMeasured rdf:resource="https://ontology.energy-guard.eu/engreen#The_Antrodoco_REC_Mapping_Dataset__Piattaforma"/>
        <schema1:variableMeasured rdf:resource="https://ontology.energy-guard.eu/engreen#The_Antrodoco_REC_Mapping_Dataset__Pinv"/>
        <schema1:variableMeasured rdf:resource="https://ontology.energy-guard.eu/engreen#The_Antrodoco_REC_Mapping_Dataset__Potenza_di_contratto_impegnata_kW"/>
        <schema1:variableMeasured rdf:resource="https://ontology.energy-guard.eu/engreen#The_Antrodoco_REC_Mapping_Dataset__Pplant"/>
        <schema1:variableMeasured rdf:resource="https://ontology.energy-guard.eu/engreen#The_Antrodoco_REC_Mapping_Dataset__Ruolo_utente"/>
        <schema1:variableMeasured rdf:resource="https://ontology.energy-guard.eu/engreen#The_Antrodoco_REC_Mapping_Dataset__Sistemi_rilevazioni_dati"/>
        <schema1:variableMeasured rdf:resource="https://ontology.energy-guard.eu/engreen#The_Antrodoco_REC_Mapping_Dataset__Storage"/>
        <schema1:variableMeasured rdf:resource="https://ontology.energy-guard.eu/engreen#The_Antrodoco_REC_Mapping_Dataset__Storage_cap"/>
        <schema1:variableMeasured rdf:resource="https://ontology.energy-guard.eu/engreen#The_Antrodoco_REC_Mapping_Dataset__Storage_installation_year"/>
        <schema1:variableMeasured rdf:resource="https://ontology.energy-guard.eu/engreen#The_Antrodoco_REC_Mapping_Dataset__Storage_model"/>
        <schema1:variableMeasured rdf:resource="https://ontology.energy-guard.eu/engreen#The_Antrodoco_REC_Mapping_Dataset__Tipologia_utente"/>
        <schema1:variableMeasured rdf:resource="https://ontology.energy-guard.eu/engreen#The_Antrodoco_REC_Mapping_Dataset__not_in_source_file"/>
        <csvw:null>Empty cell = not applicable or not available (e.g. no PV plant or no battery)</csvw:null>
      </dcat:Dataset>
    </dcat:dataset>
    <dcat:dataset>
      <dcat:Dataset rdf:about="https://ontology.energy-guard.eu/engreen#Dataset_The_GSE_Historical_Metering_Dataset">
        <dcterms:accessRights rdf:resource="http://publications.europa.eu/resource/authority/access-right/RESTRICTED"/>
        <dcterms:description xml:lang="en">Hourly metering data of the REC metering points retrieved from the GSE (Gestore dei Servizi Energetici) platform, which ENGREEN accesses as REC operator. It consists of three files with the same structure: grid withdrawal (consumption points), grid injection and energy production (production units). It is used for historical analysis, baseline definition, load-profile reconstruction and Digital Twin calibration. System covered: Grid withdrawal, grid injection and PV production of the REC metering points. Source: GSE platform (official metering data), manual export.</dcterms:description>
        <dcterms:format>XLSX source files, one sheet each: Withdrawn_Energy, Fed-In_Energy, Produced_Energy; decimal point. Uploaded to the EnergyGuard Data Lake as CSV.</dcterms:format>
        <dcterms:license rdf:resource="https://creativecommons.org/licenses/by/4.0/"/>
        <dcterms:publisher rdf:resource="https://ontology.energy-guard.eu/pilots#ENGREEN"/>
        <dcterms:spatial rdf:resource="https://ontology.energy-guard.eu/engreen#Place_The_GSE_Historical_Metering_Dataset"/>
        <dcterms:temporal rdf:resource="https://ontology.energy-guard.eu/engreen#Period_The_GSE_Historical_Metering_Dataset"/>
        <dcterms:title xml:lang="en">The GSE Historical Metering Dataset</dcterms:title>
        <schema1:variableMeasured rdf:resource="https://ontology.energy-guard.eu/engreen#The_GSE_Historical_Metering_Dataset__Codice_Misura"/>
        <schema1:variableMeasured rdf:resource="https://ontology.energy-guard.eu/engreen#The_GSE_Historical_Metering_Dataset__Data"/>
        <schema1:variableMeasured rdf:resource="https://ontology.energy-guard.eu/engreen#The_GSE_Historical_Metering_Dataset__Ora"/>
        <schema1:variableMeasured rdf:resource="https://ontology.energy-guard.eu/engreen#The_GSE_Historical_Metering_Dataset__kWh"/>
        <csvw:null>No explicit marker; missing periods = absent rows (availability varies by metering point)</csvw:null>
        <dcat:temporalResolution rdf:datatype="http://www.w3.org/2001/XMLSchema#duration">PT1H</dcat:temporalResolution>
        <eg:timeZone>Italian local time with daylight saving time. Hour 0–23 = start of the hour.</eg:timeZone>
      </dcat:Dataset>
    </dcat:dataset>
    <dcat:dataset>
      <dcat:Dataset rdf:about="https://ontology.energy-guard.eu/engreen#Dataset_The_Weather_Dataset">
        <dcterms:accrualPeriodicity rdf:resource="http://publications.europa.eu/resource/authority/frequency/NEVER"/>
        <dcterms:description xml:lang="en">Hourly meteorological and solar radiation data for the Antrodoco area from the Open-Meteo historical weather API, extracted for a single reference point covering the REC (no coordinates of individual installations are processed). It is used to model PV production, interpret consumption patterns and analyse abnormal asset behaviour. System covered: Local weather and solar radiation conditions. Source: Open-Meteo Historical Weather API (weather model data).</dcterms:description>
        <dcterms:format>CSV, comma, decimal point. Two header lines with location metadata (latitude, longitude, elevation, UTC offset, time zone), an empty line, then column names. Uploaded to the EnergyGuard Data Lake as CSV.</dcterms:format>
        <dcterms:license rdf:resource="https://creativecommons.org/licenses/by/4.0/"/>
        <dcterms:publisher rdf:resource="https://ontology.energy-guard.eu/pilots#ENGREEN"/>
        <dcterms:spatial rdf:resource="https://ontology.energy-guard.eu/engreen#Place_The_Weather_Dataset"/>
        <dcterms:temporal rdf:resource="https://ontology.energy-guard.eu/engreen#Period_The_Weather_Dataset"/>
        <dcterms:title xml:lang="en">The Weather Dataset</dcterms:title>
        <schema1:variableMeasured rdf:resource="https://ontology.energy-guard.eu/engreen#The_Weather_Dataset__cloud_cover"/>
        <schema1:variableMeasured rdf:resource="https://ontology.energy-guard.eu/engreen#The_Weather_Dataset__diffuse_radiation_W_m2"/>
        <schema1:variableMeasured rdf:resource="https://ontology.energy-guard.eu/engreen#The_Weather_Dataset__direct_normal_irradiance_W_m2"/>
        <schema1:variableMeasured rdf:resource="https://ontology.energy-guard.eu/engreen#The_Weather_Dataset__shortwave_radiation_W_m2"/>
        <schema1:variableMeasured rdf:resource="https://ontology.energy-guard.eu/engreen#The_Weather_Dataset__temperature_2m_C"/>
        <schema1:variableMeasured rdf:resource="https://ontology.energy-guard.eu/engreen#The_Weather_Dataset__wind_speed_10m_km_h"/>
        <csvw:null>Empty cell = value not available</csvw:null>
        <dcat:temporalResolution rdf:datatype="http://www.w3.org/2001/XMLSchema#duration">PT1H</dcat:temporalResolution>
        <eg:storedInDatabaseTable>public.f_tsdata</eg:storedInDatabaseTable>
        <eg:timeZone>Local time as returned by Open-Meteo; time zone and UTC offset are reported in the file header</eg:timeZone>
      </dcat:Dataset>
    </dcat:dataset>
