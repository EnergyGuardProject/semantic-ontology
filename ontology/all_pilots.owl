  <sosa:Sensor rdf:about="https://ontology.energy-guard.eu/engreen#Operational_monitoring_dataset__Total_yield_kWh">
    <dcterms:description xml:lang="en">Cumulative AC energy yield of the inverter</dcterms:description>
    <dcterms:identifier>Pseudonymised inverter code</dcterms:identifier>
    <qudt:hasUnit rdf:resource="http://qudt.org/vocab/unit/KiloW-HR"/>
    <rdf:type rdf:resource="https://ontology.energy-guard.eu/core#Variable"/>
    <rdfs:label xml:lang="en">Total PV Yield</rdfs:label>
    <skos:note xml:lang="en">Valid range: ≥ 0, non-decreasing</skos:note>
    <skos:note>cumulative (lifetime)</skos:note>
    <csvw:name>Total yield(kWh)</csvw:name>
    <sosa:isHostedBy rdf:resource="https://ontology.energy-guard.eu/engreen#Platform_Inverter"/>
    <sosa:observes>
      <skos:Concept rdf:about="https://ontology.energy-guard.eu/property#Energy">
        <qudt:hasQuantityKind rdf:resource="http://qudt.org/vocab/quantitykind/Energy"/>
        <rdf:type rdf:resource="http://www.w3.org/ns/sosa/ObservableProperty"/>
        <skos:definition xml:lang="en">Energy values (Wh, kWh, MWh): consumed, produced or cumulative.</skos:definition>
        <skos:inScheme rdf:resource="https://ontology.energy-guard.eu/core#MeasurementTypeScheme"/>
        <skos:prefLabel xml:lang="en">Energy</skos:prefLabel>
      </skos:Concept>
    </sosa:observes>
    <eg:aggregation>cumulative</eg:aggregation>
    <eg:dataLakeSensorPattern>%\_total\_cap</eg:dataLakeSensorPattern>
    <eg:dataType>float</eg:dataType>
  </sosa:Sensor>
