  <eg:Variable rdf:about="https://ontology.energy-guard.eu/rea#Territorial_zones_for_the_selection_of_the_type_of_heat_supply__zona">
    <dcterms:description xml:lang="en">I zona – atļauta tikai centralizētā vai bezemisiju siltumapgāde; aizliegts cietais un gāzveida kurināmais. II zona – aizliegts cietais kurināmais; prioritāte bezemisiju risinājumiem, tad gāze. III zona – atļauti visi risinājumi; priekšroka bezemisiju un centralizētai siltumapgādei.</dcterms:description>
    <rdfs:label xml:lang="en">zone</rdfs:label>
    <csvw:format>one of I / II / III</csvw:format>
    <csvw:name>zona</csvw:name>
    <eg:dataType>text</eg:dataType>
    <eg:storedInDatabaseColumn>zona</eg:storedInDatabaseColumn>
  </eg:Variable>
