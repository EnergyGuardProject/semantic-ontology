<https://www.energyguard.eu/ontology/cartif#Dataset_CARTIF_hydrogen_test_bench_operational_data_15_s> a dcat:Dataset ;
    dcterms:accessRights <http://publications.europa.eu/resource/authority/access-right/RESTRICTED> ;
    dcterms:description "Original PLC/SCADA operational time-series export from the CARTIF hydrogen test bench, covering the hydrogen generation, storage and energy conversion equipment and associated monitoring and control signals. The dataset is provided for internal use within the EnergyGuard consortium. System covered: Hydrogen test bench, including electrolyser, fuel cell, metal-hydride hydrogen storage, electrical batteries and thermal auxiliaries. Source: Hydrogen test bench PLC/SCADA."@en ;
    dcterms:format "CSV" ;
    dcterms:license <https://www.energyguard.eu/ontology/cartif#Licence_CARTIF_hydrogen_test_bench_operational_data_15_s> ;
    dcterms:publisher mp:CARTIF ;
    dcterms:spatial <https://www.energyguard.eu/ontology/cartif#Place_CARTIF_hydrogen_test_bench_operational_data_15_s> ;
    dcterms:temporal <https://www.energyguard.eu/ontology/cartif#Period_CARTIF_hydrogen_test_bench_operational_data_15_s> ;
    dcterms:title "CARTIF hydrogen test bench operational data (15 s)"@en ;
    schema1:variableMeasured <https://www.energyguard.eu/ontology/cartif#ALTA_PRESION_MH1_Alarm>,
        <https://www.energyguard.eu/ontology/cartif#ALTA_PRESION_MH2_Alarm>,
        <https://www.energyguard.eu/ontology/cartif#ALTA_TEMP_MH1_Alarm>,
