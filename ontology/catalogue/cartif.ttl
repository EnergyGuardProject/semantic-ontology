cartif:Dataset_CARTIF_hydrogen_test_bench_operational_data_15_s a dcat:Dataset ;
    dcterms:accessRights <http://publications.europa.eu/resource/authority/access-right/RESTRICTED> ;
    dcterms:description "Original PLC/SCADA operational time-series export from the CARTIF hydrogen test bench, covering the hydrogen generation, storage and energy conversion equipment and associated monitoring and control signals. The dataset is provided for internal use within the EnergyGuard consortium. System covered: Hydrogen test bench, including electrolyser, fuel cell, metal-hydride hydrogen storage, electrical batteries and thermal auxiliaries. Source: Hydrogen test bench PLC/SCADA."@en ;
    dcterms:format "CSV" ;
    dcterms:license cartif:Licence_CARTIF_hydrogen_test_bench_operational_data_15_s ;
    dcterms:publisher mp:CARTIF ;
    dcterms:spatial cartif:Place_CARTIF_hydrogen_test_bench_operational_data_15_s ;
    dcterms:temporal cartif:Period_CARTIF_hydrogen_test_bench_operational_data_15_s ;
    dcterms:title "CARTIF hydrogen test bench operational data (15 s)"@en ;
    schema:variableMeasured cartif:ALTA_PRESION_MH1_Alarm,
        cartif:ALTA_PRESION_MH2_Alarm,
        cartif:ALTA_TEMP_MH1_Alarm,
        cartif:ALTA_TEMP_MH2_Alarm,
        cartif:BAJA_TEMP_MH1_Alarm,
        cartif:BAJA_TEMP_MH2_Alarm,
        cartif:BATA_Current,
        cartif:BATA_SOC,
        cartif:BATA_Voltage,
        cartif:BATB_Current,
        cartif:BATB_SOC,
        cartif:BATB_Voltage,
        cartif:BATERIAS_Alarm,
        cartif:BATERIAS_War,
        cartif:BAT_CURR_BATSTATE,
        cartif:BMHEMPTY_War,
        cartif:BMHFULL_War,
        cartif:Dryer_State,
        cartif:ELECTROLIZADOR_Alarm,
        cartif:ELECTROLIZADOR_War,
        cartif:ELE_Current,
        cartif:ELE_H2_Flow_Rate,
        cartif:ELE_Inner_H2_Pressure,
        cartif:ELE_Outer_H2_Pressure,
        cartif:ELE_Stack_Voltage,
        cartif:ELE_State,
        cartif:ELE_water,
        cartif:EL_preheat,
        cartif:EL_temp,
        cartif:FC_Alarm,
        cartif:FC_Current,
        cartif:FC_State,
        cartif:FC_Voltage,
        cartif:FC_War,
        cartif:FC_flow_Rate,
        cartif:FC_temp,
        cartif:Fan_State,
        cartif:GENERAL_Alarm,
        cartif:GENERAL_War,
        cartif:HP_ON,
        cartif:HP_elect_pow,
        cartif:HP_evap_flow,
        cartif:HP_evap_pow,
        cartif:HP_evap_t_in,
        cartif:HP_evap_t_out,
        cartif:Heater_State,
        cartif:MH1_Active,
        cartif:MH1_Empty,
        cartif:MH1_Full,
        cartif:MH1_H,
        cartif:MH1_L,
        cartif:MH1_accumulated_H2_NL,
        cartif:MH2_Active,
        cartif:MH2_Empty,
        cartif:MH2_Full,
        cartif:MH2_H,
        cartif:MH2_L,
        cartif:MH2_accumulated_H2_NL,
        cartif:MH_SOC,
        cartif:MV3C101_State,
        cartif:MV3C103_State,
        cartif:MV3C105_State,
        cartif:MV3C108_State,
        cartif:MV3C109_State,
        cartif:PEM_ON_OFF,
        cartif:POT_BAT,
        cartif:POT_ELE,
        cartif:POT_PILA,
        cartif:PRED,
        cartif:PTH401,
        cartif:PTH403,
        cartif:PTH404,
        cartif:Pump_State,
        cartif:Purging_MH1,
        cartif:Purging_MH2,
        cartif:Resistor_Pow,
        cartif:Resistor_SP,
        cartif:SV2H208_State,
        cartif:SV2H303_State,
        cartif:SV2H405_State,
        cartif:SV2H406_State,
        cartif:SYS,
        cartif:TERMICO_Alarm,
        cartif:TERMICO_War,
        cartif:TT102,
        cartif:TT107,
        cartif:TT111,
        cartif:TT113,
        cartif:TT114,
        cartif:timestamp_var ;
    csvw:null "No missing values after the first available observation of each documented signal; some signals have no records before their initial availability." ;
    dcat:temporalResolution "PT15S"^^xsd:duration ;
    eg:storedInDatabaseTable "public.f_tsdata" ;
    eg:timeZone "UTC" .

cartif:ALTA_PRESION_MH1_Alarm a eg:Variable ;
    rdfs:label "ALTA_PRESION_MH1_Alarm"@en ;
    dcterms:description "Alarm signal indicating high pressure in metal hydride tank 1"@en ;
    schema:maxValue 1.0 ;
    schema:minValue 0.0 ;
    sosa:isHostedBy cartif:Platform_Metal_hydride_storage ;
    sosa:observes prop:State ;
    eg:codeList "0 / 1" ;
    eg:dataLakeSensorId "ALTA_PRESION_MH1_Alarm" ;
    eg:dataType "integer" ;
    eg:variableKind "alarm" .

