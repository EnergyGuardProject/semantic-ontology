        <https://www.energyguard.eu/ontology/cartif#timestamp_var> ;
    skos:note "Update frequency: Periodically updated with new PLC/SCADA data; acquisition every 15 s."@en ;
    csvw:null "No missing values after the first available observation of each documented signal; some signals have no records before their initial availability." ;
    dcat:distribution <https://www.energyguard.eu/ontology/cartif#Distribution_CARTIF_hydrogen_test_bench_operational_data_15_s> ;
    dcat:temporalResolution "PT15S"^^xsd:duration ;
    eg:timeZone "UTC" .

<https://www.energyguard.eu/ontology/cartif#ALTA_PRESION_MH1_Alarm> a eg:Variable ;
    rdfs:label "ALTA_PRESION_MH1_Alarm"@en ;
    dcterms:description "Alarm signal indicating high pressure in metal hydride tank 1"@en ;
    dcterms:type "Status" ;
    schema1:maxValue 1.0 ;
    schema1:minValue 0.0 ;
    sosa:isHostedBy <https://www.energyguard.eu/ontology/cartif#Platform_Metal_hydride_storage> ;
    eg:aggregation "none" ;
    eg:codeList "0 / 1" ;
    eg:dataLakeMatch "exact" ;
    eg:dataLakeSensorId "ALTA_PRESION_MH1_Alarm" ;
    eg:dataType "integer" ;
    eg:relatesToProperty prop:State ;
    eg:variableKind "alarm" .

