<https://www.energyguard.eu/ontology/cartif#Dryer_State> a eg:Variable ;
    rdfs:label "Dryer_State"@en ;
    dcterms:description "Dryer status"@en ;
    dcterms:type "PLC/Modbus input register 14 (source signal; physical sensor type not specified)" ;
    skos:note "Valid range: 257, 259, 260, 262, 263, 265, 1281, 2305, 2561"@en ;
    sosa:isHostedBy <https://www.energyguard.eu/ontology/cartif#Platform_Electrolyser> ;
    eg:aggregation "none" ;
    eg:codeList "257 = Waiting for power; 259 = Stopped by user; 260 = Starting; 262 = Standby (excess pressure); 263 = Waiting for pressure; 265 = Idle; 1281 = Error; 2305 = Maintenance mode; 2561 = Expert mode" ;
    eg:dataLakeMatch "exact" ;
    eg:dataLakeSensorId "Dryer_State" ;
    eg:dataType "float" ;
    eg:relatesToProperty prop:State ;
    eg:variableKind "state" .

