@prefix dcat: <http://www.w3.org/ns/dcat#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix eg: <https://www.energyguard.eu/ontology#> .
@prefix mp: <https://www.energyguard.eu/ontology/merged-pilots#> .

# The single entry point: one DCAT catalogue holding every dataset of every pilot.
# Generated from the dataset list; when a dataset is added to a pilot file, add its IRI here too.
mp:EnergyGuardCatalogue a dcat:Catalog ;
    dcterms:title "EnergyGuard data catalogue"@en ;
    dcterms:description "Catalogue of the datasets delivered by the EnergyGuard pilots and where each is stored in the EnergyGuard data lake."@en ;
    dcat:service eg:DataLakeService ;
    dcat:dataset
<https://www.energyguard.eu/ontology/ber#Dataset_PEM_Electrolyzer_14kW>,
        <https://www.energyguard.eu/ontology/ber#Dataset_PEM_Electrolyzer_7kW>,
        <https://www.energyguard.eu/ontology/cartif#Dataset_CARTIF_hydrogen_test_bench_operational_data_15_s>,
