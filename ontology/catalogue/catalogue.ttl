@prefix rdn: <https://ontology.energy-guard.eu/rdn#> .
@prefix rea: <https://ontology.energy-guard.eu/rea#> .

mp:EnergyGuardCatalogue a dcat:Catalog ;
    dcterms:description "Catalogue of the datasets delivered by the EnergyGuard pilots. The numbers themselves are stored in the EnergyGuard data lake (PostgreSQL, operated by CARTIF, one database per pilot); each dataset names its database and table. The host address is not published."@en ;
    dcterms:title "EnergyGuard data catalogue"@en ;
    dcat:dataset ber:Dataset_PEM_Electrolyzer_14kW,
        ber:Dataset_PEM_Electrolyzer_7kW,
        cartif:Dataset_CARTIF_hydrogen_test_bench_operational_data_15_s,
        cea:Dataset_CEA_MURPHY_test_bed_dataset,
        ciemat:Dataset_CEDER_CIEMAT_Microgrid_Daily_Operational_Data_1_s,
        engreen:Dataset_GME_CSUD_Hourly_Electricity_Price_Dataset,
        engreen:Dataset_Operational_monitoring_dataset,
        engreen:Dataset_Shelly_consumer_monitoring_dataset,
        engreen:Dataset_The_Antrodoco_REC_Mapping_Dataset,
        engreen:Dataset_The_GSE_Historical_Metering_Dataset,
        engreen:Dataset_The_Weather_Dataset,
        rdn:Dataset_Customer_information,
        rdn:Dataset_Electrical_network_characteristics,
        rdn:Dataset_Network_Topology,
        rdn:Dataset_Solar_PV_information,
        rdn:Dataset_power_flow_simulation_results,
        rea:Dataset_3D_GEOMETRY_LOD1_LOD2,
        rea:Dataset_Air_quality,
        rea:Dataset_Air_temperature,
        rea:Dataset_Borders_of_Riga_and_Riga_suburbs_A_Riga_border,
        rea:Dataset_Borders_of_Riga_and_Riga_suburbs_B_Riga_suburb_borders,
        rea:Dataset_Building_and_heating_consumption_data_Heating_2017_2024_xlsx,
        rea:Dataset_Building_energy_certificates_SCCB_Open_Data_Portal,
        rea:Dataset_Building_energy_performance_certificate_factors_and_CO2_coefficients,
        rea:Dataset_Buildings_in_the_administrative_territory_of_Riga_A_Existing_buildings,
        rea:Dataset_Buildings_in_the_administrative_territory_of_Riga_B_Demolished_buildings,
        rea:Dataset_Buildings_monthly_heat_series_ARCGIS_Server,
        rea:Dataset_EPC_data_from_energy_audits_pdfs_bis_files_BIS_Format_for_year_2018,
        rea:Dataset_EPC_data_from_energy_audits_pdfs_bis_files_BIS_Format_for_year_2019,
        rea:Dataset_Energy_efficiency_indicators_for_heating_of_multi_apartment_buildings_in_Riga,
        rea:Dataset_Energy_performance_of_renovated_buildings,
        rea:Dataset_Environmentally_degrading_buildings,
        rea:Dataset_Humidity,
        rea:Dataset_List_of_state_buildings,
        rea:Dataset_Meteorological_data,
        rea:Dataset_Noise_levels,
        rea:Dataset_Riga_neighborhoods,
        rea:Dataset_Riga_series_results,
        rea:Dataset_Riga_streets_and_addresses_A_streets,
        rea:Dataset_Riga_streets_and_addresses_B_addresses,
        rea:Dataset_Territorial_zones_for_the_selection_of_the_type_of_heat_supply .

