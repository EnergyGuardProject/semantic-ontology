<https://www.energyguard.eu/ontology/cea#I_stack01_mes> a sosa:Sensor,
        eg:Variable ;
    rdfs:label "I_stack01_mes"@en ;
    dcterms:description "Measured current applied on the stack 1"@en ;
    dcterms:identifier "I_stack01_mes" ;
    dcterms:type "Current" ;
    qudt:hasUnit <http://qudt.org/vocab/unit/A> ;
    schema1:maxValue 200.0 ;
    schema1:minValue 0.0 ;
    sosa:observes prop:Current ;
    eg:aggregation "instantaneous" ;
    eg:dataLakeEvidence "Values -74..0 A match 'Measured current applied on the stack 1'. cns_I_stack01 is the command (setpoint)."@en ;
    eg:dataLakeMatch "inferred" ;
    eg:dataLakeSensorId "Istack01" ;
    eg:dataType "float" ;
    eg:variableKind "measured" .

