<https://www.energyguard.eu/ontology/cea#AT231> a sosa:Sensor,
        eg:Variable ;
    rdfs:label "AT231"@en ;
    dcterms:description "Humidity of the gaz at the input of the heat exchanger M-E-HH-01"@en ;
    dcterms:type "Composition" ;
    qudt:hasUnit <http://qudt.org/vocab/unit/PERCENT> ;
    schema1:maxValue 100.0 ;
    schema1:minValue 0.0 ;
    sosa:observes prop:Composition ;
    eg:aggregation "instantaneous" ;
    eg:dataLakeMatch "exact" ;
    eg:dataLakeSensorId "AT231" ;
    eg:dataType "float" ;
    eg:variableKind "measured" .

