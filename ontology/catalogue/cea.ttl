        <https://www.energyguard.eu/ontology/cea#FT413>,
        <https://www.energyguard.eu/ontology/cea#FT417>,
        <https://www.energyguard.eu/ontology/cea#FT421>,
        <https://www.energyguard.eu/ontology/cea#I_stack01_mes>,
        <https://www.energyguard.eu/ontology/cea#I_stack02_mes>,
        <https://www.energyguard.eu/ontology/cea#I_stack03_mes>,
        <https://www.energyguard.eu/ontology/cea#I_stack04_mes>,
        <https://www.energyguard.eu/ontology/cea#M_K_O_04>,
        <https://www.energyguard.eu/ontology/cea#M_R_B_01>,
        <https://www.energyguard.eu/ontology/cea#M_R_B_02>,
        <https://www.energyguard.eu/ontology/cea#M_R_B_03>,
