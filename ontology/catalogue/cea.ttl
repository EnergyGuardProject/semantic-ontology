cea:Dataset_CEA_MURPHY_test_bed_dataset a dcat:Dataset ;
    dcterms:accrualPeriodicity <http://publications.europa.eu/resource/authority/frequency/NEVER> ;
    dcterms:description "Operating data of a high temperature electrolyzer system. System covered: Solid Oxide Cells eletrolyzer system. Source: PLC."@en ;
    dcterms:format "CSV" ;
    dcterms:publisher mp:CEA ;
    dcterms:spatial cea:Place_CEA_MURPHY_test_bed_dataset ;
    dcterms:temporal cea:Period_CEA_MURPHY_test_bed_dataset ;
    dcterms:title "CEA MURPHY test bed dataset"@en ;
    schema:variableMeasured cea:AT231,
        cea:AT312,
        cea:AT361,
        cea:AT416,
        cea:DPT202,
        cea:DPT207,
        cea:DPT213,
        cea:DPT311,
        cea:DPT401,
        cea:DPT411,
        cea:FT101,
        cea:FT102,
        cea:FT104,
        cea:FT221,
        cea:FT232,
        cea:FT237,
        cea:FT405,
        cea:FT412,
        cea:FT413,
        cea:FT417,
        cea:FT421,
        cea:I_stack01_mes,
        cea:I_stack02_mes,
        cea:I_stack03_mes,
        cea:I_stack04_mes,
        cea:M_K_O_04,
        cea:M_R_B_01,
        cea:M_R_B_02,
        cea:M_R_B_03,
        cea:M_R_H_01,
        cea:M_R_O_01,
        cea:PT110,
        cea:PT112,
        cea:PT204,
        cea:PT211,
        cea:PT217,
        cea:PT220,
        cea:PT241,
        cea:PT305,
        cea:PT306,
        cea:PT353,
        cea:PT354,
        cea:PT407,
        cea:PT418,
        cea:time ;
    dcat:temporalResolution "PT1M"^^xsd:duration ;
    eg:storedInDatabaseTable "public.f_tsdata" ;
    eg:timeZone "CET" .

cea:AT231 a sosa:Sensor,
        eg:Variable ;
    rdfs:label "AT231"@en ;
    dcterms:description "Humidity of the gaz at the input of the heat exchanger M-E-HH-01"@en ;
    qudt:hasUnit unit:PERCENT ;
    schema:maxValue 100.0 ;
    schema:minValue 0.0 ;
    sosa:observes prop:Composition ;
    eg:dataLakeSensorId "AT231" ;
    eg:dataType "float" .

cea:AT312 a sosa:Sensor,
        eg:Variable ;
    rdfs:label "AT312"@en ;
    dcterms:description "Oxygen concentration inside of the hotbox"@en ;
    qudt:hasUnit unit:PERCENT ;
    schema:maxValue 25.0 ;
    schema:minValue 5.0 ;
    sosa:observes prop:Composition ;
    eg:dataLakeSensorId "AT312" ;
    eg:dataType "float" .

cea:AT361 a sosa:Sensor,
        eg:Variable ;
    rdfs:label "AT361"@en ;
    dcterms:description "H2 concentration in the BoP flushed gaz"@en ;
    qudt:hasUnit unit:PERCENT ;
    schema:maxValue 100.0 ;
    schema:minValue 0.0 ;
    sosa:observes prop:Composition ;
    eg:dataLakeSensorId "AT361" ;
    eg:dataType "float" .

cea:AT416 a sosa:Sensor,
        eg:Variable ;
    rdfs:label "AT416"@en ;
