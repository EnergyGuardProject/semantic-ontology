    qudt:hasUnit unit:PERCENT ;
    schema:maxValue 25.0 ;
    schema:minValue 5.0 ;
    sosa:observes prop:Composition ;
    eg:dataLakeSensorId "AT416" ;
    eg:dataType "float" .

