    eg:aggregation "instantaneous" ;
    eg:dataLakeEvidence "Matched by name (the only NMC battery in the lake). Reads 0 W on the days checked."@en ;
    eg:dataLakeMatch "inferred" ;
    eg:dataLakeSensorId "BATERIA_NMC_PEPA_II" ;
    eg:dataType "integer" ;
    eg:signConvention "Positive values indicate charging; negative values indicate discharging" ;
    eg:variableKind "measured" .

