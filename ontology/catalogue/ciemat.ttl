    dcterms:description "Power associated with the LFP battery system"@en ;
    qudt:hasUnit <http://qudt.org/vocab/unit/W> ;
    skos:note "Valid range: Not enough variation to establish a range"@en ;
    sosa:isHostedBy <https://www.energyguard.eu/ontology/ciemat#Platform_LFP_battery_system> ;
