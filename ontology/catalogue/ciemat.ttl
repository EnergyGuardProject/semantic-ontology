<https://www.energyguard.eu/ontology/ciemat#Dataset_CEDER_CIEMAT_Microgrid_Daily_Operational_Data_1_s> a dcat:Dataset ;
    dcterms:accrualPeriodicity <http://publications.europa.eu/resource/authority/frequency/DAILY> ;
    dcterms:description "Operational data from the CEDER-CIEMAT microgrid in Soria, Spain. The dataset includes measurements from photovoltaic plants, wind turbines, electrical loads, battery storage systems and auxiliary equipment. It is collected for daily monitoring, operational analysis and the development and validation of intelligent energy management strategies. System covered: Microgrid operation, including photovoltaic plants, wind turbines, electrical consumption, energy storage systems and auxiliary equipment. Source: CEDER-CIEMAT microgrid monitoring and data acquisition system (SCADA / monitoring infrastructure)."@en ;
    dcterms:format "CSV, comma-separated, decimal point" ;
    dcterms:publisher mp:CIEMAT ;
    dcterms:spatial <https://www.energyguard.eu/ontology/ciemat#Place_CEDER_CIEMAT_Microgrid_Daily_Operational_Data_1_s> ;
    dcterms:temporal <https://www.energyguard.eu/ontology/ciemat#Period_CEDER_CIEMAT_Microgrid_Daily_Operational_Data_1_s> ;
    dcterms:title "CEDER-CIEMAT Microgrid – Daily Operational Data (1 s)"@en ;
    schema1:variableMeasured <https://www.energyguard.eu/ontology/ciemat#ACTARIS>,
        <https://www.energyguard.eu/ontology/ciemat#ARFRISOL>,
        <https://www.energyguard.eu/ontology/ciemat#ARFRISOL_consumption>,
        <https://www.energyguard.eu/ontology/ciemat#ATLANTIC>,
        <https://www.energyguard.eu/ontology/ciemat#BATERIA_LFP>,
        <https://www.energyguard.eu/ontology/ciemat#BATERIA_NMC>,
        <https://www.energyguard.eu/ontology/ciemat#BATERIA_PB_ACIDO_PEPA_I>,
        <https://www.energyguard.eu/ontology/ciemat#BATERIA_PB_ACIDO_PEPA_II>,
        <https://www.energyguard.eu/ontology/ciemat#BOMBAS>,
        <https://www.energyguard.eu/ontology/ciemat#CENTRAL_TERMICA>,
        <https://www.energyguard.eu/ontology/ciemat#DEPOSITO_NIVEL>,
        <https://www.energyguard.eu/ontology/ciemat#ED02_PV>,
        <https://www.energyguard.eu/ontology/ciemat#ED02_consumption>,
        <https://www.energyguard.eu/ontology/ciemat#ED03>,
        <https://www.energyguard.eu/ontology/ciemat#ED03_consumption>,
        <https://www.energyguard.eu/ontology/ciemat#ED09>,
        <https://www.energyguard.eu/ontology/ciemat#ENNERA_3_5>,
        <https://www.energyguard.eu/ontology/ciemat#GRUPO_DIESEL>,
        <https://www.energyguard.eu/ontology/ciemat#LECA_1>,
        <https://www.energyguard.eu/ontology/ciemat#LECA_2>,
        <https://www.energyguard.eu/ontology/ciemat#LEVI>,
        <https://www.energyguard.eu/ontology/ciemat#NED100>,
        <https://www.energyguard.eu/ontology/ciemat#PEPA_I>,
        <https://www.energyguard.eu/ontology/ciemat#PEPA_II>,
        <https://www.energyguard.eu/ontology/ciemat#PEPA_III>,
        <https://www.energyguard.eu/ontology/ciemat#PEPA_III_var>,
        <https://www.energyguard.eu/ontology/ciemat#PEPA_II_var>,
        <https://www.energyguard.eu/ontology/ciemat#RADIACION_SOLAR>,
        <https://www.energyguard.eu/ontology/ciemat#RIOS>,
        <https://www.energyguard.eu/ontology/ciemat#RYSE_E5>,
        <https://www.energyguard.eu/ontology/ciemat#SOLENER>,
        <https://www.energyguard.eu/ontology/ciemat#TURBINA_PV>,
        <https://www.energyguard.eu/ontology/ciemat#TURBINA_consumption>,
        <https://www.energyguard.eu/ontology/ciemat#TURBINA_hydro>,
        <https://www.energyguard.eu/ontology/ciemat#VIENTO_ESTACION>,
        <https://www.energyguard.eu/ontology/ciemat#VIENTO_PEPA_I>,
        <https://www.energyguard.eu/ontology/ciemat#WINDERA_4_2> ;
    skos:note "Update frequency: Cambiar por Daily updated CSV files"@en ;
    csvw:null "\\N – missing or unavailable measurement" ;
    dcat:distribution <https://www.energyguard.eu/ontology/ciemat#Distribution_CEDER_CIEMAT_Microgrid_Daily_Operational_Data_1_s> ;
    dcat:temporalResolution "PT1S"^^xsd:duration ;
    eg:timeZone "UTC" .

<https://www.energyguard.eu/ontology/ciemat#ACTARIS> a sosa:Sensor,
        eg:Variable ;
    rdfs:label "ACTARIS"@en ;
    dcterms:description "Total electrical power consumption of the CEDER site"@en ;
    dcterms:type "ACTARIS electrical meter" ;
    qudt:hasUnit <http://qudt.org/vocab/unit/W> ;
    skos:note "Valid range: -16,000 to +5,000 W approx."@en ;
    sosa:isHostedBy <https://www.energyguard.eu/ontology/ciemat#Platform_CEDER_CIEMAT_site_main_consumption_meter> ;
    sosa:observes prop:Power ;
    eg:aggregation "instantaneous" ;
    eg:dataLakeMatch "exact" ;
    eg:dataLakeSensorId "ACTARIS" ;
    eg:dataType "integer" ;
    eg:variableKind "measured" .

<https://www.energyguard.eu/ontology/ciemat#ARFRISOL> a sosa:Sensor,
        eg:Variable ;
    rdfs:label "ARFRISOL"@en ;
    dcterms:description "Photovoltaic power generated by the ARFRISOL building installation"@en ;
    dcterms:type "Inverter" ;
    qudt:hasUnit <http://qudt.org/vocab/unit/W> ;
    skos:note "Valid range: 0–6,000 W approx."@en ;
    sosa:isHostedBy <https://www.energyguard.eu/ontology/ciemat#Platform_ARFRISOL_building_PV_system> ;
    sosa:observes prop:Power ;
    eg:aggregation "instantaneous" ;
    eg:dataLakeEvidence "PV: 0 W at night, ~2 kW at noon (checked 2026-11-05). The lake's ARFRISOL is the consumption (19 kW at night)."@en ;
    eg:dataLakeMatch "inferred" ;
    eg:dataLakeSensorId "EDIFICIO_ARFRISOL" ;
    eg:dataType "integer" ;
    eg:variableKind "measured" .

<https://www.energyguard.eu/ontology/ciemat#ARFRISOL_consumption> a sosa:Sensor,
        eg:Variable ;
    rdfs:label "ARFRISOL [consumption]"@en ;
    dcterms:description "Electrical power consumed by the ARFRISOL Transfomer Station"@en ;
    dcterms:type "PQUBE Power meter" ;
    qudt:hasUnit <http://qudt.org/vocab/unit/W> ;
    skos:note "Valid range: 0–1,000 W approx."@en ;
    sosa:isHostedBy <https://www.energyguard.eu/ontology/ciemat#Platform_ARFRISOL_electrical_Transfomer_Station> ;
    sosa:observes prop:Power ;
    eg:aggregation "instantaneous" ;
    eg:dataLakeEvidence "Load: 19 kW at night, 12 kW at noon (checked 2026-11-05); EDIFICIO_ARFRISOL is the PV."@en ;
    eg:dataLakeMatch "inferred" ;
    eg:dataLakeSensorId "ARFRISOL" ;
    eg:dataType "integer" ;
    eg:variableKind "measured" .

<https://www.energyguard.eu/ontology/ciemat#ATLANTIC> a sosa:Sensor,
        eg:Variable ;
    rdfs:label "ATLANTIC"@en ;
    dcterms:description "Electrical power generated by the ATLANTIC wind turbine"@en ;
    dcterms:type "ATLANTIC Control System" ;
    qudt:hasUnit <http://qudt.org/vocab/unit/W> ;
