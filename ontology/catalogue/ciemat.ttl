ciemat:Dataset_CEDER_CIEMAT_Microgrid_Daily_Operational_Data_1_s a dcat:Dataset ;
    dcterms:accrualPeriodicity <http://publications.europa.eu/resource/authority/frequency/DAILY> ;
    dcterms:description "Operational data from the CEDER-CIEMAT microgrid in Soria, Spain. The dataset includes measurements from photovoltaic plants, wind turbines, electrical loads, battery storage systems and auxiliary equipment. It is collected for daily monitoring, operational analysis and the development and validation of intelligent energy management strategies. System covered: Microgrid operation, including photovoltaic plants, wind turbines, electrical consumption, energy storage systems and auxiliary equipment. Source: CEDER-CIEMAT microgrid monitoring and data acquisition system (SCADA / monitoring infrastructure)."@en ;
    dcterms:format "CSV, comma-separated, decimal point" ;
    dcterms:publisher mp:CIEMAT ;
    dcterms:spatial ciemat:Place_CEDER_CIEMAT_Microgrid_Daily_Operational_Data_1_s ;
    dcterms:temporal ciemat:Period_CEDER_CIEMAT_Microgrid_Daily_Operational_Data_1_s ;
    dcterms:title "CEDER-CIEMAT Microgrid – Daily Operational Data (1 s)"@en ;
    schema:variableMeasured ciemat:ACTARIS,
        ciemat:ARFRISOL,
        ciemat:ARFRISOL_consumption,
        ciemat:ATLANTIC,
        ciemat:BATERIA_LFP,
        ciemat:BATERIA_NMC,
        ciemat:BATERIA_PB_ACIDO_PEPA_I,
        ciemat:BATERIA_PB_ACIDO_PEPA_II,
        ciemat:BOMBAS,
        ciemat:CENTRAL_TERMICA,
        ciemat:DEPOSITO_NIVEL,
        ciemat:ED02_PV,
        ciemat:ED02_consumption,
        ciemat:ED03,
        ciemat:ED03_consumption,
        ciemat:ED09,
        ciemat:ENNERA_3_5,
        ciemat:GRUPO_DIESEL,
        ciemat:LECA_1,
        ciemat:LECA_2,
        ciemat:LEVI,
        ciemat:NED100,
        ciemat:PEPA_I,
        ciemat:PEPA_II,
        ciemat:PEPA_III,
        ciemat:PEPA_III_var,
        ciemat:PEPA_II_var,
        ciemat:RADIACION_SOLAR,
        ciemat:RIOS,
        ciemat:RYSE_E5,
        ciemat:SOLENER,
        ciemat:TURBINA_PV,
        ciemat:TURBINA_consumption,
        ciemat:TURBINA_hydro,
        ciemat:VIENTO_ESTACION,
        ciemat:VIENTO_PEPA_I,
        ciemat:WINDERA_4_2 ;
    csvw:null "\\N – missing or unavailable measurement" ;
    dcat:temporalResolution "PT1S"^^xsd:duration ;
    eg:storedInDatabaseTable "public.f_tsdata" ;
    eg:timeZone "UTC" .

ciemat:ACTARIS a sosa:Sensor,
        eg:Variable ;
    rdfs:label "ACTARIS"@en ;
    dcterms:description "Total electrical power consumption of the CEDER site"@en ;
    qudt:hasUnit unit:W ;
    skos:note "Valid range: -16,000 to +5,000 W approx."@en ;
    sosa:isHostedBy ciemat:Platform_CEDER_CIEMAT_site_main_consumption_meter ;
    sosa:observes prop:Power ;
    eg:dataLakeSensorId "ACTARIS" ;
    eg:dataType "integer" .

ciemat:ARFRISOL a sosa:Sensor,
        eg:Variable ;
    rdfs:label "ARFRISOL"@en ;
    dcterms:description "Photovoltaic power generated by the ARFRISOL building installation"@en ;
    qudt:hasUnit unit:W ;
    skos:note "Valid range: 0–6,000 W approx."@en ;
    sosa:isHostedBy ciemat:Platform_ARFRISOL_building_PV_system ;
    sosa:observes prop:Power ;
    eg:dataLakeSensorId "EDIFICIO_ARFRISOL" ;
    eg:dataType "integer" .

ciemat:ARFRISOL_consumption a sosa:Sensor,
        eg:Variable ;
    rdfs:label "ARFRISOL [consumption]"@en ;
    dcterms:description "Electrical power consumed by the ARFRISOL Transfomer Station"@en ;
    qudt:hasUnit unit:W ;
    skos:note "Valid range: 0–1,000 W approx."@en ;
    sosa:isHostedBy ciemat:Platform_ARFRISOL_electrical_Transfomer_Station ;
    sosa:observes prop:Power ;
    eg:dataLakeSensorId "ARFRISOL" ;
    eg:dataType "integer" .

ciemat:ATLANTIC a sosa:Sensor,
        eg:Variable ;
    rdfs:label "ATLANTIC"@en ;
    dcterms:description "Electrical power generated by the ATLANTIC wind turbine"@en ;
    qudt:hasUnit unit:W ;
    skos:note "Valid range: 0–9,000 W approx."@en ;
    sosa:isHostedBy ciemat:Platform_ATLANTIC_wind_turbine ;
    sosa:observes prop:Power ;
    eg:dataLakeSensorId "ATLANTIC" ;
    eg:dataType "integer" .

ciemat:BATERIA_LFP a sosa:Sensor,
        eg:Variable ;
    rdfs:label "BATERIA LFP"@en ;
    dcterms:description "Power associated with the LFP battery system"@en ;
    qudt:hasUnit unit:W ;
    skos:note "Valid range: Not enough variation to establish a range"@en ;
    sosa:isHostedBy ciemat:Platform_LFP_battery_system ;
    sosa:observes prop:Power ;
    eg:dataLakeSensorId "BATERIA_LITIO" ;
    eg:dataType "integer" ;
    eg:signConvention "Positive values indicate charging; negative values indicate discharging" .

ciemat:BATERIA_NMC a sosa:Sensor,
        eg:Variable ;
    rdfs:label "BATERIA NMC"@en ;
    dcterms:description "Power associated with the NMC battery system"@en ;
