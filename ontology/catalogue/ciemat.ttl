<https://www.energyguard.eu/ontology/ciemat#RADIACION_SOLAR> a sosa:Sensor,
        eg:Variable ;
    rdfs:label "RADIACION SOLAR"@en ;
    dcterms:description "Solar irradiance measured at the CEDER-CIEMAT microgrid"@en ;
    dcterms:type "Pyranometer" ;
    qudt:hasUnit <http://qudt.org/vocab/unit/W-PER-M2> ;
    skos:note "Valid range: 0–1,100 W/m² approx."@en ;
    sosa:isHostedBy <https://www.energyguard.eu/ontology/ciemat#Platform_Pyranometer_Solar_radiation_measurement_system> ;
    sosa:observes prop:SolarRadiation ;
    eg:aggregation "instantaneous" ;
    eg:dataLakeMatch "normalised" ;
    eg:dataLakeSensorId "RADIACION_SOLAR" ;
    eg:dataType "integer" ;
    eg:variableKind "measured" .

