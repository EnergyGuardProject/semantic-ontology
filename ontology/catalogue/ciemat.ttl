    skos:note "Valid range: 0–3,500 W approx."@en ;
    sosa:isHostedBy ciemat:Platform_NMC_battery_system ;
    sosa:observes prop:Power ;
    eg:dataLakeSensorId "BATERIA_NMC_PEPA_II" ;
    eg:dataType "integer" ;
    eg:signConvention "Positive values indicate charging; negative values indicate discharging" .

