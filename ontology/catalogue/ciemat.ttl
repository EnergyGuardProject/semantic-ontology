<https://www.energyguard.eu/ontology/ciemat#BATERIA_LFP> a sosa:Sensor,
        eg:Variable ;
    rdfs:label "BATERIA LFP"@en ;
    dcterms:description "Power associated with the LFP battery system"@en ;
    dcterms:type "Battery inverter" ;
    qudt:hasUnit <http://qudt.org/vocab/unit/W> ;
    skos:note "Valid range: Not enough variation to establish a range"@en ;
    sosa:isHostedBy <https://www.energyguard.eu/ontology/ciemat#Platform_LFP_battery_system> ;
    sosa:observes prop:Power ;
    eg:aggregation "instantaneous" ;
    eg:dataLakeEvidence "By elimination: the other lithium battery in the lake is the NMC one. Reads 0 W on the days checked."@en ;
    eg:dataLakeMatch "inferred" ;
    eg:dataLakeSensorId "BATERIA_LITIO" ;
    eg:dataType "integer" ;
    eg:signConvention "Positive values indicate charging; negative values indicate discharging" ;
    eg:variableKind "measured" .

<https://www.energyguard.eu/ontology/ciemat#BATERIA_NMC> a sosa:Sensor,
