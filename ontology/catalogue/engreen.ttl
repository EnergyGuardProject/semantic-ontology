<https://www.energyguard.eu/ontology/engreen#Shelly_consumer_monitoring_dataset__Consumo> a sosa:Sensor,
        eg:Variable ;
    rdfs:label "Consumption"@en ;
    dcterms:description "Energy consumed during the interval"@en ;
    dcterms:identifier "Pseudonymised meter code" ;
    qudt:hasUnit <http://qudt.org/vocab/unit/W-HR> ;
    skos:note "sum over the interval",
        "Valid range: ≥ 0"@en ;
    csvw:name "Consumo" ;
    sosa:isHostedBy <https://www.energyguard.eu/ontology/engreen#Platform_Household_connection_point> ;
    sosa:observes prop:Energy ;
    eg:aggregation "sum" ;
    eg:dataLakeSensorPattern "%\\_total\\_act\\_energy" ;
    eg:dataType "float" .

<https://www.energyguard.eu/ontology/engreen#Shelly_consumer_monitoring_dataset__Voltaggio_minimo> a sosa:Sensor,
        eg:Variable ;
    rdfs:label "Voltage"@en ;
    dcterms:description "Instantaneous voltage measured by the meter (channel 0) at the timestamp of the record"@en ;
    dcterms:identifier "Pseudonymised meter code" ;
    qudt:hasUnit <http://qudt.org/vocab/unit/V> ;
    skos:note "Valid range: about 180 – 250"@en ;
    csvw:name "Voltaggio minimo" ;
    sosa:isHostedBy <https://www.energyguard.eu/ontology/engreen#Platform_Household_connection_point> ;
    sosa:observes prop:Voltage ;
    eg:dataLakeSensorPattern "%\\_voltage" ;
    eg:dataType "float" .

