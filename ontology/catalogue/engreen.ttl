    rdfs:label "PV module"@en .

engreen:Platform_Power_sensor a sosa:Platform ;
    rdfs:label "Power sensor"@en .

engreen:Platform_Solar_radiation a sosa:Platform ;
    rdfs:label "Solar radiation"@en .

engreen:Platform_Weather a sosa:Platform ;
    rdfs:label "Weather"@en .

engreen:Platform_Metering_point a sosa:Platform ;
    rdfs:label "Metering point"@en .

engreen:Platform_REC_member a sosa:Platform ;
    rdfs:label "REC member"@en .

engreen:Platform_Inverter a sosa:Platform ;
    rdfs:label "Inverter"@en .

engreen:Platform_PV_plant a sosa:Platform ;
    rdfs:label "PV plant"@en .

