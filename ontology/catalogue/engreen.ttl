@prefix csvw: <http://www.w3.org/ns/csvw#> .
@prefix dcat: <http://www.w3.org/ns/dcat#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix eg: <https://www.energyguard.eu/ontology#> .
@prefix mp: <https://www.energyguard.eu/ontology/merged-pilots#> .
@prefix ns1: <http://www.w3.org/2003/01/geo/wgs84_pos#> .
@prefix prop: <https://www.energyguard.eu/ontology/property#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema1: <http://schema.org/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix sosa: <http://www.w3.org/ns/sosa/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://www.energyguard.eu/ontology/engreen#Dataset_GME_CSUD_Hourly_Electricity_Price_Dataset> a dcat:Dataset ;
    dcterms:accrualPeriodicity <http://publications.europa.eu/resource/authority/frequency/NEVER> ;
    dcterms:description "Hourly zonal electricity price of the Centro-Sud (CSUD) bidding zone of the Italian day-ahead market (MGP), published by GME (Gestore dei Mercati Energetici). It is the reference price used to value the electricity injected into the grid by REC members and to compute the economic indicators of the Digital Twin. System covered: Italian wholesale electricity market, day-ahead zonal prices. Source: GME market results (MGP zonal prices), open data."@en ;
    dcterms:format "XLSX, one sheet 'MGP-PrezziZonali-CSUD'; dates stored as text dd/mm/yyyy; decimal point. Uploaded to the EnergyGuard Data Lake as CSV." ;
    dcterms:license <https://www.energyguard.eu/ontology/engreen#Licence_GME_CSUD_Hourly_Electricity_Price_Dataset> ;
    dcterms:publisher mp:ENGREEN ;
    dcterms:spatial <https://www.energyguard.eu/ontology/engreen#Place_GME_CSUD_Hourly_Electricity_Price_Dataset> ;
    dcterms:temporal <https://www.energyguard.eu/ontology/engreen#Period_GME_CSUD_Hourly_Electricity_Price_Dataset> ;
    dcterms:title "GME CSUD Hourly Electricity Price Dataset"@en ;
    schema1:variableMeasured <https://www.energyguard.eu/ontology/engreen#GME_CSUD_Hourly_Electricity_Price_Dataset__Data>,
        <https://www.energyguard.eu/ontology/engreen#GME_CSUD_Hourly_Electricity_Price_Dataset__Ora>,
        <https://www.energyguard.eu/ontology/engreen#GME_CSUD_Hourly_Electricity_Price_Dataset__PZ_t> ;
    dcat:temporalResolution "PT1H"^^xsd:duration ;
    eg:timeZone "Italian local time with daylight saving time (GME convention: 23 hours on the spring change day, 25 on the autumn change day)" .

<https://www.energyguard.eu/ontology/engreen#Dataset_Operational_monitoring_dataset> a dcat:Dataset ;
    dcterms:accessRights <http://publications.europa.eu/resource/authority/access-right/RESTRICTED> ;
    dcterms:accrualPeriodicity <http://publications.europa.eu/resource/authority/frequency/DAILY> ;
    dcterms:description "Time series of the operating data of the PV plants, inverters, grid meters and batteries of the REC producers and prosumers, collected from the Huawei FusionSolar (10 plants) and Deye Solarman (1 municipal plant with battery) monitoring platforms. It is the real-time operational layer of the Digital Twin and supports PV performance analysis, battery operation analysis and anomaly detection. Only a selected subset of the variables available on the platforms is retained. System covered: PV plants, inverters, grid connection meters (power sensors) and battery storage systems. Source: Huawei FusionSolar and Deye Solarman cloud monitoring platforms (API and data export)."@en ;
    dcterms:format "XLSX source exports. FusionSolar: one file per device (inverter, power sensor or battery), four header rows (time range, export time, legend, column names); column names and decimal separator follow the portal language. Solarman: one file per plant, one header row, numeric values stored as text. Uploaded to the EnergyGuard Data Lake as CSV." ;
    dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
    dcterms:publisher mp:ENGREEN ;
    dcterms:spatial <https://www.energyguard.eu/ontology/engreen#Place_Operational_monitoring_dataset> ;
    dcterms:temporal <https://www.energyguard.eu/ontology/engreen#Period_Operational_monitoring_dataset> ;
    dcterms:title "Operational monitoring dataset"@en ;
    schema1:variableMeasured <https://www.energyguard.eu/ontology/engreen#Operational_monitoring_dataset__Active_power_W>,
        <https://www.energyguard.eu/ontology/engreen#Operational_monitoring_dataset__Active_power_kW>,
        <https://www.energyguard.eu/ontology/engreen#Operational_monitoring_dataset__Batteria_SOC>,
        <https://www.energyguard.eu/ontology/engreen#Operational_monitoring_dataset__Battery_Power_W>,
        <https://www.energyguard.eu/ontology/engreen#Operational_monitoring_dataset__Daily_energy_kWh>,
        <https://www.energyguard.eu/ontology/engreen#Operational_monitoring_dataset__Grid_Power_W>,
        <https://www.energyguard.eu/ontology/engreen#Operational_monitoring_dataset__Negative_active_energy_kWh>,
        <https://www.energyguard.eu/ontology/engreen#Operational_monitoring_dataset__Positive_active_energy_kWh>,
        <https://www.energyguard.eu/ontology/engreen#Operational_monitoring_dataset__Potenza_di_carica_e_scarica_kW>,
        <https://www.energyguard.eu/ontology/engreen#Operational_monitoring_dataset__Production_Power_W>,
        <https://www.energyguard.eu/ontology/engreen#Operational_monitoring_dataset__SoC>,
        <https://www.energyguard.eu/ontology/engreen#Operational_monitoring_dataset__Total_yield_kWh>,
        <https://www.energyguard.eu/ontology/engreen#Operational_monitoring_dataset__collectTime> ;
    csvw:null "FusionSolar: 'N/A' = not available or not recorded while the device was disconnected; '-' = counter not supported by the device. Solarman: empty cell = not applicable for the current flow direction or not available. Missing intervals = absent rows." ;
    dcat:temporalResolution "PT5M"^^xsd:duration ;
    eg:storedInDatabaseTable "public.f_tsdata" ;
    eg:timeZone "FusionSolar: Italian local time with daylight saving time (timestamps marked 'DST' in summer). Solarman: time zone given in the 'Time Zone' column (UTC+01:00, no daylight saving shift)." .

<https://www.energyguard.eu/ontology/engreen#Dataset_Shelly_consumer_monitoring_dataset> a dcat:Dataset ;
    dcterms:accessRights <http://publications.europa.eu/resource/authority/access-right/RESTRICTED> ;
    dcterms:accrualPeriodicity <http://publications.europa.eu/resource/authority/frequency/DAILY> ;
    dcterms:description "Electricity consumption and voltage data from Shelly energy meters installed by ENGREEN at five residential consumers of the REC, as a representative sample of demand-side behaviour. It complements the hourly GSE data with higher-resolution measurements and supports load-profile analysis, Digital Twin validation and demand-side modelling. System covered: Residential electricity consumption at the grid connection point (5 households). Source: Shelly energy meters, Shelly Cloud (API)."@en ;
    dcterms:format "CSV exported from Shelly Cloud, one file per meter and variable group: one block per variable (title row, header row 'Ore, <unit>'), comma separator, decimal point, timestamps dd/mm/yyyy hh:mm. Uploaded to the EnergyGuard Data Lake as CSV." ;
    dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
    dcterms:publisher mp:ENGREEN ;
    dcterms:spatial <https://www.energyguard.eu/ontology/engreen#Place_Shelly_consumer_monitoring_dataset> ;
    dcterms:temporal <https://www.energyguard.eu/ontology/engreen#Period_Shelly_consumer_monitoring_dataset> ;
    dcterms:title "Shelly consumer monitoring dataset"@en ;
    schema1:variableMeasured <https://www.energyguard.eu/ontology/engreen#Shelly_consumer_monitoring_dataset__Consumo>,
        <https://www.energyguard.eu/ontology/engreen#Shelly_consumer_monitoring_dataset__Voltaggio_minimo>,
        <https://www.energyguard.eu/ontology/engreen#Shelly_consumer_monitoring_dataset__collectTime> ;
    csvw:null "No explicit marker; missing intervals = absent rows" ;
    dcat:temporalResolution "PT15M"^^xsd:duration ;
    eg:storedInDatabaseTable "public.f_tsdata" ;
    eg:timeZone "Italian local time (Europe/Rome)" .

<https://www.energyguard.eu/ontology/engreen#Dataset_The_Antrodoco_REC_Mapping_Dataset> a dcat:Dataset ;
    dcterms:accessRights <http://publications.europa.eu/resource/authority/access-right/RESTRICTED> ;
    dcterms:accrualPeriodicity <http://publications.europa.eu/resource/authority/frequency/IRREG> ;
    dcterms:description "Static description of the members of the Antrodoco REC and of their energy assets: user role and type, GSE status, monitoring system, PV plant and battery characteristics and contracted power. It is the reference dataset that links each pseudonymised metering point to its technical characteristics and is used to build the REC Digital Twin. Names, addresses and geographical coordinates are not included; POD and CENSIMP codes are pseudonymised. System covered: REC members (consumers, producers, prosumers), PV plants and battery storage systems. Source: REC mapping compiled by ENGREEN as REC operator (membership data, GSE portal, plant documentation)."@en ;
    dcterms:format "XLSX source file (sheet 'Map' with data, sheet 'Legenda' with field rules), decimal point. Uploaded to the EnergyGuard Data Lake as CSV." ;
    dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
    dcterms:publisher mp:ENGREEN ;
    dcterms:spatial <https://www.energyguard.eu/ontology/engreen#Place_The_Antrodoco_REC_Mapping_Dataset> ;
    dcterms:temporal <https://www.energyguard.eu/ontology/engreen#Period_The_Antrodoco_REC_Mapping_Dataset> ;
    dcterms:title "The Antrodoco REC Mapping Dataset"@en ;
    schema1:variableMeasured <https://www.energyguard.eu/ontology/engreen#The_Antrodoco_REC_Mapping_Dataset__CENSIMP>,
        <https://www.energyguard.eu/ontology/engreen#The_Antrodoco_REC_Mapping_Dataset__Contributo_PNRR>,
        <https://www.energyguard.eu/ontology/engreen#The_Antrodoco_REC_Mapping_Dataset__Esente>,
        <https://www.energyguard.eu/ontology/engreen#The_Antrodoco_REC_Mapping_Dataset__GSE>,
        <https://www.energyguard.eu/ontology/engreen#The_Antrodoco_REC_Mapping_Dataset__Note>,
        <https://www.energyguard.eu/ontology/engreen#The_Antrodoco_REC_Mapping_Dataset__POD>,
        <https://www.energyguard.eu/ontology/engreen#The_Antrodoco_REC_Mapping_Dataset__PV_azimuth>,
        <https://www.energyguard.eu/ontology/engreen#The_Antrodoco_REC_Mapping_Dataset__PV_installation_year>,
        <https://www.energyguard.eu/ontology/engreen#The_Antrodoco_REC_Mapping_Dataset__PV_model>,
        <https://www.energyguard.eu/ontology/engreen#The_Antrodoco_REC_Mapping_Dataset__PV_number>,
        <https://www.energyguard.eu/ontology/engreen#The_Antrodoco_REC_Mapping_Dataset__PV_power>,
        <https://www.energyguard.eu/ontology/engreen#The_Antrodoco_REC_Mapping_Dataset__PV_tilt>,
        <https://www.energyguard.eu/ontology/engreen#The_Antrodoco_REC_Mapping_Dataset__Piattaforma>,
        <https://www.energyguard.eu/ontology/engreen#The_Antrodoco_REC_Mapping_Dataset__Pinv>,
        <https://www.energyguard.eu/ontology/engreen#The_Antrodoco_REC_Mapping_Dataset__Potenza_di_contratto_impegnata_kW>,
        <https://www.energyguard.eu/ontology/engreen#The_Antrodoco_REC_Mapping_Dataset__Pplant>,
        <https://www.energyguard.eu/ontology/engreen#The_Antrodoco_REC_Mapping_Dataset__Ruolo_utente>,
        <https://www.energyguard.eu/ontology/engreen#The_Antrodoco_REC_Mapping_Dataset__Sistemi_rilevazioni_dati>,
        <https://www.energyguard.eu/ontology/engreen#The_Antrodoco_REC_Mapping_Dataset__Storage>,
        <https://www.energyguard.eu/ontology/engreen#The_Antrodoco_REC_Mapping_Dataset__Storage_cap>,
        <https://www.energyguard.eu/ontology/engreen#The_Antrodoco_REC_Mapping_Dataset__Storage_installation_year>,
        <https://www.energyguard.eu/ontology/engreen#The_Antrodoco_REC_Mapping_Dataset__Storage_model>,
        <https://www.energyguard.eu/ontology/engreen#The_Antrodoco_REC_Mapping_Dataset__Tipologia_utente>,
        <https://www.energyguard.eu/ontology/engreen#The_Antrodoco_REC_Mapping_Dataset__not_in_source_file> ;
    csvw:null "Empty cell = not applicable or not available (e.g. no PV plant or no battery)" .

<https://www.energyguard.eu/ontology/engreen#Dataset_The_GSE_Historical_Metering_Dataset> a dcat:Dataset ;
    dcterms:accessRights <http://publications.europa.eu/resource/authority/access-right/RESTRICTED> ;
    dcterms:description "Hourly metering data of the REC metering points retrieved from the GSE (Gestore dei Servizi Energetici) platform, which ENGREEN accesses as REC operator. It consists of three files with the same structure: grid withdrawal (consumption points), grid injection and energy production (production units). It is used for historical analysis, baseline definition, load-profile reconstruction and Digital Twin calibration. System covered: Grid withdrawal, grid injection and PV production of the REC metering points. Source: GSE platform (official metering data), manual export."@en ;
    dcterms:format "XLSX source files, one sheet each: Withdrawn_Energy, Fed-In_Energy, Produced_Energy; decimal point. Uploaded to the EnergyGuard Data Lake as CSV." ;
    dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
    dcterms:publisher mp:ENGREEN ;
    dcterms:spatial <https://www.energyguard.eu/ontology/engreen#Place_The_GSE_Historical_Metering_Dataset> ;
    dcterms:temporal <https://www.energyguard.eu/ontology/engreen#Period_The_GSE_Historical_Metering_Dataset> ;
    dcterms:title "The GSE Historical Metering Dataset"@en ;
    schema1:variableMeasured <https://www.energyguard.eu/ontology/engreen#The_GSE_Historical_Metering_Dataset__Codice_Misura>,
        <https://www.energyguard.eu/ontology/engreen#The_GSE_Historical_Metering_Dataset__Data>,
        <https://www.energyguard.eu/ontology/engreen#The_GSE_Historical_Metering_Dataset__Ora>,
        <https://www.energyguard.eu/ontology/engreen#The_GSE_Historical_Metering_Dataset__kWh> ;
    csvw:null "No explicit marker; missing periods = absent rows (availability varies by metering point)" ;
    dcat:temporalResolution "PT1H"^^xsd:duration ;
    eg:timeZone "Italian local time with daylight saving time. Hour 0–23 = start of the hour." .

<https://www.energyguard.eu/ontology/engreen#Dataset_The_Weather_Dataset> a dcat:Dataset ;
    dcterms:accrualPeriodicity <http://publications.europa.eu/resource/authority/frequency/NEVER> ;
    dcterms:description "Hourly meteorological and solar radiation data for the Antrodoco area from the Open-Meteo historical weather API, extracted for a single reference point covering the REC (no coordinates of individual installations are processed). It is used to model PV production, interpret consumption patterns and analyse abnormal asset behaviour. System covered: Local weather and solar radiation conditions. Source: Open-Meteo Historical Weather API (weather model data)."@en ;
    dcterms:format "CSV, comma, decimal point. Two header lines with location metadata (latitude, longitude, elevation, UTC offset, time zone), an empty line, then column names. Uploaded to the EnergyGuard Data Lake as CSV." ;
    dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
    dcterms:publisher mp:ENGREEN ;
    dcterms:spatial <https://www.energyguard.eu/ontology/engreen#Place_The_Weather_Dataset> ;
    dcterms:temporal <https://www.energyguard.eu/ontology/engreen#Period_The_Weather_Dataset> ;
    dcterms:title "The Weather Dataset"@en ;
    schema1:variableMeasured <https://www.energyguard.eu/ontology/engreen#The_Weather_Dataset__cloud_cover>,
        <https://www.energyguard.eu/ontology/engreen#The_Weather_Dataset__diffuse_radiation_W_m2>,
        <https://www.energyguard.eu/ontology/engreen#The_Weather_Dataset__direct_normal_irradiance_W_m2>,
        <https://www.energyguard.eu/ontology/engreen#The_Weather_Dataset__shortwave_radiation_W_m2>,
        <https://www.energyguard.eu/ontology/engreen#The_Weather_Dataset__temperature_2m_C>,
        <https://www.energyguard.eu/ontology/engreen#The_Weather_Dataset__wind_speed_10m_km_h> ;
    csvw:null "Empty cell = value not available" ;
    dcat:temporalResolution "PT1H"^^xsd:duration ;
    eg:storedInDatabaseTable "public.f_tsdata" ;
    eg:timeZone "Local time as returned by Open-Meteo; time zone and UTC offset are reported in the file header" .

<https://www.energyguard.eu/ontology/engreen#GME_CSUD_Hourly_Electricity_Price_Dataset__Data> a eg:Variable ;
    rdfs:label "Date"@en ;
    dcterms:description "Calendar date to which the zonal electricity price refers (dd/mm/yyyy)"@en ;
    csvw:name "Data" ;
    eg:dataType "text" ;
    eg:variableKind "timestamp" .

<https://www.energyguard.eu/ontology/engreen#GME_CSUD_Hourly_Electricity_Price_Dataset__Ora> a eg:Variable ;
    rdfs:label "Hour"@en ;
    dcterms:description "Hourly market interval associated with the price (1 = 00:00–01:00)"@en ;
    qudt:hasUnit <http://qudt.org/vocab/unit/HR> ;
    schema1:maxValue 23.0 ;
    schema1:minValue 0.0 ;
    csvw:name "Ora" ;
    eg:dataType "integer" ;
    eg:variableKind "timestamp" .

<https://www.energyguard.eu/ontology/engreen#GME_CSUD_Hourly_Electricity_Price_Dataset__PZ_t> a eg:Variable ;
    rdfs:label "Zonal electricity price"@en ;
    dcterms:description "Hourly electricity price for the GME Centro-Sud (CSUD) bidding zone, used as the reference value for electricity sold to the grid"@en ;
    qudt:hasUnit <http://qudt.org/vocab/unit/CCY_EUR-PER-MegaW-HR> ;
    skos:note "Valid range: ≥ 0 (2025: 0 – 0.289)"@en ;
    csvw:name "PZ_t" ;
    sosa:isHostedBy <https://www.energyguard.eu/ontology/engreen#Platform_CSUD_bidding_zone> ;
    eg:dataType "float" ;
    eg:variableKind "measured" .

<https://www.energyguard.eu/ontology/engreen#Licence_GME_CSUD_Hourly_Electricity_Price_Dataset> a dcterms:LicenseDocument ;
    rdfs:label "Public market data published by GME; reuse with citation of the source (GME terms of use)"@en .

<https://www.energyguard.eu/ontology/engreen#Operational_monitoring_dataset__Active_power_W> a sosa:Sensor,
        eg:Variable ;
    rdfs:label "Active Power"@en ;
    dcterms:description "Instantaneous active power measured by the power meter at the grid connection point"@en ;
    dcterms:identifier "Pseudonymised power sensor code" ;
    qudt:hasUnit <http://qudt.org/vocab/unit/W> ;
    skos:note "Valid range: limited by plant and contracted power"@en ;
    csvw:name "Active power(W)" ;
    sosa:isHostedBy <https://www.energyguard.eu/ontology/engreen#Platform_Power_sensor> ;
    sosa:observes prop:Power ;
    eg:dataLakeSensorPattern "________________\\_active\\_power" ;
    eg:dataType "float" ;
    eg:signConvention "+ = export to the grid; - = import from the grid" .

<https://www.energyguard.eu/ontology/engreen#Operational_monitoring_dataset__Active_power_kW> a sosa:Sensor,
        eg:Variable ;
    rdfs:label "Active Power"@en ;
    dcterms:description "Instantaneous active power measured by the inverter (AC output)"@en ;
    dcterms:identifier "Pseudonymised inverter code" ;
    qudt:hasUnit <http://qudt.org/vocab/unit/KiloW> ;
    skos:note "Valid range: 0 – inverter nominal power"@en ;
    csvw:name "Active power(kW)" ;
    sosa:isHostedBy <https://www.energyguard.eu/ontology/engreen#Platform_Inverter> ;
    sosa:observes prop:Power ;
    eg:dataLakeSensorPattern "________________\\_active\\_power" ;
    eg:dataType "float" .

<https://www.energyguard.eu/ontology/engreen#Operational_monitoring_dataset__Batteria_SOC> a sosa:Sensor,
        eg:Variable ;
    rdfs:label "Battery SOC"@en ;
    dcterms:description "Battery state of charge, representing the available stored energy relative to its capacity"@en ;
    dcterms:identifier "Pseudonymised battery code" ;
    qudt:hasUnit <http://qudt.org/vocab/unit/PERCENT> ;
    schema1:maxValue 100.0 ;
    schema1:minValue 0.0 ;
    csvw:name "Batteria SOC(%)" ;
    sosa:isHostedBy <https://www.energyguard.eu/ontology/engreen#Platform_Battery> ;
    sosa:observes prop:StateOfCharge ;
    eg:dataLakeSensorPattern "%\\_battery\\_soc" ;
    eg:dataType "float" .

<https://www.energyguard.eu/ontology/engreen#Operational_monitoring_dataset__Battery_Power_W> a sosa:Sensor,
        eg:Variable ;
    rdfs:label "Charge/Discharge Power"@en ;
    dcterms:description "Instantaneous power exchanged with the battery during charging or discharging"@en ;
    dcterms:identifier "Plant code" ;
    qudt:hasUnit <http://qudt.org/vocab/unit/W> ;
    skos:note "Valid range: limited by battery power rating"@en ;
    csvw:name "Battery Power(W)" ;
    sosa:isHostedBy <https://www.energyguard.eu/ontology/engreen#Platform_Battery> ;
    sosa:observes prop:Power ;
    eg:dataType "float" ;
    eg:signConvention "+ = discharging; - = charging" .

<https://www.energyguard.eu/ontology/engreen#Operational_monitoring_dataset__Daily_energy_kWh> a sosa:Sensor,
        eg:Variable ;
    rdfs:label "Daily Energy"@en ;
    dcterms:description "Electrical energy produced by the PV inverter during the current day (reset at midnight)"@en ;
    dcterms:identifier "Pseudonymised inverter code" ;
    qudt:hasUnit <http://qudt.org/vocab/unit/KiloW-HR> ;
    skos:note "cumulative (daily)",
        "Valid range: ≥ 0"@en ;
    csvw:name "Daily energy(kWh)" ;
    sosa:isHostedBy <https://www.energyguard.eu/ontology/engreen#Platform_Inverter> ;
    sosa:observes prop:Energy ;
    eg:aggregation "cumulative" ;
    eg:dataLakeSensorPattern "%\\_day\\_cap" ;
    eg:dataType "float" .

<https://www.energyguard.eu/ontology/engreen#Operational_monitoring_dataset__Grid_Power_W> a sosa:Sensor,
        eg:Variable ;
    rdfs:label "Active Power"@en ;
    dcterms:description "Power exchanged with the grid at the connection point"@en ;
    dcterms:identifier "Plant code" ;
    qudt:hasUnit <http://qudt.org/vocab/unit/W> ;
    skos:note "Valid range: limited by plant and contracted power"@en ;
    csvw:name "Grid Power(W)" ;
    sosa:isHostedBy <https://www.energyguard.eu/ontology/engreen#Platform_Grid_connection> ;
    sosa:observes prop:Power ;
    eg:dataType "float" ;
    eg:signConvention "+ = import from the grid; - = export to the grid" .

<https://www.energyguard.eu/ontology/engreen#Operational_monitoring_dataset__Negative_active_energy_kWh> a sosa:Sensor,
        eg:Variable ;
    rdfs:label "Negative Active Energy"@en ;
    dcterms:description "Cumulative active energy measured by the power sensor in the negative flow direction (import from the grid)"@en ;
    dcterms:identifier "Pseudonymised power sensor code" ;
    qudt:hasUnit <http://qudt.org/vocab/unit/KiloW-HR> ;
    skos:note "cumulative (lifetime)",
        "Valid range: ≥ 0, non-decreasing"@en ;
    csvw:name "Negative active energy(kWh)" ;
    sosa:isHostedBy <https://www.energyguard.eu/ontology/engreen#Platform_Power_sensor> ;
    sosa:observes prop:Energy ;
    eg:aggregation "cumulative" ;
    eg:dataLakeSensorPattern "%\\_reverse\\_active\\_cap" ;
    eg:dataType "float" ;
    eg:signConvention "negative direction = import from the grid" .

<https://www.energyguard.eu/ontology/engreen#Operational_monitoring_dataset__Positive_active_energy_kWh> a sosa:Sensor,
        eg:Variable ;
    rdfs:label "Positive Active Energy"@en ;
    dcterms:description "Cumulative active energy measured by the power sensor in the positive flow direction (export to the grid)"@en ;
    dcterms:identifier "Pseudonymised power sensor code" ;
    qudt:hasUnit <http://qudt.org/vocab/unit/KiloW-HR> ;
    skos:note "cumulative (lifetime)",
        "Valid range: ≥ 0, non-decreasing"@en ;
    csvw:name "Positive active energy(kWh)" ;
    sosa:isHostedBy <https://www.energyguard.eu/ontology/engreen#Platform_Power_sensor> ;
    sosa:observes prop:Energy ;
    eg:aggregation "cumulative" ;
    eg:dataLakeSensorPattern "________________\\_active\\_cap" ;
    eg:dataType "float" ;
    eg:signConvention "positive direction = export to the grid" .

<https://www.energyguard.eu/ontology/engreen#Operational_monitoring_dataset__Potenza_di_carica_e_scarica_kW> a sosa:Sensor,
        eg:Variable ;
    rdfs:label "Charge/Discharge Power"@en ;
    dcterms:description "Instantaneous power exchanged with the battery during charging or discharging"@en ;
    dcterms:identifier "Pseudonymised battery code" ;
    qudt:hasUnit <http://qudt.org/vocab/unit/KiloW> ;
    skos:note "Valid range: limited by battery power rating"@en ;
    csvw:name "Potenza di carica e scarica(kW)" ;
    sosa:isHostedBy <https://www.energyguard.eu/ontology/engreen#Platform_Battery> ;
    sosa:observes prop:Power ;
    eg:dataLakeSensorPattern "%\\_ch\\_discharge\\_power" ;
    eg:dataType "float" ;
    eg:signConvention "+ = charging; - = discharging" .

<https://www.energyguard.eu/ontology/engreen#Operational_monitoring_dataset__Production_Power_W> a sosa:Sensor,
        eg:Variable ;
    rdfs:label "Active Power"@en ;
    dcterms:description "PV production power of the plant"@en ;
    dcterms:identifier "Plant code" ;
    qudt:hasUnit <http://qudt.org/vocab/unit/W> ;
    skos:note "Valid range: 0 – plant nominal power"@en ;
    csvw:name "Production Power(W)" ;
    sosa:isHostedBy <https://www.energyguard.eu/ontology/engreen#Platform_Inverter> ;
    sosa:observes prop:Power ;
    eg:dataType "float" .

<https://www.energyguard.eu/ontology/engreen#Operational_monitoring_dataset__SoC> a sosa:Sensor,
        eg:Variable ;
    rdfs:label "Battery SOC"@en ;
    dcterms:description "Battery state of charge, representing the available stored energy relative to its capacity"@en ;
    dcterms:identifier "Plant code" ;
    qudt:hasUnit <http://qudt.org/vocab/unit/PERCENT> ;
    schema1:maxValue 100.0 ;
    schema1:minValue 0.0 ;
    csvw:name "SoC(%)" ;
    sosa:isHostedBy <https://www.energyguard.eu/ontology/engreen#Platform_Battery> ;
    sosa:observes prop:StateOfCharge ;
    eg:dataType "float" .

<https://www.energyguard.eu/ontology/engreen#Operational_monitoring_dataset__Total_yield_kWh> a sosa:Sensor,
        eg:Variable ;
    rdfs:label "Total PV Yield"@en ;
    dcterms:description "Cumulative AC energy yield of the inverter"@en ;
    dcterms:identifier "Pseudonymised inverter code" ;
    qudt:hasUnit <http://qudt.org/vocab/unit/KiloW-HR> ;
    skos:note "cumulative (lifetime)",
        "Valid range: ≥ 0, non-decreasing"@en ;
    csvw:name "Total yield(kWh)" ;
    sosa:isHostedBy <https://www.energyguard.eu/ontology/engreen#Platform_Inverter> ;
    sosa:observes prop:Energy ;
    eg:aggregation "cumulative" ;
    eg:dataLakeSensorPattern "%\\_total\\_cap" ;
    eg:dataType "float" .

<https://www.energyguard.eu/ontology/engreen#Operational_monitoring_dataset__collectTime> a eg:Variable ;
    rdfs:label "Timestamp"@en ;
    dcterms:description "Timestamp of the measurement in UTC (5-minute resolution)."@en ;
    skos:note "Valid range: 2026 - ongoing"@en ;
    csvw:name "collectTime" ;
    sosa:isHostedBy <https://www.energyguard.eu/ontology/engreen#Platform_Inverter_Power_sensor_Battery> ;
    eg:storedInDatabaseColumn "public.d_calendar.datetime" ;
    eg:variableKind "timestamp" .

<https://www.energyguard.eu/ontology/engreen#Period_GME_CSUD_Hourly_Electricity_Price_Dataset> a dcterms:PeriodOfTime ;
