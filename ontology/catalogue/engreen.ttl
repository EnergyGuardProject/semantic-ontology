    rdfs:label "Energy value"@en ;
    dcterms:description "Energy measured during the hourly interval: grid withdrawal, grid injection or energy production depending on the file"@en ;
    dcterms:identifier "Pseudonymised measurement code" ;
    qudt:hasUnit <http://qudt.org/vocab/unit/KiloW-HR> ;
    skos:note "hourly sum",
        "Valid range: ≥ 0"@en ;
    csvw:name "kWh" ;
    sosa:isHostedBy <https://www.energyguard.eu/ontology/engreen#Platform_Metering_point_production_unit> ;
    sosa:observes prop:Energy ;
    eg:aggregation "sum" ;
    eg:dataType "float" ;
    eg:signConvention "always positive; the flow direction is given by the file" ;
    eg:variableKind "measured" .

