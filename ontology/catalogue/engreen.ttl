    schema1:maxValue 100.0 ;
    schema1:minValue 0.0 ;
    csvw:name "cloud_cover (%)" ;
    sosa:isHostedBy <https://www.energyguard.eu/ontology/engreen#Platform_Weather> ;
    sosa:observes prop:CloudCover ;
    eg:dataLakeSensorId "cloud_pct_1" ;
    eg:dataType "float" ;
    eg:variableKind "modelled" .

<https://www.energyguard.eu/ontology/engreen#The_Weather_Dataset__diffuse_radiation_W_m2> a eg:Variable ;
