    eg:storedInDatabaseColumn "ip_paterin" .

rea:Energy_efficiency_indicators_for_heating_of_multi_apartment_buildings_in_Riga__ipatn_silt a eg:Variable ;
    rdfs:label "heating_indicator"@en ;
    dcterms:description "This indicator reflects percentage difference between specific heating consumption for the past 12 months (heating_consumption) and average heating consumption indicator for equivalent buildings. Equivalent buildings are buildings, which were built in approximately the same period of time and are similar in area. If the field “Comparison with equivalent buildings” contains a positive number, for example “+15%”, then this means that the selected building consumes 15% more heat energy for heating than similar buildings by area and year of construction. If the comparison is negative, for example “-20%”, then the selected building consumes 20% less heat energy for heating than similar buildings. If data is not available for all 12 months, the result is displayed as “No data”."@en ;
    qudt:hasUnit unit:PERCENT ;
    csvw:name "ipatn_silt" ;
    eg:storedInDatabaseColumn "ipatn_silt" .

