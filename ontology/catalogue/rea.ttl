rea:Dataset_3D_GEOMETRY_LOD1_LOD2 a geosparql:FeatureCollection,
        dcat:Dataset ;
    dcterms:description "3D GEOMETRY: LOD1/LOD2: dataset of the REA pilot with 5 variables (coorindate_system, face, mtllib, vertex, vertex_normal). The pilot gave no description; this text is derived from its variable list."@en ;
    dcterms:publisher mp:REA ;
    dcterms:title "3D GEOMETRY: LOD1/LOD2"@en ;
    schema:variableMeasured rea:3D_GEOMETRY_LOD1_LOD2__coorindate_system,
        rea:3D_GEOMETRY_LOD1_LOD2__face,
        rea:3D_GEOMETRY_LOD1_LOD2__mtllib,
        rea:3D_GEOMETRY_LOD1_LOD2__vertex,
        rea:3D_GEOMETRY_LOD1_LOD2__vertex_normal .

rea:Dataset_Air_quality a dcat:Dataset ;
    dcterms:description "Hourly concentrations of PM2.5, PM10, NO2, SO2 and O3 (µg/m³) from 3 Riga monitoring stations: Mīlgrāvis, Brīvības iela and Pārdaugava."@en ;
    dcterms:publisher mp:REA ;
    dcterms:title "Air quality"@en ;
    schema:variableMeasured rea:Air_quality__NO2_g_m3,
        rea:Air_quality__O3_g_m3,
        rea:Air_quality__PM10_g_m3,
        rea:Air_quality__PM2_5_g_m3,
        rea:Air_quality__SO2_g_m3 ;
    skos:note "TO BE UPDATED based on air quality from open portal:https://data.gov.lv/dati/dataset/ikmenesa-gaisa-kvalitate | 1 data row per day and hour, e.g. 2024.01.01 00:00, 2024.01.01 01:00, ..., 2024.01.01 23:00" ;
    dcat:landingPage <https://gmsd.riga.lv/main.php?i_lang=2> ;
    eg:storedInDatabaseTable "public.f_tsdata" .

rea:Dataset_Air_temperature a dcat:Dataset ;
    dcterms:description "Air temperature: dataset of the REA pilot with 4 variables (00:00:00, 01:00:00, 23:00:00, Date). The pilot gave no description; this text is derived from its variable list."@en ;
    dcterms:publisher mp:REA ;
    dcterms:title "Air temperature"@en ;
    schema:variableMeasured rea:Air_temperature__00_00_00,
        rea:Air_temperature__01_00_00,
        rea:Air_temperature__23_00_00,
        rea:Air_temperature__Datums ;
    dcat:landingPage <https://videscentrs.lvgmc.lv/noverojumu-arhivs/meteo/30096/any/4001> .

rea:Dataset_Borders_of_Riga_and_Riga_suburbs_A_Riga_border a dcat:Dataset ;
    dcterms:description "Borders of Riga and Riga suburbs – A) Riga border: dataset of the REA pilot with 2 variables (geometry, gid). The pilot gave no description; this text is derived from its variable list."@en ;
    dcterms:publisher mp:REA ;
    dcterms:title "Borders of Riga and Riga suburbs – A) Riga border"@en ;
    schema:variableMeasured rea:Borders_of_Riga_and_Riga_suburbs_A_Riga_border__geometry,
        rea:Borders_of_Riga_and_Riga_suburbs_A_Riga_border__gid .

rea:Dataset_Borders_of_Riga_and_Riga_suburbs_B_Riga_suburb_borders a geosparql:FeatureCollection,
        dcat:Dataset ;
    dcterms:description "Borders of Riga and Riga suburbs – B) Riga suburb borders: dataset of the REA pilot with 6 variables (administrative_code, area, executive_district, geometry, gid, name). The pilot gave no description; this text is derived from its variable list."@en ;
    dcterms:publisher mp:REA ;
    dcterms:title "Borders of Riga and Riga suburbs – B) Riga suburb borders"@en ;
    schema:variableMeasured rea:Borders_of_Riga_and_Riga_suburbs_B_Riga_suburb_borders__area,
        rea:Borders_of_Riga_and_Riga_suburbs_B_Riga_suburb_borders__atk,
        rea:Borders_of_Riga_and_Riga_suburbs_B_Riga_suburb_borders__geometry,
        rea:Borders_of_Riga_and_Riga_suburbs_B_Riga_suburb_borders__gid,
        rea:Borders_of_Riga_and_Riga_suburbs_B_Riga_suburb_borders__izpilddire,
        rea:Borders_of_Riga_and_Riga_suburbs_B_Riga_suburb_borders__nosaukums ;
    eg:storedInDatabaseTable "gis.rigas_priekspilsetas" .

