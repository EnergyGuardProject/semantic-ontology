rea:Energy_efficiency_indicators_for_heating_of_multi_apartment_buildings_in_Riga__ip_paterin a eg:Variable ;
    rdfs:label "heating_consumption"@en ;
    dcterms:description "Actual specific heating consumption for the last 12 months, based on district heating data."@en ;
