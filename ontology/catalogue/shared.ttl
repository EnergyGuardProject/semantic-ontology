@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix eg: <https://www.energyguard.eu/ontology#> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix mp: <https://www.energyguard.eu/ontology/merged-pilots#> .
@prefix prop: <https://www.energyguard.eu/ontology/property#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix sosa: <http://www.w3.org/ns/sosa/> .
@prefix unit: <http://qudt.org/vocab/unit/> .

unit:A qudt:symbol "A" .

unit:BAR qudt:symbol "bar" .

unit:CCY_EUR qudt:symbol "EUR" .

unit:CCY_EUR-PER-M2 qudt:symbol "EUR/m²" .

unit:CCY_EUR-PER-MegaW-HR qudt:symbol "€/MWh" .

unit:DEG qudt:symbol "°" .

unit:DEG_C qudt:symbol "°C" .

unit:GM-PER-HR qudt:symbol "g/h" .

unit:HR qudt:symbol "h" .

unit:KiloGM-PER-M2 qudt:symbol "kg CO₂/m²" .

unit:KiloM-PER-HR qudt:symbol "km/h" .

unit:KiloW qudt:symbol "kW" .

unit:KiloW-HR qudt:symbol "kWh" .

unit:KiloW-HR-PER-M2 qudt:symbol "kWh/m²" .

unit:L qudt:symbol "L" .

unit:L-PER-MIN qudt:symbol "L/min" .

unit:M qudt:symbol "m" .

unit:M-PER-SEC qudt:symbol "m/s" .

unit:M2 qudt:symbol "m²" .

unit:M3 qudt:symbol "m³" .

unit:M3-PER-HR qudt:symbol "m3/h" .

unit:MegaW-HR qudt:symbol "MWh" .

unit:MicroGM-PER-M3 qudt:symbol "µg/m³" .

unit:MicroS-PER-CentiM qudt:symbol "uS/cm" .

unit:MilliBAR qudt:symbol "mbarg" .

unit:MilliM qudt:symbol "mm" .

unit:NUM qudt:symbol "count" .

unit:PER-HR qudt:symbol "1/h" .

unit:PERCENT qudt:symbol "%" .

unit:PPM qudt:symbol "PPM" .

unit:REV-PER-MIN qudt:symbol "rpm" .

unit:SEC qudt:symbol "s" .

unit:TONNE-PER-YR qudt:symbol "tCO₂/year" .

unit:V qudt:symbol "V" .

unit:W qudt:symbol "W" .

unit:W-HR qudt:symbol "Wh" .

unit:W-PER-M2 qudt:symbol "W/m²" .

unit:W-PER-M2-K qudt:symbol "W/(m²K)" .

unit:YR qudt:symbol "year" .

mp:BER a foaf:Organization ;
    rdfs:label "BER" ;
    eg:storedInDatabase "TEF3_BER" .

mp:CARTIF a foaf:Organization ;
    rdfs:label "CARTIF" ;
    eg:storedInDatabase "TEF5_CARTIF" .

mp:CEA a foaf:Organization ;
    rdfs:label "CEA" ;
    eg:storedInDatabase "TEF4_CEA" .

mp:CIEMAT a foaf:Organization ;
    rdfs:label "CIEMAT" ;
    eg:storedInDatabase "TEF2_CEDER" .

mp:ENGREEN a foaf:Organization ;
    rdfs:label "ENGREEN" ;
    eg:storedInDatabase "TEF7_ENGREEN" .

mp:RDN a foaf:Organization ;
    rdfs:label "RDN" ;
    eg:storedInDatabase "TEF1_RDN" .

mp:REA a foaf:Organization ;
    rdfs:label "REA" ;
    eg:storedInDatabase "TEF6_REA" .

prop:CloudCover a skos:Concept,
        sosa:ObservableProperty ;
    skos:definition "Cloud cover (%)."@en ;
    skos:inScheme eg:MeasurementTypeScheme ;
    skos:prefLabel "Cloud Cover"@en .

prop:Composition a skos:Concept,
        sosa:ObservableProperty ;
    skos:definition "Gas or fluid composition (ppm, LEL)."@en ;
    skos:inScheme eg:MeasurementTypeScheme ;
    skos:prefLabel "Composition"@en .

prop:ControlSignal a skos:Concept,
        sosa:ObservableProperty ;
    skos:definition "Control outputs and commands sent to equipment."@en ;
    skos:inScheme eg:MeasurementTypeScheme ;
    skos:prefLabel "Control Signal"@en .

prop:Current a skos:Concept,
        sosa:ObservableProperty ;
    qudt:hasQuantityKind <http://qudt.org/vocab/quantitykind/ElectricCurrent> ;
    skos:definition "Electric current (A)."@en ;
    skos:inScheme eg:MeasurementTypeScheme ;
    skos:prefLabel "Current"@en .

prop:Efficiency a skos:Concept,
        sosa:ObservableProperty ;
    qudt:hasQuantityKind <http://qudt.org/vocab/quantitykind/Efficiency> ;
    skos:definition "Efficiency indicators."@en ;
    skos:inScheme eg:MeasurementTypeScheme ;
    skos:prefLabel "Efficiency"@en .

prop:Energy a skos:Concept,
        sosa:ObservableProperty ;
    qudt:hasQuantityKind <http://qudt.org/vocab/quantitykind/Energy> ;
    skos:definition "Energy values (Wh, kWh, MWh): consumed, produced or cumulative."@en ;
    skos:inScheme eg:MeasurementTypeScheme ;
    skos:prefLabel "Energy"@en .

prop:Flow a skos:Concept,
        sosa:ObservableProperty ;
    qudt:hasQuantityKind <http://qudt.org/vocab/quantitykind/MassFlowRate>,
        <http://qudt.org/vocab/quantitykind/VolumeFlowRate> ;
    skos:definition "Flow rates of gases or liquids (L/min, m³/h, kg/h)."@en ;
    skos:inScheme eg:MeasurementTypeScheme ;
    skos:prefLabel "Flow"@en .

prop:Hydrogen a skos:Concept,
        sosa:ObservableProperty ;
    skos:definition "Hydrogen-related data: flow, pressure or storage."@en ;
    skos:inScheme eg:MeasurementTypeScheme ;
    skos:prefLabel "Hydrogen"@en .

prop:Power a skos:Concept,
        sosa:ObservableProperty ;
    qudt:hasQuantityKind <http://qudt.org/vocab/quantitykind/Power> ;
    skos:definition "Electrical or thermal power (W, kW, MW)."@en ;
    skos:inScheme eg:MeasurementTypeScheme ;
    skos:prefLabel "Power"@en .

prop:Pressure a skos:Concept,
        sosa:ObservableProperty ;
    qudt:hasQuantityKind <http://qudt.org/vocab/quantitykind/Pressure> ;
    skos:definition "Pressure readings (bar, mbar, Pa)."@en ;
    skos:inScheme eg:MeasurementTypeScheme ;
    skos:prefLabel "Pressure"@en .

prop:SolarRadiation a skos:Concept,
        sosa:ObservableProperty ;
    qudt:hasQuantityKind <http://qudt.org/vocab/quantitykind/Irradiance> ;
    skos:definition "Solar irradiance (W/m²)."@en ;
    skos:inScheme eg:MeasurementTypeScheme ;
    skos:prefLabel "Solar Radiation"@en .

prop:Speed a skos:Concept,
        sosa:ObservableProperty ;
    qudt:hasQuantityKind <http://qudt.org/vocab/quantitykind/AngularVelocity>,
        <http://qudt.org/vocab/quantitykind/Speed> ;
    skos:definition "Speeds (m/s, rpm)."@en ;
    skos:inScheme eg:MeasurementTypeScheme ;
    skos:prefLabel "Speed"@en .

prop:State a skos:Concept,
        sosa:ObservableProperty ;
    skos:definition "On/off or discrete operating state, status and alarm signals."@en ;
    skos:inScheme eg:MeasurementTypeScheme ;
    skos:prefLabel "State"@en .

prop:StateOfCharge a skos:Concept,
        sosa:ObservableProperty ;
    qudt:hasQuantityKind <http://qudt.org/vocab/quantitykind/StateOfCharge> ;
    skos:definition "State of charge of a battery (%)."@en ;
    skos:inScheme eg:MeasurementTypeScheme ;
    skos:prefLabel "State Of Charge"@en .

prop:Temperature a skos:Concept,
        sosa:ObservableProperty ;
    qudt:hasQuantityKind <http://qudt.org/vocab/quantitykind/Temperature> ;
    skos:definition "Temperature readings (°C)."@en ;
    skos:inScheme eg:MeasurementTypeScheme ;
    skos:prefLabel "Temperature"@en .

prop:Timer a skos:Concept,
        sosa:ObservableProperty ;
    qudt:hasQuantityKind <http://qudt.org/vocab/quantitykind/Time> ;
    skos:definition "Elapsed or counted time (s, h), such as hour counters."@en ;
    skos:inScheme eg:MeasurementTypeScheme ;
    skos:prefLabel "Timer"@en .

prop:Voltage a skos:Concept,
        sosa:ObservableProperty ;
    qudt:hasQuantityKind <http://qudt.org/vocab/quantitykind/Voltage> ;
    skos:definition "Electric voltage (V)."@en ;
    skos:inScheme eg:MeasurementTypeScheme ;
    skos:prefLabel "Voltage"@en .

prop:Volume a skos:Concept,
        sosa:ObservableProperty ;
    qudt:hasQuantityKind <http://qudt.org/vocab/quantitykind/Volume> ;
    skos:definition "Volumes (m³, L)."@en ;
    skos:inScheme eg:MeasurementTypeScheme ;
    skos:prefLabel "Volume"@en .

eg:MeasurementTypeScheme a skos:ConceptScheme ;
    dcterms:description "The kinds of quantity or signal an EnergyGuard variable observes. Each one is a sosa:ObservableProperty and, where QUDT has an equivalent, is linked to its QUDT quantity kind."@en ;
    dcterms:title "EnergyGuard measurement types"@en .

