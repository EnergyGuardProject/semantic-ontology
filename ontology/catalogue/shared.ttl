@prefix dcat: <http://www.w3.org/ns/dcat#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix dqv: <http://www.w3.org/ns/dqv#> .
@prefix eg: <https://www.energyguard.eu/ontology#> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix mp: <https://www.energyguard.eu/ontology/merged-pilots#> .
@prefix prop: <https://www.energyguard.eu/ontology/property#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix sosa: <http://www.w3.org/ns/sosa/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://qudt.org/vocab/unit/A> qudt:symbol "A" .

<http://qudt.org/vocab/unit/BAR> qudt:symbol "bar" .

<http://qudt.org/vocab/unit/CCY_EUR> qudt:symbol "EUR" .

<http://qudt.org/vocab/unit/CCY_EUR-PER-M2> qudt:symbol "EUR/m²" .

<http://qudt.org/vocab/unit/CCY_EUR-PER-MegaW-HR> qudt:symbol "€/MWh" .

<http://qudt.org/vocab/unit/DEG> qudt:symbol "°" .

<http://qudt.org/vocab/unit/DEG_C> qudt:symbol "°C" .

<http://qudt.org/vocab/unit/GM-PER-HR> qudt:symbol "g/h" .

<http://qudt.org/vocab/unit/HR> qudt:symbol "h" .

<http://qudt.org/vocab/unit/KiloGM-PER-M2> qudt:symbol "kg CO₂/m²" .

<http://qudt.org/vocab/unit/KiloM-PER-HR> qudt:symbol "km/h" .

<http://qudt.org/vocab/unit/KiloW> qudt:symbol "kW" .

<http://qudt.org/vocab/unit/KiloW-HR> qudt:symbol "kWh" .

<http://qudt.org/vocab/unit/KiloW-HR-PER-M2> qudt:symbol "kWh/m²" .

<http://qudt.org/vocab/unit/L> qudt:symbol "L" .

<http://qudt.org/vocab/unit/L-PER-MIN> qudt:symbol "L/min" .

<http://qudt.org/vocab/unit/M> qudt:symbol "m" .

<http://qudt.org/vocab/unit/M-PER-SEC> qudt:symbol "m/s" .

<http://qudt.org/vocab/unit/M2> qudt:symbol "m²" .

<http://qudt.org/vocab/unit/M3> qudt:symbol "m³" .

<http://qudt.org/vocab/unit/M3-PER-HR> qudt:symbol "m3/h" .

<http://qudt.org/vocab/unit/MegaW-HR> qudt:symbol "MWh" .

<http://qudt.org/vocab/unit/MicroGM-PER-M3> qudt:symbol "µg/m³" .

<http://qudt.org/vocab/unit/MicroS-PER-CentiM> qudt:symbol "uS/cm" .

<http://qudt.org/vocab/unit/MilliBAR> qudt:symbol "mbarg" .

<http://qudt.org/vocab/unit/MilliM> qudt:symbol "mm" .

<http://qudt.org/vocab/unit/NUM> qudt:symbol "count" .

<http://qudt.org/vocab/unit/PER-HR> qudt:symbol "1/h" .

<http://qudt.org/vocab/unit/PERCENT> qudt:symbol "%" .

<http://qudt.org/vocab/unit/PPM> qudt:symbol "PPM" .

<http://qudt.org/vocab/unit/REV-PER-MIN> qudt:symbol "rpm" .

<http://qudt.org/vocab/unit/SEC> qudt:symbol "s" .

<http://qudt.org/vocab/unit/TONNE-PER-YR> qudt:symbol "tCO₂/year" .

<http://qudt.org/vocab/unit/V> qudt:symbol "V" .

<http://qudt.org/vocab/unit/W> qudt:symbol "W" .

<http://qudt.org/vocab/unit/W-HR> qudt:symbol "Wh" .

<http://qudt.org/vocab/unit/W-PER-M2> qudt:symbol "W/m²" .

<http://qudt.org/vocab/unit/W-PER-M2-K> qudt:symbol "W/(m²K)" .

<http://qudt.org/vocab/unit/YR> qudt:symbol "year" .

eg:DataLakeService a dcat:DataService ;
    dcterms:description "PostgreSQL data lake operated by CARTIF, one database per pilot. The host address is not published."@en ;
    dcterms:title "EnergyGuard data lake"@en ;
    dcat:servesDataset <https://www.energyguard.eu/ontology/ber#Dataset_PEM_Electrolyzer_14kW>,
        <https://www.energyguard.eu/ontology/ber#Dataset_PEM_Electrolyzer_7kW>,
        <https://www.energyguard.eu/ontology/cartif#Dataset_CARTIF_hydrogen_test_bench_operational_data_15_s>,
        <https://www.energyguard.eu/ontology/cea#Dataset_CEA_MURPHY_test_bed_dataset>,
        <https://www.energyguard.eu/ontology/ciemat#Dataset_CEDER_CIEMAT_Microgrid_Daily_Operational_Data_1_s>,
        <https://www.energyguard.eu/ontology/engreen#Dataset_Operational_monitoring_dataset>,
        <https://www.energyguard.eu/ontology/engreen#Dataset_Shelly_consumer_monitoring_dataset>,
        <https://www.energyguard.eu/ontology/engreen#Dataset_The_Weather_Dataset>,
        <https://www.energyguard.eu/ontology/rea#Dataset_Air_quality>,
        <https://www.energyguard.eu/ontology/rea#Dataset_Borders_of_Riga_and_Riga_suburbs_B_Riga_suburb_borders>,
        <https://www.energyguard.eu/ontology/rea#Dataset_Buildings_in_the_administrative_territory_of_Riga_A_Existing_buildings>,
        <https://www.energyguard.eu/ontology/rea#Dataset_Buildings_in_the_administrative_territory_of_Riga_B_Demolished_buildings>,
        <https://www.energyguard.eu/ontology/rea#Dataset_Buildings_monthly_heat_series_ARCGIS_Server>,
        <https://www.energyguard.eu/ontology/rea#Dataset_Energy_efficiency_indicators_for_heating_of_multi_apartment_buildings_in_Riga>,
        <https://www.energyguard.eu/ontology/rea#Dataset_Energy_performance_of_renovated_buildings>,
        <https://www.energyguard.eu/ontology/rea#Dataset_Environmentally_degrading_buildings>,
        <https://www.energyguard.eu/ontology/rea#Dataset_Noise_levels>,
        <https://www.energyguard.eu/ontology/rea#Dataset_Riga_streets_and_addresses_A_streets>,
        <https://www.energyguard.eu/ontology/rea#Dataset_Riga_streets_and_addresses_B_addresses>,
        <https://www.energyguard.eu/ontology/rea#Dataset_Territorial_zones_for_the_selection_of_the_type_of_heat_supply> .

eg:OntologyMaintainers a prov:Agent ;
    rdfs:label "EnergyGuard ontology maintainers"@en .

eg:RangeUnitConsistency a dqv:Metric ;
    skos:definition "True when the valid range is written in the same unit as the variable."@en ;
    dqv:expectedDataType xsd:boolean ;
    dqv:inDimension eg:ConsistencyDimension .

mp:BER a foaf:Organization ;
    rdfs:label "BER" .

mp:CARTIF a foaf:Organization ;
    rdfs:label "CARTIF" .

mp:CEA a foaf:Organization ;
    rdfs:label "CEA" .

mp:CIEMAT a foaf:Organization ;
    rdfs:label "CIEMAT" .

mp:ENGREEN a foaf:Organization ;
    rdfs:label "ENGREEN" .

mp:RDN a foaf:Organization ;
    rdfs:label "RDN" .

mp:REA a foaf:Organization ;
    rdfs:label "REA" .

eg:ConsistencyDimension a dqv:Dimension ;
    rdfs:label "Consistency"@en .

prop:CloudCover a skos:Concept,
        sosa:ObservableProperty ;
    skos:definition "Cloud cover (%)."@en ;
    skos:inScheme eg:MeasurementTypeScheme ;
    skos:prefLabel "Cloud Cover"@en .

prop:Composition a skos:Concept,
        sosa:ObservableProperty ;
    skos:definition "Gas or fluid composition (ppm, LEL)."@en ;
    skos:inScheme eg:MeasurementTypeScheme ;
    skos:prefLabel "Composition"@en .

prop:ControlSignal a skos:Concept,
        sosa:ObservableProperty ;
    skos:definition "Control outputs and commands sent to equipment."@en ;
    skos:inScheme eg:MeasurementTypeScheme ;
    skos:prefLabel "Control Signal"@en .

prop:Current a skos:Concept,
        sosa:ObservableProperty ;
    qudt:hasQuantityKind <http://qudt.org/vocab/quantitykind/ElectricCurrent> ;
    skos:definition "Electric current (A)."@en ;
    skos:inScheme eg:MeasurementTypeScheme ;
    skos:prefLabel "Current"@en .

prop:Efficiency a skos:Concept,
        sosa:ObservableProperty ;
    qudt:hasQuantityKind <http://qudt.org/vocab/quantitykind/Efficiency> ;
    skos:definition "Efficiency indicators."@en ;
    skos:inScheme eg:MeasurementTypeScheme ;
    skos:prefLabel "Efficiency"@en .

prop:Energy a skos:Concept,
        sosa:ObservableProperty ;
    qudt:hasQuantityKind <http://qudt.org/vocab/quantitykind/Energy> ;
    skos:definition "Energy values (Wh, kWh, MWh): consumed, produced or cumulative."@en ;
    skos:inScheme eg:MeasurementTypeScheme ;
    skos:prefLabel "Energy"@en .

prop:Flow a skos:Concept,
        sosa:ObservableProperty ;
    qudt:hasQuantityKind <http://qudt.org/vocab/quantitykind/MassFlowRate>,
        <http://qudt.org/vocab/quantitykind/VolumeFlowRate> ;
    skos:definition "Flow rates of gases or liquids (L/min, m³/h, kg/h)."@en ;
    skos:inScheme eg:MeasurementTypeScheme ;
    skos:prefLabel "Flow"@en .

prop:Hydrogen a skos:Concept,
        sosa:ObservableProperty ;
    skos:definition "Hydrogen-related data: flow, pressure or storage."@en ;
    skos:inScheme eg:MeasurementTypeScheme ;
    skos:prefLabel "Hydrogen"@en .

prop:Power a skos:Concept,
        sosa:ObservableProperty ;
    qudt:hasQuantityKind <http://qudt.org/vocab/quantitykind/Power> ;
    skos:definition "Electrical or thermal power (W, kW, MW)."@en ;
    skos:inScheme eg:MeasurementTypeScheme ;
    skos:prefLabel "Power"@en .

prop:Pressure a skos:Concept,
        sosa:ObservableProperty ;
    qudt:hasQuantityKind <http://qudt.org/vocab/quantitykind/Pressure> ;
    skos:definition "Pressure readings (bar, mbar, Pa)."@en ;
    skos:inScheme eg:MeasurementTypeScheme ;
    skos:prefLabel "Pressure"@en .

prop:SolarRadiation a skos:Concept,
        sosa:ObservableProperty ;
    qudt:hasQuantityKind <http://qudt.org/vocab/quantitykind/Irradiance> ;
    skos:definition "Solar irradiance (W/m²)."@en ;
    skos:inScheme eg:MeasurementTypeScheme ;
    skos:prefLabel "Solar Radiation"@en .

prop:Speed a skos:Concept,
        sosa:ObservableProperty ;
    qudt:hasQuantityKind <http://qudt.org/vocab/quantitykind/AngularVelocity>,
        <http://qudt.org/vocab/quantitykind/Speed> ;
    skos:definition "Speeds (m/s, rpm)."@en ;
    skos:inScheme eg:MeasurementTypeScheme ;
    skos:prefLabel "Speed"@en .

prop:State a skos:Concept,
        sosa:ObservableProperty ;
    skos:definition "On/off or discrete operating state, status and alarm signals."@en ;
    skos:inScheme eg:MeasurementTypeScheme ;
    skos:prefLabel "State"@en .

prop:StateOfCharge a skos:Concept,
        sosa:ObservableProperty ;
    qudt:hasQuantityKind <http://qudt.org/vocab/quantitykind/StateOfCharge> ;
    skos:definition "State of charge of a battery (%)."@en ;
    skos:inScheme eg:MeasurementTypeScheme ;
    skos:prefLabel "State Of Charge"@en .

prop:Temperature a skos:Concept,
        sosa:ObservableProperty ;
    qudt:hasQuantityKind <http://qudt.org/vocab/quantitykind/Temperature> ;
    skos:definition "Temperature readings (°C)."@en ;
    skos:inScheme eg:MeasurementTypeScheme ;
    skos:prefLabel "Temperature"@en .

prop:Timer a skos:Concept,
        sosa:ObservableProperty ;
    qudt:hasQuantityKind <http://qudt.org/vocab/quantitykind/Time> ;
    skos:definition "Elapsed or counted time (s, h), such as hour counters."@en ;
    skos:inScheme eg:MeasurementTypeScheme ;
    skos:prefLabel "Timer"@en .

prop:Voltage a skos:Concept,
        sosa:ObservableProperty ;
    qudt:hasQuantityKind <http://qudt.org/vocab/quantitykind/Voltage> ;
    skos:definition "Electric voltage (V)."@en ;
    skos:inScheme eg:MeasurementTypeScheme ;
    skos:prefLabel "Voltage"@en .

prop:Volume a skos:Concept,
        sosa:ObservableProperty ;
    qudt:hasQuantityKind <http://qudt.org/vocab/quantitykind/Volume> ;
    skos:definition "Volumes (m³, L)."@en ;
    skos:inScheme eg:MeasurementTypeScheme ;
    skos:prefLabel "Volume"@en .

eg:MeasurementTypeScheme a skos:ConceptScheme ;
    dcterms:description "The kinds of quantity or signal an EnergyGuard variable observes. Each one is a sosa:ObservableProperty and, where QUDT has an equivalent, is linked to its QUDT quantity kind."@en ;
    dcterms:title "EnergyGuard measurement types"@en ;
    skos:hasTopConcept prop:CloudCover,
        prop:Composition,
        prop:ControlSignal,
        prop:Current,
        prop:Efficiency,
        prop:Energy,
        prop:Flow,
        prop:Hydrogen,
        prop:Power,
        prop:Pressure,
        prop:SolarRadiation,
        prop:Speed,
        prop:State,
        prop:StateOfCharge,
        prop:Temperature,
        prop:Timer,
        prop:Voltage,
        prop:Volume .

