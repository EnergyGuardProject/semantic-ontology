node {
  diameter: 40px;
  color: #CFD8DC;
  border-color: #90A4AE;
  border-width: 1px;
  text-color-internal: #263238;
  font-size: 10px;
  caption: "{displayName}";
}
node.Pilot {
  diameter: 80px;
  color: #37474F;
  border-color: #263238;
  text-color-internal: #FFFFFF;
  font-size: 14px;
  caption: "{displayName}";
}
node.Dataset {
  diameter: 55px;
  color: #FFE082;
  border-color: #FFB300;
  caption: "{displayName}";
}
node.Variable {
  diameter: 30px;
  color: #90CAF9;
  border-color: #1E88E5;
  caption: "{displayName}";
}
node.MeasurementType {
  diameter: 50px;
  color: #A5D6A7;
  border-color: #43A047;
  caption: "{displayName}";
}
node.Platform {
  diameter: 45px;
  color: #FFAB91;
  border-color: #F4511E;
  caption: "{displayName}";
}
node.Unit {
  diameter: 25px;
  color: #CE93D8;
  border-color: #8E24AA;
  caption: "{displayName}";
}
relationship {
  color: #B0BEC5;
  shaft-width: 1px;
  font-size: 8px;
  caption: "<type>";
}
relationship.OF_TYPE {
  color: #43A047;
}
relationship.HAS_DATASET {
  color: #FFB300;
  shaft-width: 2px;
}
relationship.HOSTED_BY {
  color: #F4511E;
}
