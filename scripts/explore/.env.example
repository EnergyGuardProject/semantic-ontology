# Copy to .env and fill in. Never share or commit .env.
# The public read-only copy, reachable from anywhere (the password is shared by whoever gave you this folder):
NEO4J_URI=https://ontology.energy-guard.eu
NEO4J_USER=neo4j
NEO4J_PASSWORD=
# On the server itself, or through an SSH tunnel, you can use Bolt instead: NEO4J_URI=bolt://localhost:7687
